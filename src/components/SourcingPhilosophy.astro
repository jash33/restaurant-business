---
/**
 * Sourcing Philosophy Component
 *
 * Displays the restaurant's sourcing philosophy with principle cards,
 * icons, and optional statistics highlighting commitment to quality ingredients.
 *
 * Features:
 * - Responsive card grid layout
 * - Icon support with SVG strings
 * - Statistics highlights
 * - WCAG 2.1 AA accessible
 * - Reveal animations for scroll engagement
 *
 * @example Basic usage:
 * ```astro
 * <SourcingPhilosophy principles={sourcingPrinciples} />
 * ```
 */

import type { SourcingPhilosophyProps } from '../types/about';

interface Props extends SourcingPhilosophyProps {}

const {
  principles,
  heading = 'Our Sourcing Philosophy',
  subheading = 'We believe exceptional dishes start with exceptional ingredients.',
  intro = "At HTX Creamery, sourcing isn't just logistics — it's a core part of our culinary identity. We've built lasting relationships with local farmers, ranchers, and artisans who share our commitment to quality, sustainability, and ethical practices.",
  class: className = '',
} = Astro.props;

const sectionClasses = ['sourcing-philosophy', className].filter(Boolean).join(' ');
---

<section class={sectionClasses} aria-labelledby="sourcing-philosophy-heading">
  <div class="sourcing-philosophy__container">
    <header class="sourcing-philosophy__header reveal reveal--up">
      <span class="sourcing-philosophy__eyebrow">Farm to Table</span>
      <h2 id="sourcing-philosophy-heading" class="sourcing-philosophy__heading">{heading}</h2>
      {subheading && <p class="sourcing-philosophy__subheading">{subheading}</p>}
    </header>

    {intro && (
      <div class="sourcing-philosophy__intro reveal reveal--up reveal--delay-1">
        <p>{intro}</p>
      </div>
    )}

    <div class="sourcing-philosophy__grid">
      {principles.map((principle, index) => (
        <article
          class="principle-card reveal reveal--up"
          style={`--card-index: ${index}`}
        >
          <div class="principle-card__icon-wrapper">
            {principle.icon ? (
              <span class="principle-card__icon" set:html={principle.icon} />
            ) : (
              <span class="principle-card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
            )}
          </div>

          <div class="principle-card__content">
            <h3 class="principle-card__title">{principle.title}</h3>
            <p class="principle-card__description">{principle.description}</p>

            {principle.stats && (
              <div class="principle-card__stats">
                <span class="principle-card__stat-value">{principle.stats.value}</span>
                <span class="principle-card__stat-label">{principle.stats.label}</span>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Decorative Elements -->
  <div class="sourcing-philosophy__decor sourcing-philosophy__decor--left" aria-hidden="true"></div>
  <div class="sourcing-philosophy__decor sourcing-philosophy__decor--right" aria-hidden="true"></div>
</section>

<style>
  /* =================================================================
   * SOURCING PHILOSOPHY SECTION - BASE STYLES
   * ================================================================= */
  .sourcing-philosophy {
    position: relative;
    padding: var(--spacing-20) var(--spacing-4);
    background-color: var(--color-cream, var(--color-background-subtle));
    overflow: hidden;
  }

  .sourcing-philosophy__container {
    position: relative;
    z-index: 1;
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  /* =================================================================
   * HEADER STYLES
   * ================================================================= */
  .sourcing-philosophy__header {
    text-align: center;
    margin-bottom: var(--spacing-10);
  }

  .sourcing-philosophy__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--spacing-3);
  }

  .sourcing-philosophy__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4) 0;
    line-height: var(--line-height-tight);
  }

  .sourcing-philosophy__subheading {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * INTRO TEXT
   * ================================================================= */
  .sourcing-philosophy__intro {
    max-width: 80ch;
    margin: 0 auto var(--spacing-16);
    text-align: center;
  }

  .sourcing-philosophy__intro p {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  /* =================================================================
   * GRID LAYOUT
   * ================================================================= */
  .sourcing-philosophy__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  /* =================================================================
   * PRINCIPLE CARD STYLES
   * ================================================================= */
  .principle-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-background-elevated);
    border-radius: var(--radius-2xl);
    padding: var(--spacing-8);
    box-shadow: var(--shadow-md);
    transition: transform var(--duration-300) var(--ease-out),
                box-shadow var(--duration-300) var(--ease-out);
    animation: fadeInCard 0.5s ease-out calc(var(--card-index) * 0.1s) backwards;
  }

  .principle-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  /* Icon Wrapper */
  .principle-card__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-600) 100%);
    border-radius: var(--radius-xl);
    margin-bottom: var(--spacing-6);
    box-shadow: var(--shadow-sm);
  }

  .principle-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--color-text-inverse);
  }

  .principle-card__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Content */
  .principle-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .principle-card__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-3) 0;
    line-height: var(--line-height-tight);
  }

  .principle-card__description {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
    flex: 1;
  }

  /* Stats */
  .principle-card__stats {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-2);
    margin-top: var(--spacing-6);
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-border);
  }

  .principle-card__stat-value {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    line-height: 1;
  }

  .principle-card__stat-label {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  /* =================================================================
   * DECORATIVE ELEMENTS
   * ================================================================= */
  .sourcing-philosophy__decor {
    position: absolute;
    border-radius: 50%;
    opacity: 0.05;
    background-color: var(--color-primary);
    pointer-events: none;
  }

  .sourcing-philosophy__decor--left {
    top: 10%;
    left: -150px;
    width: 300px;
    height: 300px;
  }

  .sourcing-philosophy__decor--right {
    bottom: 10%;
    right: -100px;
    width: 250px;
    height: 250px;
  }

  /* =================================================================
   * ANIMATIONS
   * ================================================================= */
  @keyframes fadeInCard {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */
  @media (min-width: 640px) {
    .sourcing-philosophy__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .sourcing-philosophy {
      padding: var(--spacing-24) var(--spacing-6);
    }

    .sourcing-philosophy__heading {
      font-size: var(--font-size-4xl);
    }

    .sourcing-philosophy__intro p {
      font-size: var(--font-size-lg);
    }

    .principle-card {
      padding: var(--spacing-10);
    }
  }

  @media (min-width: 1024px) {
    .sourcing-philosophy__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-8);
    }

    .principle-card__icon-wrapper {
      width: 64px;
      height: 64px;
    }

    .principle-card__icon {
      width: 32px;
      height: 32px;
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .principle-card {
      animation: none;
    }

    .principle-card:hover {
      transform: none;
    }
  }

  /* =================================================================
   * DARK MODE SUPPORT
   * ================================================================= */
  [data-theme="dark"] .sourcing-philosophy {
    background-color: var(--color-background-subtle);
  }

  [data-theme="dark"] .principle-card {
    background-color: var(--color-background-elevated);
  }

  [data-theme="dark"] .principle-card__stats {
    border-color: var(--color-border-dark);
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */
  @media print {
    .sourcing-philosophy {
      background: none;
      padding: var(--spacing-8) 0;
    }

    .sourcing-philosophy__decor {
      display: none;
    }

    .principle-card {
      break-inside: avoid;
      box-shadow: none;
      border: 1px solid var(--color-border);
    }

    .principle-card__icon-wrapper {
      background: var(--color-primary);
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>

---
/**
 * TestimonialCard Component
 * Displays an individual customer testimonial/review with star rating,
 * quote, author attribution, and source platform badge.
 *
 * Features:
 * - Star rating display (1-5 stars)
 * - Quote with proper blockquote semantics
 * - Author name, title, and optional avatar
 * - Source platform badge (Google, Yelp, Facebook, etc.)
 * - Date display option
 * - Featured testimonial highlight
 * - Responsive design
 * - Dark mode support
 * - Accessibility compliant
 * - Reduced motion support
 *
 * @example Basic usage
 * ```astro
 * <TestimonialCard
 *   id="review-1"
 *   authorName="John D."
 *   quote="Amazing food and service!"
 *   rating={5}
 *   source="Google"
 * />
 * ```
 *
 * @example With all options
 * ```astro
 * <TestimonialCard
 *   id="review-2"
 *   authorName="Sarah M."
 *   authorTitle="Regular Customer"
 *   quote="Best restaurant in town!"
 *   rating={5}
 *   source="Yelp"
 *   datePublished="2024-12-15"
 *   featured={true}
 *   showSource={true}
 *   showDate={true}
 * />
 * ```
 */

import type { TestimonialCardProps, TestimonialSource } from '../types/testimonial';
import { SOURCE_LABELS } from '../config/testimonials.config';

interface Props extends TestimonialCardProps {}

const {
  id,
  authorName,
  authorTitle,
  authorAvatar,
  quote,
  rating,
  source,
  sourceUrl,
  datePublished,
  featured = false,
  showSource = true,
  showDate = false,
  class: className = '',
  testId = 'testimonial-card',
} = Astro.props;

// Build CSS classes
const cardClasses = [
  'testimonial-card',
  featured && 'testimonial-card--featured',
  className,
].filter(Boolean).join(' ');

// Get source label and color
const sourceInfo = SOURCE_LABELS[source] || SOURCE_LABELS.Other;

// Format date if provided
function formatDate(dateStr: string | undefined): string {
  if (!dateStr) return '';
  try {
    const date = new Date(dateStr);
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
  } catch {
    return '';
  }
}

const formattedDate = formatDate(datePublished);

// Generate stars array
const stars = Array.from({ length: 5 }, (_, i) => i < rating);

// Source icon SVG paths
const sourceIconPaths: Record<string, string> = {
  Google: 'M12.545,10.239v3.821h5.445c-0.712,2.315-2.647,3.972-5.445,3.972c-3.332,0-6.033-2.701-6.033-6.032s2.701-6.032,6.033-6.032c1.498,0,2.866,0.549,3.921,1.453l2.814-2.814C17.503,2.988,15.139,2,12.545,2C7.021,2,2.543,6.477,2.543,12s4.478,10,10.002,10c8.396,0,10.249-7.85,9.426-11.748L12.545,10.239z',
  Yelp: 'M20.16 12.594l-4.995 1.433c-.96.276-1.74-.8-1.176-1.63l2.905-4.308a1.072 1.072 0 0 1 1.596-.206 9.194 9.194 0 0 1 2.364 3.252 1.073 1.073 0 0 1-.694 1.459zm-3.976 5.322l-4.753-2.217c-.903-.42-.744-1.738.24-1.988l5.086-1.299a1.074 1.074 0 0 1 1.299.762 9.228 9.228 0 0 1-.21 4.039 1.073 1.073 0 0 1-1.662.703zm-6.93-2.02l1.713-4.886c.324-.926 1.603-.926 1.927 0l1.714 4.886a1.073 1.073 0 0 1-.63 1.36 9.23 9.23 0 0 1-4.095 0 1.072 1.072 0 0 1-.63-1.36zm-3.3-5.597l4.753-2.217c.904-.42 1.82.54 1.384 1.45l-2.244 4.695a1.074 1.074 0 0 1-1.616.392 9.194 9.194 0 0 1-2.76-2.928 1.073 1.073 0 0 1 .483-1.392zm3.976-5.322l4.995 1.433c.96.276 1.177 1.512.328 1.868l-4.38 1.838a1.073 1.073 0 0 1-1.43-.556 9.228 9.228 0 0 1 .21-4.039 1.073 1.073 0 0 1 .277-.544z',
  Facebook: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  TripAdvisor: 'M12.006 4.295c-2.67 0-5.338.784-7.645 2.353H0l1.963 2.135a5.997 5.997 0 0 0 4.04 10.432 5.976 5.976 0 0 0 4.075-1.6L12 19.5l1.922-1.885a5.976 5.976 0 0 0 4.075 1.6 5.997 5.997 0 0 0 4.04-10.432L24 6.648h-4.35a13.573 13.573 0 0 0-7.644-2.353zM6.003 17.93a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9zm11.994 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z',
  default: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z',
};

// Get the appropriate icon path for the source
const sourceIconPath = sourceIconPaths[source] || sourceIconPaths.default;
---

<article
  class={cardClasses}
  data-testimonial-id={id}
  data-testid={testId}
  aria-label={`Review by ${authorName}`}
>
  {/* Star Rating */}
  <div class="testimonial-card__rating" aria-label={`${rating} out of 5 stars`}>
    {stars.map((filled, index) => (
      <svg
        class:list={['testimonial-card__star', filled && 'testimonial-card__star--filled']}
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill={filled ? 'currentColor' : 'none'}
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"
        />
      </svg>
    ))}
  </div>

  {/* Quote */}
  <blockquote class="testimonial-card__quote">
    <p class="testimonial-card__quote-text">"{quote}"</p>
  </blockquote>

  {/* Author Info */}
  <footer class="testimonial-card__footer">
    <div class="testimonial-card__author">
      {authorAvatar ? (
        <img
          class="testimonial-card__avatar"
          src={authorAvatar}
          alt=""
          width="48"
          height="48"
          loading="lazy"
        />
      ) : (
        <div class="testimonial-card__avatar-placeholder" aria-hidden="true">
          {authorName.charAt(0).toUpperCase()}
        </div>
      )}
      <div class="testimonial-card__author-info">
        <cite class="testimonial-card__author-name">{authorName}</cite>
        {authorTitle && (
          <span class="testimonial-card__author-title">{authorTitle}</span>
        )}
      </div>
    </div>

    {/* Source Badge & Date */}
    <div class="testimonial-card__meta">
      {showSource && (
        sourceUrl ? (
          <a
            href={sourceUrl}
            class="testimonial-card__source"
            style={`--source-color: ${sourceInfo.color};`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View review on ${sourceInfo.label}`}
          >
            <svg class="testimonial-card__source-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={sourceIconPath} />
            </svg>
            <span class="testimonial-card__source-label">{sourceInfo.label}</span>
          </a>
        ) : (
          <span
            class="testimonial-card__source"
            style={`--source-color: ${sourceInfo.color};`}
          >
            <svg class="testimonial-card__source-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={sourceIconPath} />
            </svg>
            <span class="testimonial-card__source-label">{sourceInfo.label}</span>
          </span>
        )
      )}
      {showDate && formattedDate && (
        <time class="testimonial-card__date" datetime={datePublished}>
          {formattedDate}
        </time>
      )}
    </div>
  </footer>

  {/* Featured badge */}
  {featured && (
    <div class="testimonial-card__featured-badge" aria-label="Featured review">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <span>Featured</span>
    </div>
  )}
</article>

<style>
  /* =================================================================
   * TESTIMONIAL CARD COMPONENT STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention for maintainability
   */

  .testimonial-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    padding: var(--spacing-6);
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-200) var(--ease-out),
                box-shadow var(--duration-200) var(--ease-out);
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  /* Featured Variant */
  .testimonial-card--featured {
    border-color: var(--color-primary-200);
    background: linear-gradient(
      135deg,
      var(--color-background-elevated) 0%,
      var(--color-primary-50) 100%
    );
  }

  /* Star Rating */
  .testimonial-card__rating {
    display: flex;
    gap: var(--spacing-0-5);
  }

  .testimonial-card__star {
    width: 20px;
    height: 20px;
    color: var(--color-border-dark);
    transition: color var(--duration-150) var(--ease-out);
  }

  .testimonial-card__star--filled {
    color: #FBBF24; /* Gold/Yellow for stars */
  }

  /* Quote */
  .testimonial-card__quote {
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .testimonial-card__quote-text {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-style: italic;
    line-height: var(--line-height-relaxed);
    color: var(--color-text-primary);
    margin: 0;
  }

  /* Footer (Author + Meta) */
  .testimonial-card__footer {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    margin-top: auto;
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-border-light);
  }

  /* Author Section */
  .testimonial-card__author {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
  }

  .testimonial-card__avatar,
  .testimonial-card__avatar-placeholder {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex-shrink: 0;
  }

  .testimonial-card__avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gradient-primary);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
  }

  .testimonial-card__author-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-0-5);
  }

  .testimonial-card__author-name {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    font-style: normal;
    color: var(--color-text-primary);
  }

  .testimonial-card__author-title {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  /* Meta Section (Source + Date) */
  .testimonial-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-3);
  }

  .testimonial-card__source {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1-5);
    padding: var(--spacing-1) var(--spacing-2);
    background-color: var(--color-background-subtle);
    border-radius: var(--radius-md);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--source-color, var(--color-text-secondary));
    text-decoration: none;
    transition: background-color var(--duration-150) var(--ease-out),
                transform var(--duration-150) var(--ease-out);
  }

  a.testimonial-card__source:hover {
    background-color: var(--color-background-muted);
    transform: scale(1.02);
  }

  .testimonial-card__source-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .testimonial-card__source-label {
    white-space: nowrap;
  }

  .testimonial-card__date {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
  }

  /* Featured Badge */
  .testimonial-card__featured-badge {
    position: absolute;
    top: var(--spacing-3);
    right: var(--spacing-3);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    padding: var(--spacing-1) var(--spacing-2);
    background: var(--gradient-primary);
    color: var(--color-text-inverse);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    box-shadow: var(--shadow-sm);
  }

  .testimonial-card__featured-badge svg {
    width: 14px;
    height: 14px;
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * =================================================================
   */

  @media screen and (min-width: 640px) {
    .testimonial-card {
      padding: var(--spacing-8);
    }

    .testimonial-card__footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .testimonial-card__quote-text {
      font-size: var(--font-size-md);
    }
  }

  /* =================================================================
   * DARK MODE SUPPORT
   * =================================================================
   */

  html[data-theme="dark"] .testimonial-card {
    background-color: var(--color-background-elevated);
    border-color: var(--color-border);
  }

  html[data-theme="dark"] .testimonial-card--featured {
    background: linear-gradient(
      135deg,
      var(--color-background-elevated) 0%,
      rgba(54, 83, 149, 0.15) 100%
    );
    border-color: var(--color-primary-700);
  }

  html[data-theme="dark"] .testimonial-card__star {
    color: var(--color-border);
  }

  html[data-theme="dark"] .testimonial-card__avatar-placeholder {
    background: var(--gradient-primary);
  }

  html[data-theme="dark"] .testimonial-card__source {
    background-color: var(--color-background-muted);
  }

  html[data-theme="dark"] a.testimonial-card__source:hover {
    background-color: var(--color-background-subtle);
  }

  /* =================================================================
   * REDUCED MOTION
   * =================================================================
   */

  @media (prefers-reduced-motion: reduce) {
    .testimonial-card {
      transition: none;
    }

    .testimonial-card:hover {
      transform: none;
    }

    .testimonial-card__star,
    .testimonial-card__source {
      transition: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * =================================================================
   */

  @media print {
    .testimonial-card {
      box-shadow: none;
      border: 1px solid #ccc;
      page-break-inside: avoid;
    }

    .testimonial-card:hover {
      transform: none;
      box-shadow: none;
    }

    .testimonial-card__featured-badge {
      background: #333;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>

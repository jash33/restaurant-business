---
/**
 * Parking & Transit Info Section Component
 * A comprehensive section displaying parking instructions, public transit directions,
 * bike parking, accessibility information, and first-time visitor tips.
 *
 * Features:
 * - WCAG 2.1 AA compliant accessibility
 * - Responsive design for mobile, tablet, and desktop
 * - Tabbed interface for organized content
 * - Expandable/collapsible subsections
 * - Dark mode support
 * - Reduced motion support
 * - Print-friendly styles
 *
 * @example Basic usage
 * ```astro
 * <ParkingTransitInfoSection />
 * ```
 *
 * @example With custom configuration
 * ```astro
 * <ParkingTransitInfoSection
 *   heading="Getting Here"
 *   subheading="Everything you need to know"
 *   showBikeParking={false}
 * />
 * ```
 */

import type { ParkingTransitInfoSectionProps } from '../types/parking-transit-info';
import {
  PARKING_TRANSIT_INFO_CONFIG,
  PARKING_TRANSIT_DISPLAY_CONFIG,
} from '../config/parking-transit-info.config';

interface Props extends ParkingTransitInfoSectionProps {}

const {
  config = PARKING_TRANSIT_INFO_CONFIG,
  heading = PARKING_TRANSIT_DISPLAY_CONFIG.defaultHeading,
  subheading = PARKING_TRANSIT_DISPLAY_CONFIG.defaultSubheading,
  showParking = PARKING_TRANSIT_DISPLAY_CONFIG.showParking,
  showTransit = PARKING_TRANSIT_DISPLAY_CONFIG.showTransit,
  showBikeParking = PARKING_TRANSIT_DISPLAY_CONFIG.showBikeParking,
  showAccessibility = PARKING_TRANSIT_DISPLAY_CONFIG.showAccessibility,
  showVisitorTips = PARKING_TRANSIT_DISPLAY_CONFIG.showVisitorTips,
  showRideshare = PARKING_TRANSIT_DISPLAY_CONFIG.showRideshare,
  id = 'parking-transit-info',
  class: className = '',
} = Astro.props;

const {
  parkingTips,
  transitTips,
  bikeParking,
  accessibilityFeatures,
  firstTimeVisitorTips,
  rideshare,
} = config;

// Build CSS classes
const sectionClasses = ['parking-transit-section', className].filter(Boolean).join(' ');

// Sort visitor tips by priority
const sortedVisitorTips = [...firstTimeVisitorTips].sort((a, b) => (a.priority || 99) - (b.priority || 99));

// Parking type icons
const parkingIcons: Record<string, string> = {
  street: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>`,
  lot: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>`,
  garage: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M4 21V10a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v11"/><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/><path d="M10 4l2-2 2 2"/><path d="M12 2v6"/></svg>`,
  valet: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/><path d="M12 13v8"/><path d="M9 18l3-2 3 2"/></svg>`,
};

// Transit type icons
const transitIcons: Record<string, string> = {
  bus: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6v6"/><path d="M16 6v6"/><path d="M2 12h20"/><path d="M18 18H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>`,
  metro: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><path d="m8 19h8"/></svg>`,
  train: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><path d="m8 19h8"/></svg>`,
  'light-rail': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><path d="m8 19h8"/></svg>`,
  ferry: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1 .6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M19.38 20A11.6 11.6 0 0 0 21 14l-9-4-9 4c0 2.9.94 5.34 2.81 7.76"/><path d="M19 13V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6"/><path d="M12 10v4"/><path d="M12 2v3"/></svg>`,
  rideshare: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>`,
  other: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`,
};

// Accessibility icons
const accessibilityIcons: Record<string, string> = {
  wheelchair: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="4" r="1"/><path d="m18 19 1-7-6 1"/><path d="m5 8 3-3 5.5 3-2.36 3.5"/><path d="M4.24 14.5a5 5 0 1 0 6.88 6"/><path d="M13.76 17.5a5 5 0 0 0-6.88-6"/></svg>`,
  parking: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>`,
  entrance: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>`,
  restroom: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  seating: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"/><path d="M3 16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H7v-2a2 2 0 0 0-4 0v5Z"/><path d="M5 18v3"/><path d="M19 18v3"/></svg>`,
  assistance: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>`,
  hearing: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8.5a6.5 6.5 0 1 1 13 0c0 6-6 6-6 10a3.5 3.5 0 1 1-7 0"/><path d="M15 8.5a2.5 2.5 0 0 0-5 0v1a2 2 0 1 1 0 4"/></svg>`,
  visual: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>`,
};

// Visitor tip category icons
const tipCategoryIcons: Record<string, string> = {
  arrival: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  parking: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>`,
  entrance: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>`,
  seating: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"/><path d="M3 16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H7v-2a2 2 0 0 0-4 0v5Z"/></svg>`,
  ordering: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  general: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`,
};
---

<section
  class={sectionClasses}
  id={id}
  aria-labelledby={`${id}-heading`}
  data-parking-transit-section
>
  <div class="parking-transit-container">
    <!-- Section Header -->
    <header class="parking-transit-header section-heading--decorated">
      <h2 id={`${id}-heading`} class="parking-transit-title">{heading}</h2>
      {subheading && <p class="parking-transit-description">{subheading}</p>}
    </header>

    <!-- Tab Navigation -->
    <nav class="parking-transit-tabs" role="tablist" aria-label="Parking and transit information">
      {showParking && parkingTips.length > 0 && (
        <button
          class="parking-transit-tab is-active"
          role="tab"
          aria-selected="true"
          aria-controls={`${id}-parking-panel`}
          id={`${id}-parking-tab`}
          data-tab="parking"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="parking-transit-tab__icon" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M9 17V7h4a3 3 0 0 1 0 6H9"/>
          </svg>
          <span>Parking</span>
        </button>
      )}
      {showTransit && transitTips.length > 0 && (
        <button
          class="parking-transit-tab"
          role="tab"
          aria-selected="false"
          aria-controls={`${id}-transit-panel`}
          id={`${id}-transit-tab`}
          data-tab="transit"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="parking-transit-tab__icon" aria-hidden="true">
            <rect x="4" y="3" width="16" height="16" rx="2"/>
            <path d="M4 11h16"/>
            <path d="M12 3v8"/>
            <path d="m8 19-2 3"/>
            <path d="m18 22-2-3"/>
            <path d="m8 19h8"/>
          </svg>
          <span>Transit</span>
        </button>
      )}
      {showBikeParking && bikeParking.available && (
        <button
          class="parking-transit-tab"
          role="tab"
          aria-selected="false"
          aria-controls={`${id}-bike-panel`}
          id={`${id}-bike-tab`}
          data-tab="bike"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="parking-transit-tab__icon" aria-hidden="true">
            <circle cx="18.5" cy="17.5" r="3.5"/>
            <circle cx="5.5" cy="17.5" r="3.5"/>
            <circle cx="15" cy="5" r="1"/>
            <path d="M12 17.5V14l-3-3 4-3 2 3h2"/>
          </svg>
          <span>Bike</span>
        </button>
      )}
      {showAccessibility && accessibilityFeatures.length > 0 && (
        <button
          class="parking-transit-tab"
          role="tab"
          aria-selected="false"
          aria-controls={`${id}-accessibility-panel`}
          id={`${id}-accessibility-tab`}
          data-tab="accessibility"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="parking-transit-tab__icon" aria-hidden="true">
            <circle cx="16" cy="4" r="1"/>
            <path d="m18 19 1-7-6 1"/>
            <path d="m5 8 3-3 5.5 3-2.36 3.5"/>
            <path d="M4.24 14.5a5 5 0 1 0 6.88 6"/>
            <path d="M13.76 17.5a5 5 0 0 0-6.88-6"/>
          </svg>
          <span>Accessibility</span>
        </button>
      )}
      {showVisitorTips && sortedVisitorTips.length > 0 && (
        <button
          class="parking-transit-tab"
          role="tab"
          aria-selected="false"
          aria-controls={`${id}-tips-panel`}
          id={`${id}-tips-tab`}
          data-tab="tips"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="parking-transit-tab__icon" aria-hidden="true">
            <path d="M9 18V5l12-2v13"/>
            <circle cx="6" cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
          </svg>
          <span>First Visit</span>
        </button>
      )}
    </nav>

    <!-- Tab Panels -->
    <div class="parking-transit-panels">
      <!-- Parking Panel -->
      {showParking && parkingTips.length > 0 && (
        <div
          class="parking-transit-panel is-active"
          role="tabpanel"
          id={`${id}-parking-panel`}
          aria-labelledby={`${id}-parking-tab`}
          data-panel="parking"
        >
          <div class="parking-transit-panel__grid">
            {parkingTips.map((tip) => (
              <article class="parking-card" data-parking-type={tip.type}>
                <div class="parking-card__header">
                  <div class="parking-card__icon" aria-hidden="true" set:html={parkingIcons[tip.type] || parkingIcons['lot']} />
                  <div class="parking-card__title-group">
                    <h3 class="parking-card__title">{tip.title}</h3>
                    <div class="parking-card__badges">
                      {tip.isFree && (
                        <span class="parking-card__badge parking-card__badge--free">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"/>
                          </svg>
                          Free
                        </span>
                      )}
                      {!tip.isFree && tip.pricing && (
                        <span class="parking-card__badge parking-card__badge--paid">
                          {tip.pricing}
                        </span>
                      )}
                    </div>
                  </div>
                </div>
                <p class="parking-card__description">{tip.description}</p>
                {tip.tips && tip.tips.length > 0 && (
                  <ul class="parking-card__tips" role="list">
                    {tip.tips.map((tipItem) => (
                      <li class="parking-card__tip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="parking-card__tip-icon" aria-hidden="true">
                          <polyline points="9 11 12 14 22 4"/>
                          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                        </svg>
                        {tipItem}
                      </li>
                    ))}
                  </ul>
                )}
                <div class="parking-card__meta">
                  {tip.hours && (
                    <div class="parking-card__meta-item">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                      </svg>
                      <span>{tip.hours}</span>
                    </div>
                  )}
                  {tip.location && (
                    <div class="parking-card__meta-item">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                        <circle cx="12" cy="10" r="3"/>
                      </svg>
                      <span>{tip.location}</span>
                    </div>
                  )}
                </div>
                {tip.notes && (
                  <p class="parking-card__notes">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/>
                      <line x1="12" y1="16" x2="12" y2="12"/>
                      <line x1="12" y1="8" x2="12.01" y2="8"/>
                    </svg>
                    {tip.notes}
                  </p>
                )}
              </article>
            ))}
          </div>
        </div>
      )}

      <!-- Transit Panel -->
      {showTransit && transitTips.length > 0 && (
        <div
          class="parking-transit-panel"
          role="tabpanel"
          id={`${id}-transit-panel`}
          aria-labelledby={`${id}-transit-tab`}
          data-panel="transit"
          hidden
        >
          <div class="parking-transit-panel__grid">
            {transitTips.map((tip) => (
              <article class="transit-card" data-transit-type={tip.type}>
                <div class="transit-card__header">
                  <div class="transit-card__icon" aria-hidden="true" set:html={transitIcons[tip.type] || transitIcons['other']} />
                  <div class="transit-card__title-group">
                    <h3 class="transit-card__title">{tip.routeName}</h3>
                    <span class="transit-card__stop">{tip.nearestStop}</span>
                  </div>
                </div>
                {tip.walkingDistance && (
                  <div class="transit-card__walking">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="5" r="1"/>
                      <path d="m9 20 3-6 3 6"/>
                      <path d="m6 8 6 2 6-2"/>
                      <path d="M12 10v4"/>
                    </svg>
                    <span>{tip.walkingDistance}</span>
                  </div>
                )}
                {tip.directions && tip.directions.length > 0 && (
                  <ol class="transit-card__directions" role="list">
                    {tip.directions.map((step, index) => (
                      <li class="transit-card__direction">
                        <span class="transit-card__step-number">{index + 1}</span>
                        {step}
                      </li>
                    ))}
                  </ol>
                )}
                <div class="transit-card__footer">
                  {tip.frequency && (
                    <span class="transit-card__frequency">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                      </svg>
                      {tip.frequency}
                    </span>
                  )}
                  {tip.notes && (
                    <p class="transit-card__notes">{tip.notes}</p>
                  )}
                </div>
              </article>
            ))}
          </div>

          <!-- Rideshare Section -->
          {showRideshare && rideshare.available && (
            <div class="rideshare-section">
              <h3 class="rideshare-section__title">
                <span class="rideshare-section__icon" aria-hidden="true" set:html={transitIcons['rideshare']} />
                Rideshare (Uber/Lyft)
              </h3>
              <p class="rideshare-section__description">{rideshare.description}</p>
              {rideshare.dropOffLocation && (
                <p class="rideshare-section__location">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  {rideshare.dropOffLocation}
                </p>
              )}
              {rideshare.tips && rideshare.tips.length > 0 && (
                <ul class="rideshare-section__tips" role="list">
                  {rideshare.tips.map((tip) => (
                    <li class="rideshare-section__tip">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      {tip}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}
        </div>
      )}

      <!-- Bike Parking Panel -->
      {showBikeParking && bikeParking.available && (
        <div
          class="parking-transit-panel"
          role="tabpanel"
          id={`${id}-bike-panel`}
          aria-labelledby={`${id}-bike-tab`}

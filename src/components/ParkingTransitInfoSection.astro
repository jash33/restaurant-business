<script>
  /**
   * Parking & Transit Info Section Client-Side Logic
   * Handles tab switching and accessibility
   */

  class ParkingTransitSection {
    private container: HTMLElement;
    private tabs: NodeListOf<HTMLButtonElement>;
    private panels: NodeListOf<HTMLElement>;
    private announcer: HTMLElement | null;

    constructor(container: HTMLElement) {
      this.container = container;
      this.tabs = container.querySelectorAll('[role="tab"]');
      this.panels = container.querySelectorAll('[role="tabpanel"]');
      this.announcer = container.querySelector('[data-parking-transit-announcer]');

      this.initialize();
    }

    private initialize(): void {
      this.setupTabs();
      this.setupKeyboardNavigation();
    }

    private setupTabs(): void {
      this.tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          this.activateTab(tab);
        });
      });
    }

    private setupKeyboardNavigation(): void {
      this.tabs.forEach((tab, index) => {
        tab.addEventListener('keydown', (e: KeyboardEvent) => {
          const key = e.key;
          let newIndex = index;

          if (key === 'ArrowRight' || key === 'ArrowDown') {
            e.preventDefault();
            newIndex = (index + 1) % this.tabs.length;
          } else if (key === 'ArrowLeft' || key === 'ArrowUp') {
            e.preventDefault();
            newIndex = (index - 1 + this.tabs.length) % this.tabs.length;
          } else if (key === 'Home') {
            e.preventDefault();
            newIndex = 0;
          } else if (key === 'End') {
            e.preventDefault();
            newIndex = this.tabs.length - 1;
          }

          if (newIndex !== index) {
            this.tabs[newIndex].focus();
            this.activateTab(this.tabs[newIndex]);
          }
        });
      });
    }

    private activateTab(tab: HTMLButtonElement): void {
      const tabId = tab.dataset.tab;
      if (!tabId) return;

      // Deactivate all tabs
      this.tabs.forEach((t) => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
        t.setAttribute('tabindex', '-1');
      });

      // Activate clicked tab
      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');
      tab.setAttribute('tabindex', '0');

      // Hide all panels
      this.panels.forEach((panel) => {
        panel.classList.remove('is-active');
        panel.hidden = true;
      });

      // Show corresponding panel
      const panel = this.container.querySelector(`[data-panel="${tabId}"]`) as HTMLElement;
      if (panel) {
        panel.classList.add('is-active');
        panel.hidden = false;
        this.announce(`${tab.textContent?.trim()} tab selected`);
      }
    }

    private announce(message: string): void {
      if (!this.announcer) return;
      this.announcer.textContent = message;

      // Clear after announcement
      setTimeout(() => {
        if (this.announcer) {
          this.announcer.textContent = '';
        }
      }, 1000);
    }
  }

  // Initialize all parking transit sections on the page
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll<HTMLElement>('[data-parking-transit-section]');
    sections.forEach((section) => new ParkingTransitSection(section));
  });

  // Also initialize on Astro page transitions
  document.addEventListener('astro:page-load', () => {
    const sections = document.querySelectorAll<HTMLElement>('[data-parking-transit-section]');
    sections.forEach((section) => new ParkingTransitSection(section));
  });
</script>

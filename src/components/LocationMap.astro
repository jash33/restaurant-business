---
/**
 * Location Map Component
 * Displays an embedded Google Map with the restaurant location and directions.
 *
 * Features:
 * - Embedded Google Maps iframe
 * - Fallback static map image for no-JS
 * - Get directions links (Google Maps, Apple Maps)
 * - Address display
 * - WCAG 2.1 AA compliant accessibility
 * - Responsive design
 * - Lazy loading for performance
 *
 * @example
 * ```astro
 * <LocationMap />
 * ```
 */

import { LOCATION_CONFIG, COORDINATES, BUSINESS_ADDRESS } from '../config/location.config';
import Button from './Button.astro';

interface Props {
  /** Custom heading */
  heading?: string;
  /** Custom subheading */
  subheading?: string;
  /** Map height in pixels */
  mapHeight?: number;
  /** Show directions buttons */
  showDirections?: boolean;
  /** Show address overlay */
  showAddressOverlay?: boolean;
  /** Google Maps API Key (for embed) */
  apiKey?: string;
  /** Custom ID for the section */
  id?: string;
  /** Custom class name */
  class?: string;
}

const {
  heading = 'Find Us',
  subheading = "We're located in the heart of Downtown Houston",
  mapHeight = 400,
  showDirections = true,
  showAddressOverlay = true,
  apiKey = '', // Empty means using the free embed
  id = 'location-map',
  class: className = '',
} = Astro.props;

const { latitude, longitude } = COORDINATES;
const { street, street2, city, state, zipCode } = BUSINESS_ADDRESS;
const { businessName, phone, directionsCTA } = LOCATION_CONFIG;

const sectionClasses = ['location-map-section', className].filter(Boolean).join(' ');

// Format address for display and URL encoding
const fullAddress = [street, street2, `${city}, ${state} ${zipCode}`].filter(Boolean).join(', ');
const encodedAddress = encodeURIComponent(fullAddress);

// Google Maps embed URL (free embed without API key)
const mapEmbedUrl = `https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3464.0!2d${longitude}!3d${latitude}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjnCsDQ1JzM3LjQiTiA5NcKwMjInMTEuMyJX!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus`;

// Alternative: Search-based embed (more reliable)
const mapSearchUrl = `https://www.google.com/maps/embed/v1/place?key=${apiKey || 'AIzaSyBFw0Qbyq9zTFTd-tUY6dZWTgaQzuU17R8'}&q=${encodedAddress}`;

// Use search-based embed for reliability (or simple embed if no API key)
const embedUrl = apiKey ? mapSearchUrl : `https://www.google.com/maps?q=${latitude},${longitude}&z=15&output=embed`;

// Direction URLs
const googleMapsDirections = `https://www.google.com/maps/dir/?api=1&destination=${latitude},${longitude}`;
const appleMapsDirections = `https://maps.apple.com/?daddr=${latitude},${longitude}&dirflg=d`;
---

<section class={sectionClasses} id={id} aria-labelledby={`${id}-heading`}>
  <div class="location-map-container">
    <header class="location-map-header">
      <h2 id={`${id}-heading`} class="location-map-title">{heading}</h2>
      {subheading && <p class="location-map-description">{subheading}</p>}
    </header>

    <div class="location-map-content">
      <!-- Map Container -->
      <div class="map-wrapper" style={`height: ${mapHeight}px;`}>
        <iframe
          class="map-iframe"
          src={embedUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Map showing location of ${businessName} at ${fullAddress}`}
          aria-label={`Interactive map showing ${businessName} location`}
        ></iframe>

        <!-- Fallback for no JS or blocked iframes -->
        <noscript>
          <div class="map-fallback">
            <img
              src={`https://maps.googleapis.com/maps/api/staticmap?center=${latitude},${longitude}&zoom=15&size=600x400&markers=color:red%7C${latitude},${longitude}`}
              alt={`Static map showing ${businessName} at ${fullAddress}`}
              loading="lazy"
              class="map-fallback__image"
            />
          </div>
        </noscript>

        <!-- Address Overlay -->
        {showAddressOverlay && (
          <div class="address-overlay">
            <div class="address-overlay__card">
              <h3 class="address-overlay__name">{businessName}</h3>
              <address class="address-overlay__address">
                {street}<br />
                {street2 && <>{street2}<br /></>}
                {city}, {state} {zipCode}
              </address>
              {phone && (
                <a href={`tel:${phone.replace(/[^0-9+]/g, '')}`} class="address-overlay__phone">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  {phone}
                </a>
              )}
            </div>
          </div>
        )}
      </div>

      <!-- Directions Buttons -->
      {showDirections && (
        <div class="directions-buttons">
          <a
            href={googleMapsDirections}
            target="_blank"
            rel="noopener noreferrer"
            class="directions-btn directions-btn--google"
            aria-label="Get directions using Google Maps (opens in new tab)"
          >
            <svg class="directions-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span class="directions-btn__text">Google Maps</span>
            <svg class="directions-btn__external" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
          <a
            href={appleMapsDirections}
            target="_blank"
            rel="noopener noreferrer"
            class="directions-btn directions-btn--apple"
            aria-label="Get directions using Apple Maps (opens in new tab)"
          >
            <svg class="directions-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            <span class="directions-btn__text">Apple Maps</span>
            <svg class="directions-btn__external" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* =================================================================
   * SECTION CONTAINER
   * ================================================================= */
  .location-map-section {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background);
  }

  .location-map-container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  .location-map-header {
    text-align: center;
    margin-bottom: var(--spacing-8);
  }

  .location-map-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-3);
  }

  .location-map-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 36rem;
    margin: 0 auto;
  }

  /* =================================================================
   * MAP WRAPPER
   * ================================================================= */
  .map-wrapper {
    position: relative;
    width: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background-color: var(--color-background-muted);
  }

  .map-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .map-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-fallback__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* =================================================================
   * ADDRESS OVERLAY
   * ================================================================= */
  .address-overlay {
    position: absolute;
    bottom: var(--spacing-4);
    left: var(--spacing-4);
    z-index: 10;
    pointer-events: none;
  }

  .address-overlay__card {
    background-color: var(--color-background-elevated);
    padding: var(--spacing-4) var(--spacing-5);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    pointer-events: auto;
    max-width: 16rem;
  }

  .address-overlay__name {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-2);
  }

  .address-overlay__address {
    font-size: var(--font-size-sm);
    font-style: normal;
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-3);
  }

  .address-overlay__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--duration-150) var(--ease-in-out);
  }

  .address-overlay__phone:hover {
    color: var(--color-primary-hover);
  }

  .address-overlay__phone svg {
    width: 1rem;
    height: 1rem;
  }

  /* =================================================================
   * DIRECTIONS BUTTONS
   * ================================================================= */
  .directions-buttons {
    display: flex;
    justify-content: center;
    gap: var(--spacing-4);
    margin-top: var(--spacing-6);
    flex-wrap: wrap;
  }

  .directions-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-3) var(--spacing-5);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--duration-200) var(--ease-in-out);
  }

  .directions-btn:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-primary);
    outline-offset: var(--focus-ring-offset);
  }

  .directions-btn__icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .directions-btn__external {
    width: 0.875rem;
    height: 0.875rem;
    opacity: 0.6;
    margin-left: var(--spacing-1);
  }

  .directions-btn--google {
    background-color: #4285f4;
    color: white;
  }

  .directions-btn--google:hover {
    background-color: #3367d6;
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .directions-btn--apple {
    background-color: var(--color-charcoal);
    color: white;
  }

  .directions-btn--apple:hover {
    background-color: #1a202c;
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* =================================================================
   * RESPONSIVE ADJUSTMENTS
   * ================================================================= */
  @media (max-width: 767px) {
    .location-map-section {
      padding: var(--spacing-12) var(--spacing-4);
    }

    .map-wrapper {
      border-radius: var(--radius-lg);
    }

    .address-overlay {
      bottom: var(--spacing-3);
      left: var(--spacing-3);
      right: var(--spacing-3);
    }

    .address-overlay__card {
      max-width: none;
      padding: var(--spacing-3) var(--spacing-4);
    }

    .directions-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .directions-btn {
      justify-content: center;
    }
  }

  /* =================================================================
   * DARK MODE
   * ================================================================= */
  :global(html[data-theme="dark"]) .location-map-section {
    background-color: var(--color-background);
  }

  :global(html[data-theme="dark"]) .address-overlay__card {
    background-color: var(--color-background-elevated);
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .directions-btn:hover {
      transform: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */
  @media print {
    .location-map-section {
      padding: var(--spacing-8) 0;
    }

    .map-wrapper {
      display: none;
    }

    .directions-buttons {
      display: none;
    }

    .address-overlay {
      position: static;
      margin-top: var(--spacing-4);
    }

    .address-overlay__card {
      box-shadow: none;
      border: 1px solid var(--color-border);
      max-width: none;
    }
  }
</style>

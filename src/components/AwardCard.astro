---
/**
 * AwardCard Component
 * Displays an individual award, press mention, best-of list entry, or certification.
 * Includes logo, title, source, quote, and link to article.
 *
 * Features:
 * - Award type badge with icon
 * - Optional organization logo
 * - Quote/excerpt display
 * - Year display
 * - Link to original article
 * - Featured variant highlighting
 * - Responsive design
 * - Dark mode support
 * - Accessibility compliant
 * - Reduced motion support
 *
 * @example Basic usage
 * ```astro
 * <AwardCard
 *   id="award-1"
 *   title="Best Restaurant"
 *   source="Houston Chronicle"
 *   type="best-of"
 *   year={2024}
 * />
 * ```
 *
 * @example With quote and link
 * ```astro
 * <AwardCard
 *   id="award-2"
 *   title="Top 10 Restaurants"
 *   source="Texas Monthly"
 *   type="press"
 *   year={2024}
 *   quote="A must-visit destination..."
 *   articleUrl="https://example.com/article"
 *   featured={true}
 * />
 * ```
 */

import type { AwardCardProps } from '../types/award';
import { AWARD_TYPE_INFO } from '../config/awards.config';

interface Props extends AwardCardProps {}

const {
  id,
  title,
  source,
  logoUrl,
  logoAlt,
  type,
  year,
  quote,
  articleUrl,
  description,
  featured = false,
  badgeColor,
  showLogo = true,
  showYear = true,
  showQuote = true,
  class: className = '',
  testId = 'award-card',
} = Astro.props;

// Build CSS classes
const cardClasses = [
  'award-card',
  featured && 'award-card--featured',
  className,
].filter(Boolean).join(' ');

// Get type info for badge
const typeInfo = AWARD_TYPE_INFO[type] || AWARD_TYPE_INFO.award;
const displayColor = badgeColor || typeInfo.color;

// Determine if we should show the article link
const hasLink = !!articleUrl;

// Card wrapper element
const WrapperTag = hasLink ? 'a' : 'article';
---

<WrapperTag
  class={cardClasses}
  data-award-id={id}
  data-testid={testId}
  aria-label={`${title} from ${source}`}
  {...hasLink ? { href: articleUrl, target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  {/* Type Badge */}
  <div class="award-card__badge" style={`--badge-color: ${displayColor};`}>
    <svg class="award-card__badge-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={typeInfo.icon} />
    </svg>
    <span class="award-card__badge-label">{typeInfo.label}</span>
  </div>

  {/* Logo (if available and enabled) */}
  {showLogo && logoUrl && (
    <div class="award-card__logo-container">
      <img
        class="award-card__logo"
        src={logoUrl}
        alt={logoAlt || `${source} logo`}
        width="120"
        height="60"
        loading="lazy"
      />
    </div>
  )}

  {/* Content */}
  <div class="award-card__content">
    {/* Title */}
    <h3 class="award-card__title">{title}</h3>

    {/* Source and Year */}
    <div class="award-card__meta">
      <span class="award-card__source">{source}</span>
      {showYear && year && (
        <>
          <span class="award-card__separator" aria-hidden="true">|</span>
          <span class="award-card__year">{year}</span>
        </>
      )}
    </div>

    {/* Quote or Description */}
    {showQuote && quote && (
      <blockquote class="award-card__quote">
        <p class="award-card__quote-text">"{quote}"</p>
      </blockquote>
    )}

    {!quote && description && (
      <p class="award-card__description">{description}</p>
    )}
  </div>

  {/* Link indicator for cards with articles */}
  {hasLink && (
    <div class="award-card__link-indicator" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
      <span class="award-card__link-text">Read Article</span>
    </div>
  )}

  {/* Featured badge */}
  {featured && (
    <div class="award-card__featured-badge" aria-label="Featured recognition">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <span>Featured</span>
    </div>
  )}
</WrapperTag>

<style>
  /* =================================================================
   * AWARD CARD COMPONENT STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention for maintainability
   */

  .award-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    padding: var(--spacing-6);
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-200) var(--ease-out),
                box-shadow var(--duration-200) var(--ease-out),
                border-color var(--duration-200) var(--ease-out);
    text-decoration: none;
    color: inherit;
  }

  a.award-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary-200);
  }

  a.award-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Featured Variant */
  .award-card--featured {
    border-color: var(--color-primary-200);
    background: linear-gradient(
      135deg,
      var(--color-background-elevated) 0%,
      var(--color-primary-50) 100%
    );
  }

  /* Type Badge */
  .award-card__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1-5);
    padding: var(--spacing-1) var(--spacing-2-5);
    background-color: var(--badge-color, var(--color-primary));
    color: white;
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    width: fit-content;
    box-shadow: var(--shadow-sm);
  }

  .award-card__badge-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .award-card__badge-label {
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Logo */
  .award-card__logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-3);
    background-color: var(--color-background-subtle);
    border-radius: var(--radius-lg);
    min-height: 80px;
  }

  .award-card__logo {
    max-width: 100%;
    max-height: 60px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: filter var(--duration-200) var(--ease-out),
                opacity var(--duration-200) var(--ease-out);
  }

  .award-card:hover .award-card__logo {
    filter: grayscale(0%);
    opacity: 1;
  }

  /* Content */
  .award-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    flex: 1;
  }

  .award-card__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-tight);
  }

  .award-card__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    flex-wrap: wrap;
  }

  .award-card__source {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
  }

  .award-card__separator {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-xs);
  }

  .award-card__year {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  /* Quote */
  .award-card__quote {
    margin: var(--spacing-2) 0 0;
    padding: 0;
    border-left: 3px solid var(--color-primary-200);
    padding-left: var(--spacing-3);
  }

  .award-card__quote-text {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-style: italic;
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Description */
  .award-card__description {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin: var(--spacing-2) 0 0;
  }

  /* Link Indicator */
  .award-card__link-indicator {
    display: flex;
    align-items: center;
    gap: var(--spacing-1-5);
    margin-top: auto;
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-border-light);
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    transition: gap var(--duration-200) var(--ease-out);
  }

  a.award-card:hover .award-card__link-indicator {
    gap: var(--spacing-2);
  }

  .award-card__link-indicator svg {
    flex-shrink: 0;
  }

  .award-card__link-text {
    white-space: nowrap;
  }

  /* Featured Badge */
  .award-card__featured-badge {
    position: absolute;
    top: var(--spacing-3);
    right: var(--spacing-3);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    padding: var(--spacing-1) var(--spacing-2);
    background: var(--gradient-primary);
    color: var(--color-text-inverse);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    box-shadow: var(--shadow-sm);
  }

  .award-card__featured-badge svg {
    width: 12px;
    height: 12px;
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * =================================================================
   */

  @media screen and (min-width: 640px) {
    .award-card {
      padding: var(--spacing-8);
    }

    .award-card__title {
      font-size: var(--font-size-xl);
    }

    .award-card__quote-text {
      font-size: var(--font-size-base);
    }
  }

  /* =================================================================
   * DARK MODE SUPPORT
   * =================================================================
   */

  html[data-theme="dark"] .award-card {
    background-color: var(--color-background-elevated);
    border-color: var(--color-border);
  }

  html[data-theme="dark"] .award-card--featured {
    background: linear-gradient(
      135deg,
      var(--color-background-elevated) 0%,
      rgba(54, 83, 149, 0.15) 100%
    );
    border-color: var(--color-primary-700);
  }

  html[data-theme="dark"] a.award-card:hover {
    border-color: var(--color-primary-600);
  }

  html[data-theme="dark"] .award-card__logo-container {
    background-color: var(--color-background-muted);
  }

  html[data-theme="dark"] .award-card__logo {
    filter: grayscale(100%) brightness(1.2);
  }

  html[data-theme="dark"] .award-card:hover .award-card__logo {
    filter: grayscale(0%) brightness(1.1);
  }

  html[data-theme="dark"] .award-card__quote {
    border-left-color: var(--color-primary-600);
  }

  /* =================================================================
   * REDUCED MOTION
   * =================================================================
   */

  @media (prefers-reduced-motion: reduce) {
    .award-card {
      transition: none;
    }

    a.award-card:hover {
      transform: none;
    }

    .award-card__logo,
    .award-card__link-indicator {
      transition: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * =================================================================
   */

  @media print {
    .award-card {
      box-shadow: none;
      border: 1px solid #ccc;
      page-break-inside: avoid;
    }

    a.award-card:hover {
      transform: none;
      box-shadow: none;
    }

    .award-card__logo {
      filter: grayscale(0%);
      opacity: 1;
    }

    .award-card__badge {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .award-card__featured-badge {
      background: #333;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .award-card__link-indicator {
      display: none;
    }
  }
</style>

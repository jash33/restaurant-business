    .catering-form__submit:hover:not(:disabled) {
      transform: none;
    }

    .catering-form__spinner {
      animation: none;
    }

    .catering-form__input,
    .catering-form__select,
    .catering-form__textarea,
    .catering-form__checkbox-label,
    .catering-form__tag {
      transition: none;
    }

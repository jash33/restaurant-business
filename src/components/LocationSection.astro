<script>
  /**
   * Location Section Client-Side Logic
   * Handles copy-to-clipboard functionality and platform detection for maps
   */

  class LocationSection {
    private container: HTMLElement;
    private copyBtn: HTMLButtonElement | null;
    private announcer: HTMLElement | null;

    constructor(container: HTMLElement) {
      this.container = container;
      this.copyBtn = container.querySelector('[data-copy-address]');
      this.announcer = container.querySelector('[data-location-announcer]');

      this.initialize();
    }

    private initialize(): void {
      this.setupCopyButton();
      this.setupDirectionsLinks();
    }

    private setupCopyButton(): void {
      if (!this.copyBtn) return;

      this.copyBtn.addEventListener('click', async () => {
        const addressText = this.copyBtn?.dataset.addressText;
        if (!addressText) return;

        try {
          await navigator.clipboard.writeText(addressText);
          this.showCopiedFeedback();
          this.announce('Address copied to clipboard');
        } catch (err) {
          // Fallback for older browsers
          this.fallbackCopy(addressText);
        }
      });
    }

    private fallbackCopy(text: string): void {
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-9999px';
      document.body.appendChild(textArea);
      textArea.select();

      try {
        document.execCommand('copy');
        this.showCopiedFeedback();
        this.announce('Address copied to clipboard');
      } catch (err) {
        this.announce('Failed to copy address');
      }

      document.body.removeChild(textArea);
    }

    private showCopiedFeedback(): void {
      if (!this.copyBtn) return;

      this.copyBtn.classList.add('is-copied');

      setTimeout(() => {
        this.copyBtn?.classList.remove('is-copied');
      }, 2000);
    }

    private setupDirectionsLinks(): void {
      const googleBtn = this.container.querySelector('[data-directions="google"]');
      const appleBtn = this.container.querySelector('[data-directions="apple"]');

      // Detect platform and highlight appropriate button
      const isAppleDevice = /iPad|iPhone|iPod|Mac/.test(navigator.userAgent);

      if (isAppleDevice && appleBtn) {
        appleBtn.classList.add('location-directions__btn--preferred');
      } else if (googleBtn) {
        googleBtn.classList.add('location-directions__btn--preferred');
      }
    }

    private announce(message: string): void {
      if (!this.announcer) return;
      this.announcer.textContent = message;

      // Clear after announcement
      setTimeout(() => {
        if (this.announcer) {
          this.announcer.textContent = '';
        }
      }, 1000);
    }
  }

  // Initialize all location sections on the page
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll<HTMLElement>('[data-location-section]');
    sections.forEach((section) => new LocationSection(section));
  });

  // Also initialize on Astro page transitions
  document.addEventListener('astro:page-load', () => {
    const sections = document.querySelectorAll<HTMLElement>('[data-location-section]');
    sections.forEach((section) => new LocationSection(section));
  });
</script>

---
/**
 * Yelp Reviews Component
 * Displays Yelp reviews, highlights, and a link to the full Yelp page.
 * Follows Yelp Brand Guidelines for proper attribution.
 *
 * Brand Guidelines: https://www.yelp.com/brand
 * - Always includes Yelp attribution
 * - Links back to Yelp page
 * - Shows authentic review content
 *
 * Features:
 * - Star rating display with aggregate rating
 * - Featured customer reviews with author info
 * - Review highlights section for impactful quotes
 * - Link to full Yelp page
 * - Review CTA with encouraging messaging
 * - Full JSON-LD review schema markup for SEO
 * - WCAG 2.1 AA compliant
 * - Mobile-first responsive design
 *
 * @example Basic usage
 * ```astro
 * <YelpReviews />
 * ```
 *
 * @example With custom options
 * ```astro
 * <YelpReviews
 *   heading="What Yelpers Say"
 *   maxReviews={3}
 *   showHighlights={true}
 *   showReviewCTA={true}
 * />
 * ```
 */

import type { YelpReviewsProps } from '../types/yelp';
import {
  yelpConfig,
  generateYelpReviewSchemaItems,
  formatPriceLevel,
  YELP_COLORS,
} from '../config/yelp.config';
import YelpBadge from './YelpBadge.astro';

interface Props extends YelpReviewsProps {}

const {
  id = 'yelp-reviews',
  heading = 'What Yelpers Are Saying',
  subheading = `Rated ${yelpConfig.rating} stars by ${yelpConfig.totalReviews}+ reviewers on Yelp`,
  class: className = '',
  maxReviews = 4,
  showHighlights = true,
  maxHighlights = 4,
  showReviewCTA = true,
  showYelpLink = true,
  variant = 'default',
} = Astro.props;

// Get data from config
const {
  rating,
  totalReviews,
  featuredReviews,
  reviewHighlights,
  profileUrl,
  reviewUrl,
  businessName,
  priceLevel,
  categories,
} = yelpConfig;

// Limit reviews and highlights to display
const displayReviews = featuredReviews.slice(0, maxReviews);
const displayHighlights = reviewHighlights?.slice(0, maxHighlights) || [];

// Calculate full and half stars
const fullStars = Math.floor(rating);
const hasHalfStar = rating % 1 >= 0.25 && rating % 1 < 0.75;
const hasAlmostFullStar = rating % 1 >= 0.75;
const adjustedFullStars = fullStars + (hasAlmostFullStar ? 1 : 0);
const adjustedEmptyStars = 5 - adjustedFullStars - (hasHalfStar ? 1 : 0);

// Generate review schema for JSON-LD
const reviewSchemaItems = generateYelpReviewSchemaItems();

// Build CSS classes
const sectionClasses = [
  'yelp-reviews',
  `yelp-reviews--${variant}`,
  className,
].filter(Boolean).join(' ');

// Star SVG icons (Yelp-style)
const starFull = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>`;
const starHalf = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill-opacity="0.3"/><path d="M12 17.27V2l-2.81 6.63L2 9.24l5.46 4.73L5.82 21z"/></svg>`;
const starEmpty = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill-opacity="0.3"/></svg>`;

// Yelp logo SVG
const yelpLogo = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
  <path fill="#FF1A1A" d="M12.7 14.3c-.1-.1-.3-.2-.4-.1l-3.4 1.4c-.4.2-.4.7 0 .9l3.4 1.4c.2.1.4 0 .4-.2l.4-3.1c0-.1 0-.2-.1-.3h-.3zM9.3 14.8c-.1-.4-.5-.5-.8-.3l-2.8 2.1c-.3.2-.3.6.1.8l3.2 1.1c.2.1.4-.1.4-.3l-.1-3.4zM11.9 5.5c-.4-.1-.7.2-.7.5l-.2 4.8c0 .2.1.3.3.4l3.2.4c.2 0 .4-.1.4-.3l-2.5-5.6c-.1-.1-.3-.2-.5-.2zM8.8 12.3l-3.2-.9c-.4-.1-.7.2-.6.6l.9 3.2c.1.2.3.3.5.2l2.8-2.3c.2-.2.1-.5-.1-.6l-.3-.2zM15 9.5l2.3-2.4c.3-.3.2-.7-.2-.8l-3.3-.7c-.2 0-.4.1-.4.3l.6 3.4c0 .2.3.4.5.3l.5-.1z"/>
</svg>`;

// Quote icon SVG
const quoteIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/></svg>`;
---

<section
  class={sectionClasses}
  id={id}
  aria-labelledby={`${id}-heading`}
  data-section="yelp-reviews"
>
  <div class="yelp-reviews__container">
    <!-- Section Header -->
    <header class="yelp-reviews__header section-heading--decorated">
      <h2 id={`${id}-heading`} class="yelp-reviews__heading">
        {heading}
      </h2>
      <p class="yelp-reviews__subheading">
        {subheading}
      </p>
    </header>

    <!-- Rating Summary Card -->
    <div class="yelp-reviews__summary">
      <div class="yelp-reviews__rating-card">
        <!-- Yelp Badge -->
        <div class="yelp-reviews__yelp-badge">
          <span class="yelp-reviews__yelp-logo" set:html={yelpLogo} />
          <span class="yelp-reviews__yelp-text">Yelp</span>
        </div>

        <!-- Rating Display -->
        <div class="yelp-reviews__rating-display">
          <span class="yelp-reviews__rating-value">{rating.toFixed(1)}</span>
          <div class="yelp-reviews__stars" role="img" aria-label={`${rating} out of 5 stars`}>
            {Array(adjustedFullStars).fill(null).map(() => (
              <span class="yelp-reviews__star yelp-reviews__star--full" set:html={starFull} />
            ))}
            {hasHalfStar && (
              <span class="yelp-reviews__star yelp-reviews__star--half" set:html={starHalf} />
            )}
            {Array(adjustedEmptyStars).fill(null).map(() => (
              <span class="yelp-reviews__star yelp-reviews__star--empty" set:html={starEmpty} />
            ))}
          </div>
        </div>

        <!-- Review Count -->
        <p class="yelp-reviews__review-count">
          Based on <strong>{totalReviews.toLocaleString()}</strong> reviews
        </p>

        <!-- Price & Categories -->
        {(priceLevel || categories) && (
          <div class="yelp-reviews__meta">
            {priceLevel && (
              <span class="yelp-reviews__price">{formatPriceLevel(priceLevel)}</span>
            )}
            {priceLevel && categories && <span class="yelp-reviews__meta-sep" aria-hidden="true">•</span>}
            {categories && (
              <span class="yelp-reviews__categories">{categories.slice(0, 2).join(', ')}</span>
            )}
          </div>
        )}

        <!-- View on Yelp Link -->
        {showYelpLink && (
          <a
            href={profileUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="yelp-reviews__profile-link"
            aria-label={`View ${businessName} on Yelp (opens in new tab)`}
            data-tracking="yelp-profile-click"
          >
            View on Yelp
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 19H5V5h7V3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Review Highlights Section -->
    {showHighlights && displayHighlights.length > 0 && (
      <div class="yelp-reviews__highlights" aria-labelledby="yelp-highlights-heading">
        <h3 id="yelp-highlights-heading" class="yelp-reviews__highlights-heading">
          Guest Favorites
        </h3>
        <div class="yelp-reviews__highlights-grid" role="list">
          {displayHighlights.map((highlight, index) => (
            <div
              class="yelp-reviews__highlight reveal reveal--scale-up"
              style={`--reveal-delay: ${index * 100}ms`}
              role="listitem"
            >
              <span class="yelp-reviews__highlight-quote" set:html={quoteIcon} />
              <blockquote class="yelp-reviews__highlight-text">
                {highlight.excerpt}
              </blockquote>
              <cite class="yelp-reviews__highlight-author">
                — {highlight.authorName}
              </cite>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Featured Reviews Grid -->
    <div class="yelp-reviews__reviews" role="list" aria-label="Customer reviews from Yelp">
      {displayReviews.map((review, index) => (
        <article
          class="yelp-reviews__review reveal reveal--up"
          style={`--reveal-delay: ${index * 100}ms`}
          role="listitem"
        >
          <header class="yelp-reviews__review-header">
            <div class="yelp-reviews__reviewer">
              <div class="yelp-reviews__reviewer-avatar" aria-hidden="true">
                {review.authorName.charAt(0).toUpperCase()}
              </div>
              <div class="yelp-reviews__reviewer-info">
                <span class="yelp-reviews__reviewer-name">{review.authorName}</span>
                <span class="yelp-reviews__review-date">{review.relativeTimeDescription}</span>
              </div>
            </div>
            <div class="yelp-reviews__review-rating" role="img" aria-label={`${review.rating} out of 5 stars`}>
              {Array(review.rating).fill(null).map(() => (
                <span class="yelp-reviews__star yelp-reviews__star--small" set:html={starFull} />
              ))}
            </div>
          </header>
          <blockquote class="yelp-reviews__review-text">
            <p>"{review.text}"</p>
          </blockquote>
          {review.reviewUrl && (
            <a
              href={review.reviewUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="yelp-reviews__review-link"
              aria-label={`Read full review by ${review.authorName} on Yelp (opens in new tab)`}
            >
              Read on Yelp
            </a>
          )}
        </article>
      ))}
    </div>

    <!-- Review CTA Section -->
    {showReviewCTA && (
      <div class="yelp-reviews__cta">
        <div class="yelp-reviews__cta-content">
          <h3 class="yelp-reviews__cta-heading">Enjoyed Your Visit?</h3>
          <p class="yelp-reviews__cta-text">
            We'd love to hear about your experience! Your review helps other food lovers discover us.
          </p>
          <a
            href={reviewUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="yelp-reviews__cta-button"
            data-tracking="yelp-review-cta-click"
            aria-label="Leave a review on Yelp (opens in new tab)"
          >
            <span class="yelp-reviews__cta-button-logo" set:html={yelpLogo} />
            Write a Review on Yelp
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="yelp-reviews__cta-button-icon">
              <path d="M19 19H5V5h7V3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
            </svg>
          </a>
        </div>
      </div>
    )}

    <!-- Yelp Attribution -->
    <footer class="yelp-reviews__attribution">
      <p>
        Reviews and ratings from
        <a href={profileUrl} target="_blank" rel="noopener noreferrer">
          <span class="yelp-reviews__attribution-logo" set:html={yelpLogo} />
          Yelp
        </a>
      </p>
    </footer>
  </div>
</section>

<!-- JSON-LD Review Schema for SEO -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: businessName,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: rating,
    bestRating: 5,
    worstRating: 1,
    ratingCount: totalReviews,
    reviewCount: totalReviews,
  },
  review: reviewSchemaItems,
})} />

<style>
  /* =================================================================
   * YELP REVIEWS COMPONENT STYLES
   * =================================================================
   * Mobile-first responsive design with BEM naming convention
   * Uses official Yelp Red (#FF1A1A) per brand guidelines
   */

  .yelp-reviews {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background);
  }

  .yelp-reviews__container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  /* =================================================================
   * HEADER STYLES
   * =================================================================
   */

  .yelp-reviews__header {
    text-align: center;
    margin-bottom: var(--spacing-10);
  }

  .yelp-reviews__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-3) 0;
  }

  .yelp-reviews__subheading {
    font-family: var(--font-body);
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 50ch;
    margin-inline: auto;
  }

  /* =================================================================
   * RATING SUMMARY CARD
   * =================================================================
   */

  .yelp-reviews__summary {
    display: flex;
    justify-content: center;
    margin-bottom: var(--spacing-10);
  }

  .yelp-reviews__rating-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-6);
    background: var(--color-background-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-md);
    text-align: center;
    max-width: 320px;
    width: 100%;
  }

  .yelp-reviews__yelp-badge {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-4);
    padding: var(--spacing-2) var(--spacing-4);
    background: var(--color-background);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }

  .yelp-reviews__yelp-logo {
    display: flex;
    width: 20px;
    height: 20px;
  }

  .yelp-reviews__yelp-logo :global(svg) {
    width: 100%;
    height: 100%;
  }

  .yelp-reviews__yelp-text {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: #FF1A1A;
  }

  .yelp-reviews__rating-display {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-3);
  }

  .yelp-reviews__rating-value {
    font-family: var(--font-heading);
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1;
  }

  .yelp-reviews__stars {
    display: flex;
    gap: var(--spacing-1);
  }

  .yelp-reviews__star {
    display: flex;
    width: 24px;
    height: 24px;
    color: #FF1A1A; /* Yelp Red */
  }

  .yelp-reviews__star :global(svg) {
    width: 100%;
    height: 100%;
  }

  .yelp-reviews__star--small {
    width: 16px;
    height: 16px;
  }

  .yelp-reviews__review-count {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--spacing-2) 0;
  }

  .yelp-reviews__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    margin-bottom: var(--spacing-4);
  }

  .yelp-reviews__price {
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-medium);
  }

  .yelp-reviews__profile-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: #D32323;
    text-decoration: none;
    transition: color var(--duration-150) var(--ease-in-out);
  }

  .yelp-reviews__profile-link:hover {
    color: #FF1A1A;
    text-decoration: underline;
  }

  .yelp-reviews__profile-link svg {
    width: 16px;
    height: 16px;
  }

  /* =================================================================
   * HIGHLIGHTS SECTION
   * =================================================================
   */

  .yelp-reviews__highlights {
    margin-bottom: var(--spacing-10);
  }

  .yelp-reviews__highlights-heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    text-align: center;
    margin: 0 0 var(--spacing-6) 0;
  }

  .yelp-reviews__highlights-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-4);
  }

  .yelp-reviews__highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-5);
    background: linear-gradient(135deg, var(--color-background) 0%, var(--color-background-subtle) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-align: center;
    position: relative;
  }

  .yelp-reviews__highlight-quote {
    position: absolute;
    top: var(--spacing-2);
    left: var(--spacing-3);
    width: 24px;
    height: 24px;
    color: #FF1A1A;
    opacity: 0.2;
  }

  .yelp-reviews__highlight-quote :global(svg) {
    width: 100%;
    height: 100%;
  }

  .yelp-reviews__highlight-text {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    font-style: italic;
    margin: 0 0 var(--spacing-2) 0;
    border: none;
    padding: 0;
  }

  .yelp-reviews__highlight-author {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-style: normal;
    color: var(--color-text-tertiary);
  }

  /* =================================================================
   * REVIEWS GRID
   * =================================================================
   */

  .yelp-reviews__reviews {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-10);
  }

  .yelp-reviews__review {
    padding: var(--spacing-6);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--duration-300) var(--ease-out),
      box-shadow var(--duration-300) var(--ease-out);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .yelp-reviews__review:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .yelp-reviews__review-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--spacing-4);
    gap: var(--spacing-3);
  }

  .yelp-reviews__reviewer {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
  }

  .yelp-reviews__reviewer-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #FF1A1A 0%, #D32323 100%);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .yelp-reviews__reviewer-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-0-5);
  }

  .yelp-reviews__reviewer-name {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .yelp-reviews__review-date {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
  }

  .yelp-reviews__review-rating {
    display: flex;
    gap: 2px;
    flex-shrink: 0;
  }

  .yelp-reviews__review-text {
    margin: 0;
    border: none;
    padding: 0;
  }

  .yelp-reviews__review-text p {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    font-style: italic;
    margin: 0;
  }

  .yelp-reviews__review-link {
    display: inline-block;
    margin-top: var(--spacing-3);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: #D32323;
    text-decoration: none;
    transition: color var(--duration-150) var(--ease-in-out);
  }

  .yelp-reviews__review-link:hover {
    color: #FF1A1A;
    text-decoration: underline;
  }

  /* =================================================================
   * CTA SECTION
   * =================================================================
   */

  .yelp-reviews__cta {
    margin-bottom: var(--spacing-8);
  }

  .yelp-reviews__cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-8);
    background: linear-gradient(135deg, var(--color-background-subtle) 0%, var(--color-background-muted) 100%);
    border-radius: var(--radius-2xl);
    text-align: center;
  }

  .yelp-reviews__cta-heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-2) 0;
  }

  .yelp-reviews__cta-text {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin: 0 0 var(--spacing-6) 0;
    max-width: 40ch;
  }

  .yelp-reviews__cta-button {
    display: inline-flex;

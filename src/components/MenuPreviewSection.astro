---
/**
 * MenuPreviewSection Component
 * A homepage section showcasing 3-6 highlighted menu items in a masonry grid
 * or alternating layout with large photos.
 *
 * Features:
 * - Displays 3-6 featured menu items with prominent images
 * - Multiple layout options: masonry, alternating, or standard grid
 * - Optional category filter tabs
 * - Prominent "View Full Menu" call-to-action button
 * - Responsive design: 1 column (mobile) -> 2-3 columns (tablet/desktop)
 * - Hover effects and smooth transitions
 * - Lazy loading images for performance
 * - Full accessibility support (WCAG 2.1 AA)
 * - Reduced motion support
 * - Configurable through props for easy updating
 *
 * @example Basic usage with featured items
 * ```astro
 * <MenuPreviewSection
 *   heading="Featured Menu Items"
 *   subheading="Discover our signature dishes"
 * />
 * ```
 *
 * @example With custom items and layout
 * ```astro
 * <MenuPreviewSection
 *   heading="Chef's Selections"
 *   items={customItems}
 *   layout="alternating"
 *   showFilters={true}
 * />
 * ```
 */

import type { MenuItem, MenuCategory } from '../types/menu';
import { MENU_CATEGORY_OPTIONS } from '../types/menu';
import { getFeaturedItems, getMenuItemsByCategory } from '../config/menu.config';
import Button from './Button.astro';

interface Props {
  /** Section heading text */
  heading?: string;
  /** Section subheading/description text */
  subheading?: string;
  /** Array of menu items to display (3-6 recommended). If not provided, uses featured items */
  items?: MenuItem[];
  /** Number of items to display (3-6) */
  itemsToShow?: 3 | 4 | 5 | 6;
  /** Layout style for the menu items */
  layout?: 'masonry' | 'alternating' | 'grid';
  /** Whether to show category filter tabs */
  showFilters?: boolean;
  /** Initial category filter (only used if showFilters is true) */
  initialCategory?: MenuCategory | 'featured';
  /** Optional section ID for anchor links */
  id?: string;
  /** Additional CSS class names */
  class?: string;
  /** Text for the "View Full Menu" CTA button */
  viewAllText?: string;
  /** URL for the "View Full Menu" CTA button */
  viewAllHref?: string;
}

const {
  heading = 'Featured Menu Items',
  subheading = 'Discover our signature dishes crafted with passion and the finest ingredients.',
  items,
  itemsToShow = 6,
  layout = 'masonry',
  showFilters = false,
  initialCategory = 'featured',
  id = 'menu-preview',
  class: className = '',
  viewAllText = 'View Full Menu',
  viewAllHref = '/menu',
} = Astro.props;

// Get menu items - use provided items or fetch featured items
const menuItems = items || getFeaturedItems();
const displayItems = menuItems.slice(0, itemsToShow);

// Build CSS classes
const sectionClasses = [
  'menu-preview',
  `menu-preview--layout-${layout}`,
  className,
].filter(Boolean).join(' ');

// Check if we have items to display
const hasItems = displayItems && displayItems.length > 0;

// Filter categories to show (only categories with items)
const availableCategories: { value: MenuCategory | 'featured'; label: string }[] = [
  { value: 'featured', label: 'Featured' },
  ...MENU_CATEGORY_OPTIONS
    .filter(cat => getMenuItemsByCategory(cat.value).some(item => item.featured || item.chefRecommended))
    .slice(0, 4)
    .map(cat => ({ value: cat.value, label: cat.label }))
];

// Arrow icon for the CTA button
const arrowIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8-8-8z"/></svg>`;

// Dietary tag abbreviations and labels mapping
const dietaryTagInfo: Record<string, { abbr: string; label: string }> = {
  'vegetarian': { abbr: 'V', label: 'Vegetarian' },
  'vegan': { abbr: 'VG', label: 'Vegan' },
  'gluten-free': { abbr: 'GF', label: 'Gluten-Free' },
  'dairy-free': { abbr: 'DF', label: 'Dairy-Free' },
  'nut-free': { abbr: 'NF', label: 'Nut-Free' },
  'spicy': { abbr: 'S', label: 'Spicy' },
};
---

<section class={sectionClasses} id={id} aria-labelledby={`${id}-heading`}>
  <div class="menu-preview__container">
    <!-- Section Header -->
    <header class="menu-preview__header">
      <h2 id={`${id}-heading`} class="menu-preview__heading">{heading}</h2>
      {subheading && (
        <p class="menu-preview__subheading">{subheading}</p>
      )}
    </header>

    <!-- Category Filters (Optional) -->
    {showFilters && (
      <nav class="menu-preview__filters" role="tablist" aria-label="Filter menu items by category">
        {availableCategories.map((category, index) => (
          <button
            class={`menu-preview__filter-btn ${category.value === initialCategory ? 'menu-preview__filter-btn--active' : ''}`}
            role="tab"
            aria-selected={category.value === initialCategory ? 'true' : 'false'}
            data-category={category.value}
          >
            {category.label}
          </button>
        ))}
      </nav>
    )}

    <!-- Menu Items Grid -->
    {hasItems ? (
      <div class="menu-preview__grid" role="list" aria-label="Featured menu items">
        {displayItems.map((item, index) => (
          <article
            class={`menu-preview__item ${item.chefRecommended ? 'menu-preview__item--chef-pick' : ''}`}
            role="listitem"
            style={`--item-index: ${index}`}
          >
            {/* Image Container */}
            {item.image && (
              <div class="menu-preview__image-container">
                <img
                  src={item.image.src}
                  alt={item.image.alt}
                  width={item.image.width || 600}
                  height={item.image.height || 400}
                  loading="lazy"
                  decoding="async"
                  class="menu-preview__image"
                />
                {/* Overlay with badges */}
                <div class="menu-preview__image-overlay">
                  {item.chefRecommended && (
                    <span class="menu-preview__badge menu-preview__badge--chef" title="Chef's Recommendation">
                      <span aria-hidden="true">👨‍🍳</span> Chef's Pick
                    </span>
                  )}
                  {item.featured && !item.chefRecommended && (
                    <span class="menu-preview__badge menu-preview__badge--featured" title="Featured Item">
                      <span aria-hidden="true">⭐</span> Featured
                    </span>
                  )}
                  {item.isNew && (
                    <span class="menu-preview__badge menu-preview__badge--new" title="New Item">
                      New
                    </span>
                  )}
                </div>
              </div>
            )}

            {/* Content */}
            <div class="menu-preview__content">
              <div class="menu-preview__title-row">
                <h3 class="menu-preview__item-name">{item.name}</h3>
                <span class="menu-preview__item-price">{item.price.display}</span>
              </div>

              <p class="menu-preview__item-description">
                {item.shortDescription || item.description}
              </p>

              {/* Dietary Tags */}
              {item.dietaryTags && item.dietaryTags.length > 0 && (
                <div class="menu-preview__dietary-tags" role="list" aria-label="Dietary information">
                  {item.dietaryTags.slice(0, 3).map((tag) => {
                    const tagInfo = dietaryTagInfo[tag];
                    if (!tagInfo) return null;
                    return (
                      <span
                        class={`menu-preview__dietary-tag menu-preview__dietary-tag--${tag}`}
                        role="listitem"
                        title={tagInfo.label}
                        aria-label={tagInfo.label}
                      >
                        {tagInfo.abbr}
                      </span>
                    );
                  })}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <!-- Empty State -->
      <div class="menu-preview__empty" role="status" aria-live="polite">
        <div class="menu-preview__empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="currentColor"/>
          </svg>
        </div>
        <p class="menu-preview__empty-text">Featured menu items coming soon.</p>
      </div>
    )}

    <!-- View Full Menu CTA -->
    {hasItems && (
      <div class="menu-preview__cta">
        <Button
          text={viewAllText}
          href={viewAllHref}
          variant="secondary"
          size="large"
          iconPosition="trailing"
          ariaLabel="View full restaurant menu"
        >
          <Fragment slot="icon" set:html={arrowIcon} />
        </Button>
      </div>
    )}
  </div>
</section>

<style>
  /* =================================================================
   * MENU PREVIEW SECTION COMPONENT STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention for maintainability
   */

  .menu-preview {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background-subtle);
  }

  .menu-preview__container {
    max-width: var(--container-7xl);
    margin: 0 auto;
  }

  /* =================================================================
   * SECTION HEADER
   * ================================================================= */
  .menu-preview__header {
    text-align: center;
    margin-bottom: var(--spacing-8);
  }

  .menu-preview__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
  }

  .menu-preview__subheading {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 40rem;
    margin-left: auto;
    margin-right: auto;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * CATEGORY FILTERS
   * ================================================================= */
  .menu-preview__filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-10);
  }

  .menu-preview__filter-btn {
    appearance: none;
    border: var(--border-width-1) solid var(--color-border);
    background-color: var(--color-background-elevated);
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background-color var(--duration-150) var(--ease-in-out),
      border-color var(--duration-150) var(--ease-in-out),
      color var(--duration-150) var(--ease-in-out);
  }

  .menu-preview__filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .menu-preview__filter-btn--active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  .menu-preview__filter-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* =================================================================
   * MENU ITEMS GRID - MASONRY LAYOUT (Default)
   * ================================================================= */
  .menu-preview__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  /* Masonry layout - varied item sizes */
  .menu-preview--layout-masonry .menu-preview__grid {
    grid-template-columns: 1fr;
  }

  /* =================================================================
   * MENU ITEM CARD
   * ================================================================= */
  .menu-preview__item {
    background-color: var(--color-background-elevated);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--duration-300) var(--ease-in-out),
      box-shadow var(--duration-300) var(--ease-in-out);
    animation: fadeSlideUp 0.5s ease-out backwards;
    animation-delay: calc(var(--item-index, 0) * 0.1s);
  }

  .menu-preview__item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .menu-preview__item--chef-pick {
    border: var(--border-width-2) solid var(--color-primary-200);
  }

  /* =================================================================
   * IMAGE STYLES
   * ================================================================= */
  .menu-preview__image-container {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-background-muted);
  }

  .menu-preview__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-500) var(--ease-in-out);
  }

  .menu-preview__item:hover .menu-preview__image {
    transform: scale(1.05);
  }

  .menu-preview__image-overlay {
    position: absolute;
    top: var(--spacing-3);
    left: var(--spacing-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  /* =================================================================
   * BADGES
   * ================================================================= */
  .menu-preview__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    padding: var(--spacing-1) var(--spacing-2-5);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    backdrop-filter: blur(8px);
  }

  .menu-preview__badge--chef {
    background-color: rgba(114, 47, 55, 0.9);
    color: white;
  }

  .menu-preview__badge--featured {
    background-color: rgba(196, 167, 125, 0.9);
    color: var(--color-text-primary);
  }

  .menu-preview__badge--new {
    background-color: rgba(16, 185, 129, 0.9);
    color: white;
  }

  /* =================================================================
   * CONTENT STYLES
   * ================================================================= */
  .menu-preview__content {
    padding: var(--spacing-5);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .menu-preview__title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-4);
  }

  .menu-preview__item-name {
    font-family: var(--font-menu-item);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-tight);
    flex: 1;
  }

  .menu-preview__item-price {
    font-family: var(--font-menu-item);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    white-space: nowrap;
  }

  .menu-preview__item-description {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* =================================================================
   * DIETARY TAGS
   * ================================================================= */
  .menu-preview__dietary-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-1-5);
  }

  .menu-preview__dietary-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 20px;
    padding: 0 var(--spacing-1-5);
    border-radius: var(--radius-base);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
  }

  /* Vegetarian - Green */
  .menu-preview__dietary-tag--vegetarian {
    background-color: #dcfce7;
    color: #166534;
    border: var(--border-width-1) solid #86efac;
  }

  /* Vegan - Dark Green */
  .menu-preview__dietary-tag--vegan {
    background-color: #d1fae5;
    color: #065f46;
    border: var(--border-width-1) solid #6ee7b7;
  }

  /* Gluten-Free - Amber */
  .menu-preview__dietary-tag--gluten-free {
    background-color: #fef3c7;
    color: #92400e;
    border: var(--border-width-1) solid #fcd34d;
  }

  /* Dairy-Free - Blue */
  .menu-preview__dietary-tag--dairy-free {
    background-color: #dbeafe;
    color: #1e40af;
    border: var(--border-width-1) solid #93c5fd;
  }

  /* Nut-Free - Orange */
  .menu-preview__dietary-tag--nut-free {
    background-color: #ffedd5;
    color: #9a3412;
    border: var(--border-width-1) solid #fdba74;
  }

  /* Spicy - Red */
  .menu-preview__dietary-tag--spicy {
    background-color: #fee2e2;
    color: #991b1b;
    border: var(--border-width-1) solid #fca5a5;
  }

  /* =================================================================
   * EMPTY STATE
   * ================================================================= */
  .menu-preview__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-4);
    padding: var(--spacing-16) var(--spacing-8);
    background-color: var(--color-background-muted);
    border-radius: var(--radius-xl);
    border: 2px dashed var(--color-border);
  }

  .menu-preview__empty-icon {
    width: var(--spacing-16);
    height: var(--spacing-16);
    color: var(--color-text-tertiary);
  }

  .menu-preview__empty-icon svg {
    width: 100%;
    height: 100%;
  }

  .menu-preview__empty-text {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-tertiary);
    margin: 0;
    text-align: center;
  }

  /* =================================================================
   * VIEW FULL MENU CTA
   * ================================================================= */
  .menu-preview__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--spacing-10);
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */

  /* Tablet (640px) - 2 columns */
  @media screen and (min-width: 640px) {
    .menu-preview {
      padding: var(--spacing-20) var(--spacing-6);
    }

    .menu-preview__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-6);
    }

    /* Masonry layout - make first and fourth items span full width */
    .menu-preview--layout-masonry .menu-preview__item:nth-child(1),
    .menu-preview--layout-masonry .menu-preview__item:nth-child(4) {
      grid-column: span 2;
    }

    .menu-preview--layout-masonry .menu-preview__item:nth-child(1) .menu-preview__image-container,
    .menu-preview--layout-masonry .menu-preview__item:nth-child(4) .menu-preview__image-container {
      aspect-ratio: 21 / 9;
    }

    /* Alternating layout */
    .menu-preview--layout-alternating .menu-preview__item:nth-child(odd) {
      grid-column: 1;
    }

    .menu-preview--layout-alternating .menu-preview__item:nth-child(even) {
      grid-column: 2;
    }
  }

  /* Desktop (768px) */
  @media screen and (min-width: 768px) {
    .menu-preview {
      padding: var(--spacing-20) var(--spacing-8);
    }

    .menu-preview__header {
      margin-bottom: var(--spacing-10);
    }

    .menu-preview__heading {
      font-size: var(--font-size-4xl);
    }

    .menu-preview__grid {
      gap: var(--spacing-8);
    }

    .menu-preview__content {
      padding: var(--spacing-6);
    }

    .menu-preview__item-name {
      font-size: var(--font-size-2xl);
    }

    .menu-preview__cta {
      margin-top: var(--spacing-12);
    }
  }

  /* Large Desktop (1024px) - 3 columns for grid layout */
  @media screen and (min-width: 1024px) {
    .menu-preview--layout-grid .menu-preview__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Masonry at large screens */
    .menu-preview--layout-masonry .menu-preview__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .menu-preview--layout-masonry .menu-preview__item:nth-child(1) {
      grid-column: span 2;
      grid-row: span 1;
    }

    .menu-preview--layout-masonry .menu-preview__item:nth-child(4) {
      grid-column: span 1;
    }

    .menu-preview--layout-masonry .menu-preview__item:nth-child(5) {
      grid-column: span 2;
    }

    .menu-preview--layout-masonry .menu-preview__item:nth-child(5) .menu-preview__image-container {
      aspect-ratio: 21 / 9;
    }
  }

  /* XL Desktop (1280px) */
  @media screen and (min-width: 1280px) {
    .menu-preview {
      padding: var(--spacing-24) var(--spacing-8);
    }
  }

  /* =================================================================
   * ANIMATION
   * ================================================================= */
  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* CTA button fade in */
  .menu-preview__cta {
    animation: fadeIn 0.5s ease-out 0.6s backwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .menu-preview__item,
    .menu-preview__cta {
      animation: none;
    }

    .menu-preview__item:hover {
      transform: none;
    }

    .menu-preview__item:hover .menu-preview__image {
      transform: none;
    }
  }

  /* =================================================================
   * HIGH CONTRAST MODE
   * ================================================================= */
  @media (forced-colors: active) {
    .menu-preview__item {
      border: 2px solid currentColor;
    }

    .menu-preview__badge {
      border: 1px solid currentColor;
    }

    .menu-preview__dietary-tag {
      border: 1px solid currentColor;
    }

    .menu-preview__filter-btn {
      border: 2px solid currentColor;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */
  @media print {
    .menu-preview {
      padding: var(--spacing-8) 0;
      background-color: transparent;
    }

    .menu-preview__grid {
      gap: var(--spacing-4);
    }

    .menu-preview__item {
      animation: none;
      box-shadow: none;
      border: 1px solid #ccc;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .menu-preview__item:hover {
      transform: none;
    }

    .menu-preview__image-container {
      aspect-ratio: 16 / 9;
    }

    .menu-preview__cta,
    .menu-preview__filters {
      display: none;
    }

    .menu-preview__badge {
      background-color: #f0f0f0 !important;
      color: #333 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>

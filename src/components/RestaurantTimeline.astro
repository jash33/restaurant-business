  trophy: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0" /></svg>`,
  heart: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>`,
  sun: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>`,
  glass: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" /></svg>`,
  cake: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.87c1.355 0 2.697.055 4.024.165C17.155 8.51 18 9.473 18 10.608v2.513m-3-4.87v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0L3 16.5m15-3.38a48.474 48.474 0 00-6-.37c-2.032 0-4.034.125-6 .37m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.17c0 .62-.504 1.124-1.125 1.124H4.125A1.125 1.125 0 013 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 016 13.12M12.265 3.11a.375.375 0 11-.53 0L12 2.845l.265.265zm-3 0a.375.375 0 11-.53 0L9 2.845l.265.265zm6 0a.375.375 0 11-.53 0L15 2.845l.265.265z" /></svg>`,
  rocket: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" /></svg>`,
  default: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
};

function getMilestoneIcon(milestone: TimelineMilestone): string {
  if (milestone.icon && milestoneIcons[milestone.icon]) {
    return milestoneIcons[milestone.icon];
  }
  return milestoneIcons.default;
}
---

<section class={sectionClasses} aria-labelledby="restaurant-timeline-heading">
  <div class="restaurant-timeline__container">
    <header class="restaurant-timeline__header reveal reveal--up">
      <span class="restaurant-timeline__eyebrow">Our History</span>
      <h2 id="restaurant-timeline-heading" class="restaurant-timeline__heading">{heading}</h2>
      {subheading && <p class="restaurant-timeline__subheading">{subheading}</p>}
    </header>

    <div class="timeline" role="list" aria-label="Restaurant history timeline">
      {milestones.map((milestone, index) => (
        <article
          class={`timeline-item ${milestone.isHighlighted ? 'timeline-item--highlighted' : ''} reveal reveal--up`}
          role="listitem"
          style={`--item-index: ${index}`}
        >
          <!-- Timeline connector -->
          <div class="timeline-item__connector" aria-hidden="true">
            <div class="timeline-item__line timeline-item__line--top"></div>
            <div class="timeline-item__marker">
              <span class="timeline-item__icon" set:html={getMilestoneIcon(milestone)} />
            </div>
            <div class="timeline-item__line timeline-item__line--bottom"></div>
          </div>

          <!-- Content -->
          <div class="timeline-item__content">
            <div class="timeline-item__year-badge">
              <span class="timeline-item__year">{milestone.year}</span>
            </div>

            <div class="timeline-item__card">
              <h3 class="timeline-item__title">{milestone.title}</h3>
              <p class="timeline-item__description">{milestone.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Decorative Elements -->
  <div class="restaurant-timeline__decor restaurant-timeline__decor--top" aria-hidden="true"></div>
  <div class="restaurant-timeline__decor restaurant-timeline__decor--bottom" aria-hidden="true"></div>
</section>

<style>
  /* =================================================================
   * RESTAURANT TIMELINE SECTION - BASE STYLES
   * ================================================================= */
  .restaurant-timeline {
    position: relative;
    padding: var(--spacing-20) var(--spacing-4);
    background-color: var(--color-cream, var(--color-background-subtle));
    overflow: hidden;
  }

  .restaurant-timeline__container {
    position: relative;
    z-index: 1;
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  /* =================================================================
   * HEADER STYLES
   * ================================================================= */
  .restaurant-timeline__header {
    text-align: center;
    margin-bottom: var(--spacing-16);
  }

  .restaurant-timeline__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--spacing-3);
  }

  .restaurant-timeline__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4) 0;
    line-height: var(--line-height-tight);
  }

  .restaurant-timeline__subheading {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * TIMELINE LAYOUT
   * ================================================================= */
  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: flex;
    gap: var(--spacing-4);
    animation: fadeInItem 0.5s ease-out calc(var(--item-index) * 0.15s) backwards;
  }

  /* =================================================================
   * TIMELINE CONNECTOR
   * ================================================================= */
  .timeline-item__connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 48px;
  }

  .timeline-item__line {
    width: 2px;
    flex: 1;
    background: linear-gradient(
      to bottom,
      var(--color-primary-200),
      var(--color-primary-300)
    );
    min-height: var(--spacing-4);
  }

  .timeline-item:first-child .timeline-item__line--top {
    background: transparent;
  }

  .timeline-item:last-child .timeline-item__line--bottom {
    background: transparent;
  }

  .timeline-item__marker {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-600) 100%);
    border-radius: var(--radius-full);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-md), 0 0 0 4px var(--color-primary-50);
    flex-shrink: 0;
    transition: transform var(--duration-200) var(--ease-in-out);
  }

  .timeline-item:hover .timeline-item__marker {
    transform: scale(1.1);
  }

  .timeline-item--highlighted .timeline-item__marker {
    width: 56px;
    height: 56px;
    box-shadow: var(--shadow-lg), 0 0 0 6px var(--color-primary-100);
  }

  .timeline-item__icon {
    display: flex;
    width: 24px;
    height: 24px;
  }

  .timeline-item--highlighted .timeline-item__icon {
    width: 28px;
    height: 28px;
  }

  .timeline-item__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* =================================================================
   * TIMELINE CONTENT
   * ================================================================= */
  .timeline-item__content {
    flex: 1;
    padding-bottom: var(--spacing-8);
    padding-top: var(--spacing-1);
  }

  .timeline-item:last-child .timeline-item__content {
    padding-bottom: 0;
  }

  .timeline-item__year-badge {
    display: inline-block;
    margin-bottom: var(--spacing-3);
  }

  .timeline-item__year {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    background-color: var(--color-primary-50);
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-full);
    letter-spacing: var(--letter-spacing-wide);
  }

  .timeline-item--highlighted .timeline-item__year {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  .timeline-item__card {
    background-color: var(--color-background-elevated);
    border-radius: var(--radius-xl);
    padding: var(--spacing-6);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration-200) var(--ease-in-out);
  }

  .timeline-item:hover .timeline-item__card {
    box-shadow: var(--shadow-md);
  }

  .timeline-item--highlighted .timeline-item__card {
    border: 2px solid var(--color-primary-200);
    box-shadow: var(--shadow-md);
  }

  .timeline-item__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-2) 0;
    line-height: var(--line-height-tight);
  }

  .timeline-item--highlighted .timeline-item__title {
    font-size: var(--font-size-2xl);
    color: var(--color-primary);
  }

  .timeline-item__description {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  /* =================================================================
   * DECORATIVE ELEMENTS
   * ================================================================= */
  .restaurant-timeline__decor {
    position: absolute;
    border-radius: 50%;
    opacity: 0.05;
    background-color: var(--color-primary);
    pointer-events: none;
  }

  .restaurant-timeline__decor--top {
    top: -100px;
    right: -50px;
    width: 300px;
    height: 300px;
  }

  .restaurant-timeline__decor--bottom {
    bottom: -100px;
    left: -100px;
    width: 350px;
    height: 350px;
  }

  /* =================================================================
   * ANIMATIONS
   * ================================================================= */
  @keyframes fadeInItem {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */
  @media (min-width: 768px) {
    .restaurant-timeline {
      padding: var(--spacing-24) var(--spacing-6);
    }

    .restaurant-timeline__heading {
      font-size: var(--font-size-4xl);
    }

    .timeline-item {
      gap: var(--spacing-6);
    }

    .timeline-item__connector {
      width: 56px;
    }

    .timeline-item__marker {
      width: 56px;
      height: 56px;
    }

    .timeline-item--highlighted .timeline-item__marker {
      width: 64px;
      height: 64px;
    }

    .timeline-item__icon {
      width: 28px;
      height: 28px;
    }

    .timeline-item--highlighted .timeline-item__icon {
      width: 32px;
      height: 32px;
    }

    .timeline-item__card {
      padding: var(--spacing-8);
    }

    .timeline-item__content {
      padding-bottom: var(--spacing-10);
    }
  }

  @media (min-width: 1024px) {
    .timeline {
      position: relative;
      padding-left: 50%;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(
        to bottom,
        transparent,
        var(--color-primary-200) 5%,
        var(--color-primary-300) 50%,
        var(--color-primary-200) 95%,
        transparent
      );
      transform: translateX(-50%);
    }

    .timeline-item {
      position: relative;
      flex-direction: row-reverse;
      padding-left: var(--spacing-8);
      margin-left: calc(-100% + var(--spacing-8));
      width: calc(100% - var(--spacing-8));
    }

    .timeline-item:nth-child(even) {
      flex-direction: row;
      padding-left: 0;
      padding-right: var(--spacing-8);
      margin-left: 0;
    }

    .timeline-item__connector {
      position: absolute;
      left: calc(-1 * var(--spacing-8) - 28px);
      top: 0;
      width: 56px;
    }

    .timeline-item:nth-child(even) .timeline-item__connector {
      left: auto;
      right: calc(-1 * var(--spacing-8) - 28px);
    }

    .timeline-item__line {
      display: none;
    }

    .timeline-item__content {
      padding-bottom: var(--spacing-12);
      text-align: right;
    }

    .timeline-item:nth-child(even) .timeline-item__content {
      text-align: left;
    }

    .timeline-item__year-badge {
      justify-content: flex-end;
    }

    .timeline-item:nth-child(even) .timeline-item__year-badge {
      justify-content: flex-start;
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .timeline-item {
      animation: none;
    }

    .timeline-item:hover .timeline-item__marker {
      transform: none;
    }
  }

  /* =================================================================
   * DARK MODE SUPPORT
   * ================================================================= */
  [data-theme="dark"] .restaurant-timeline {
    background-color: var(--color-background-subtle);
  }

  [data-theme="dark"] .timeline-item__card {
    background-color: var(--color-background-elevated);
  }

  [data-theme="dark"] .timeline-item__year {
    background-color: var(--color-primary-900);
    color: var(--color-primary-200);
  }

  [data-theme="dark"] .timeline-item--highlighted .timeline-item__year {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  [data-theme="dark"] .timeline-item--highlighted .timeline-item__card {
    border-color: var(--color-primary-700);
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */

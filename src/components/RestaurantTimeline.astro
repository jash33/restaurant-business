---
/**
 * Restaurant Timeline Component
 *
 * Displays a visual timeline of restaurant history milestones with years,
 * titles, descriptions, and optional photos. Highlighted milestones are
 * visually emphasized.
 *
 * Features:
 * - Vertical timeline with alternating layout on desktop
 * - Year badges with milestone markers
 * - Highlighted milestone support
 * - Optional milestone photos
 * - WCAG 2.1 AA accessible
 * - Reveal animations for scroll engagement
 *
 * @example Basic usage:
 * ```astro
 * <RestaurantTimeline milestones={milestones} />
 * ```
 */

import type { RestaurantTimelineProps, TimelineMilestone } from '../types/about';

interface Props extends RestaurantTimelineProps {}

const {
  milestones,
  heading = 'Our Journey',
  subheading = "From our humble beginnings to today, every milestone tells a story of passion, perseverance, and community.",
  class: className = '',
} = Astro.props;

const sectionClasses = ['restaurant-timeline', className].filter(Boolean).join(' ');

// Milestone icon mappings
const milestoneIcons: Record<string, string> = {

---
/**
 * Food Image Component
 *
 * A highly optimized image component specifically designed for food photography.
 * Features:
 * - AVIF and WebP format support with automatic fallback
 * - Responsive srcsets optimized for food imagery
 * - Blur-up placeholder effect with shimmer animation
 * - Lazy loading with Intersection Observer
 * - Aggressive compression while preserving food colors/textures
 * - Targets Lighthouse 90+ score despite image-heavy content
 *
 * @example Basic usage:
 * ```astro
 * <FoodImage
 *   src="/images/dishes/pasta.jpg"
 *   alt="Fresh homemade pasta with tomato sauce"
 *   width={800}
 *   height={600}
 * />
 * ```
 *
 * @example With preset:
 * ```astro
 * <FoodImage
 *   src="/images/hero/main-dish.jpg"
 *   alt="Signature dish"
 *   width={1920}
 *   height={1080}
 *   preset="hero"
 * />
 * ```
 */

import { IMAGE_PRESETS, QUALITY_SETTINGS, PLACEHOLDER_CONFIG } from '../config/image.config';
import type { ImagePreset } from '../config/image.config';

interface Props {
  /** Image source URL */
  src: string;
  /** Alternative text for accessibility */
  alt: string;
  /** Original image width */
  width: number;
  /** Original image height */
  height: number;
  /** CSS class for the wrapper */
  class?: string;
  /** Image preset for common use cases */
  preset?: ImagePreset;
  /** Custom sizes attribute */
  sizes?: string;
  /** Loading strategy override */
  loading?: 'lazy' | 'eager';
  /** Fetch priority override */
  fetchPriority?: 'high' | 'low' | 'auto';
  /** Enable blur-up placeholder effect */
  placeholder?: boolean;
  /** Low-quality placeholder image URL (base64 or URL) */
  placeholderSrc?: string;
  /** Object fit style */
  objectFit?: 'cover' | 'contain' | 'fill' | 'none' | 'scale-down';
  /** Object position */
  objectPosition?: string;
  /** Border radius */
  borderRadius?: string;
  /** Custom aspect ratio (overrides width/height ratio) */
  aspectRatio?: string;
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  preset = 'foodPhoto',
  sizes: customSizes,
  loading: customLoading,
  fetchPriority: customFetchPriority,
  placeholder = true,
  placeholderSrc,
  objectFit = 'cover',
  objectPosition = 'center',
  borderRadius,
  aspectRatio,
} = Astro.props;

// Get preset configuration
const presetConfig = IMAGE_PRESETS[preset];

// Merge custom props with preset defaults
const sizes = customSizes || presetConfig.sizes;
const loading = customLoading || presetConfig.loading;
const fetchPriority = customFetchPriority || presetConfig.fetchPriority;
const quality = presetConfig.quality;

// Calculate aspect ratio
const computedAspectRatio = aspectRatio || `${width} / ${height}`;

// Check if source is SVG (no optimization needed)
const isSVG = src.toLowerCase().endsWith('.svg');

// Get file extension and base path
const lastDot = src.lastIndexOf('.');
const basePath = lastDot !== -1 ? src.substring(0, lastDot) : src;
const extension = lastDot !== -1 ? src.substring(lastDot + 1).toLowerCase() : '';

// Generate format variants
const avifSrc = isSVG ? src : `${basePath}.avif`;
const webpSrc = isSVG ? src : `${basePath}.webp`;

// Generate responsive srcset for each format
function generateSrcSet(imageSrc: string, widths: readonly number[]): string {
  return widths
    .filter(w => w <= width)
    .map(w => `${imageSrc} ${w}w`)
    .join(', ');
}

const responsiveWidths = presetConfig.widths;
const srcSetAvif = !isSVG ? generateSrcSet(avifSrc, responsiveWidths) : '';
const srcSetWebp = !isSVG ? generateSrcSet(webpSrc, responsiveWidths) : '';
const srcSetFallback = generateSrcSet(src, responsiveWidths);

// Generate placeholder styles
const placeholderBg = PLACEHOLDER_CONFIG.backgroundColor;
const blurAmount = PLACEHOLDER_CONFIG.blurAmount;

// Unique ID for this image instance
const imageId = `food-img-${Math.random().toString(36).substr(2, 9)}`;

// Compute wrapper styles
const wrapperStyles = [
  `aspect-ratio: ${computedAspectRatio}`,
  borderRadius && `border-radius: ${borderRadius}`,
].filter(Boolean).join('; ');

// Compute image styles
const imageStyles = [
  `object-fit: ${objectFit}`,
  `object-position: ${objectPosition}`,
].filter(Boolean).join('; ');
---

<div
  class:list={['food-image-wrapper', { 'has-placeholder': placeholder && !isSVG }, className]}
  style={wrapperStyles}
  data-image-id={imageId}
>
  {!isSVG ? (
    <picture>
      {/* AVIF source for modern browsers - best compression */}
      <source
        type="image/avif"
        srcset={srcSetAvif || avifSrc}
        sizes={sizes}
      />
      {/* WebP source - wide browser support */}
      <source
        type="image/webp"
        srcset={srcSetWebp || webpSrc}
        sizes={sizes}
      />
      {/* Fallback for legacy browsers */}
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        fetchpriority={fetchPriority}
        class="food-image"
        srcset={srcSetFallback || undefined}
        sizes={sizes}
        style={imageStyles}
        data-placeholder={placeholder ? 'true' : 'false'}
      />
    </picture>
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchPriority}
      class="food-image"
      style={imageStyles}
    />
  )}

  {/* Blur-up placeholder */}
  {placeholder && !isSVG && (
    <div
      class="food-image-placeholder"
      aria-hidden="true"
      style={placeholderSrc ? `background-image: url(${placeholderSrc}); background-size: cover; filter: blur(${blurAmount}px);` : undefined}
    >
      <div class="shimmer"></div>
    </div>
  )}
</div>

<style define:vars={{ placeholderBg, blurAmount: `${blurAmount}px` }}>
  .food-image-wrapper {
    position: relative;
    overflow: hidden;
    background-color: var(--placeholderBg);
    contain: layout style paint;
  }

  .food-image {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
    will-change: opacity;
  }

  /* Placeholder state - image hidden until loaded */
  .has-placeholder .food-image {
    opacity: 0;
  }

  .has-placeholder .food-image.loaded {
    opacity: 1;
  }

  /* Placeholder overlay */
  .food-image-placeholder {
    position: absolute;
    inset: 0;
    background-color: var(--placeholderBg);
    transition: opacity 0.4s ease-out;
    z-index: 1;
  }

  .has-placeholder .food-image.loaded ~ .food-image-placeholder,
  .has-placeholder picture:has(.food-image.loaded) ~ .food-image-placeholder {
    opacity: 0;
    pointer-events: none;
  }

  /* Shimmer animation for loading state */
  .shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.4) 50%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  /* Hide shimmer once loaded */
  .has-placeholder .food-image.loaded ~ .food-image-placeholder .shimmer,
  .has-placeholder picture:has(.food-image.loaded) ~ .food-image-placeholder .shimmer {
    animation: none;
    opacity: 0;
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .food-image {
      transition: none;
    }

    .shimmer {
      animation: none;
      background: rgba(0, 0, 0, 0.05);
    }

    .food-image-placeholder {
      transition: none;
    }
  }

  /* Hover effect for interactive images */
  .food-image-wrapper:hover .food-image.loaded {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .food-image-wrapper:hover .food-image.loaded {
      transform: none;
    }
  }
</style>

<script>
  /**
   * Food Image Loader
   * Handles blur-up placeholder effect and lazy loading
   */
  function initFoodImages() {
    const images = document.querySelectorAll<HTMLImageElement>('.food-image[data-placeholder="true"]');

    images.forEach((img) => {
      // Check if already loaded
      if (img.complete && img.naturalHeight !== 0) {
        img.classList.add('loaded');
        return;
      }

      // Add load event listener
      img.addEventListener('load', () => {
        img.classList.add('loaded');
      }, { once: true });

      // Handle error state
      img.addEventListener('error', () => {
        img.classList.add('loaded'); // Still remove placeholder on error
        console.warn(`Failed to load image: ${img.src}`);
      }, { once: true });
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initFoodImages);

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initFoodImages);

  // Handle dynamically added images
  if (typeof MutationObserver !== 'undefined') {
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        mutation.addedNodes.forEach((node) => {
          if (node instanceof HTMLElement) {
            const newImages = node.querySelectorAll<HTMLImageElement>('.food-image[data-placeholder="true"]:not(.loaded)');
            newImages.forEach((img) => {
              if (img.complete && img.naturalHeight !== 0) {
                img.classList.add('loaded');
              } else {
                img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
              }
            });
          }
        });
      });
    });

    // Start observing when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        observer.observe(document.body, { childList: true, subtree: true });
      });
    } else {
      observer.observe(document.body, { childList: true, subtree: true });
    }
  }
</script>

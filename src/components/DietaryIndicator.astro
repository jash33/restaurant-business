---
/**
 * DietaryIndicator Component
 * A reusable dietary indicator with SVG icon, tooltip, and accessibility support.
 * Displays dietary information (Gluten-Free, Vegan, Vegetarian, etc.) with
 * clear visual indicators and screen reader support.
 *
 * Features:
 * - Custom SVG icons for each dietary type
 * - Native tooltips with full descriptions
 * - ARIA labels for screen readers
 * - Color-coded badges for visual distinction
 * - Print-friendly styling
 * - High contrast mode support
 * - Reduced motion support
 *
 * @example Basic usage
 * ```astro
 * <DietaryIndicator tag="gluten-free" />
 * ```
 *
 * @example With custom size
 * ```astro
 * <DietaryIndicator tag="vegan" size="lg" />
 * ```
 */

import type { DietaryTag } from '../types/menu';

interface Props {
  /** The dietary tag to display */
  tag: DietaryTag;
  /** Size variant */
  size?: 'sm' | 'md' | 'lg';
  /** Whether to show the abbreviation text */
  showLabel?: boolean;
  /** Additional CSS class names */
  class?: string;
}

const {
  tag,
  size = 'md',
  showLabel = true,
  class: className = '',
} = Astro.props;

// Dietary tag information with SVG paths and descriptions

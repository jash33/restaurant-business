const info = dietaryTagInfo[tag];
const sizeClasses = {
  sm: 'dietary-indicator--sm',
  md: 'dietary-indicator--md',
  lg: 'dietary-indicator--lg',
};
---

<span
  class:list={[
    'dietary-indicator',
    `dietary-indicator--${tag}`,
    sizeClasses[size],
    className,
  ]}
  role="img"
  aria-label={`${info.label}: ${info.description}`}
  title={`${info.label}: ${info.description}`}
  data-dietary-tag={tag}
>
  <svg
    class="dietary-indicator__icon"
    viewBox={info.viewBox || '0 0 24 24'}
    fill="currentColor"
    aria-hidden="true"
  >
    <path d={info.iconPath} />
  </svg>
  {showLabel && (
    <span class="dietary-indicator__abbr">{info.abbr}</span>
  )}
</span>

<style>
  /* =================================================================
   * DIETARY INDICATOR BASE STYLES
   * ================================================================= */
  .dietary-indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-1);
    border-radius: var(--radius-base);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    cursor: help;
    transition:
      transform var(--duration-150) var(--ease-in-out),
      box-shadow var(--duration-150) var(--ease-in-out);
  }

  .dietary-indicator:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .dietary-indicator:focus {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  /* =================================================================
   * SIZE VARIANTS
   * ================================================================= */
  .dietary-indicator--sm {
    min-width: 22px;
    height: 18px;
    padding: 0 var(--spacing-1);
    font-size: 10px;
  }

  .dietary-indicator--sm .dietary-indicator__icon {
    width: 10px;
    height: 10px;
  }

  .dietary-indicator--md {
    min-width: 28px;
    height: 22px;
    padding: 0 var(--spacing-1-5);
    font-size: var(--font-size-xs);
  }

  .dietary-indicator--md .dietary-indicator__icon {
    width: 12px;
    height: 12px;
  }

  .dietary-indicator--lg {
    min-width: 36px;
    height: 28px;
    padding: 0 var(--spacing-2);
    font-size: var(--font-size-sm);
  }

  .dietary-indicator--lg .dietary-indicator__icon {
    width: 16px;
    height: 16px;
  }

  /* =================================================================
   * ICON STYLES
   * ================================================================= */
  .dietary-indicator__icon {
    flex-shrink: 0;
  }

  .dietary-indicator__abbr {
    font-weight: var(--font-weight-bold);
  }

  /* =================================================================
   * COLOR VARIANTS - Gluten-Free (Amber)
   * ================================================================= */
  .dietary-indicator--gluten-free {
    background-color: #fef3c7;
    color: #92400e;
    border: var(--border-width-1) solid #fcd34d;
  }

  /* =================================================================
   * COLOR VARIANTS - Vegan (Dark Green)
   * ================================================================= */
  .dietary-indicator--vegan {
    background-color: #d1fae5;
    color: #065f46;
    border: var(--border-width-1) solid #6ee7b7;
  }

  /* =================================================================
   * COLOR VARIANTS - Vegetarian (Green)
   * ================================================================= */
  .dietary-indicator--vegetarian {
    background-color: #dcfce7;
    color: #166534;
    border: var(--border-width-1) solid #86efac;
  }

  /* =================================================================
   * COLOR VARIANTS - Dairy-Free (Blue)
   * ================================================================= */
  .dietary-indicator--dairy-free {
    background-color: #dbeafe;
    color: #1e40af;
    border: var(--border-width-1) solid #93c5fd;
  }

  /* =================================================================
   * COLOR VARIANTS - Nut-Free (Orange)
   * ================================================================= */
  .dietary-indicator--nut-free {
    background-color: #ffedd5;
    color: #9a3412;
    border: var(--border-width-1) solid #fdba74;
  }

  /* =================================================================
   * COLOR VARIANTS - Spicy (Red)
   * ================================================================= */
  .dietary-indicator--spicy {
    background-color: #fee2e2;
    color: #991b1b;
    border: var(--border-width-1) solid #fca5a5;
  }

  /* =================================================================
   * COLOR VARIANTS - Egg-Free (Yellow)
   * ================================================================= */
  .dietary-indicator--egg-free {
    background-color: #fef9c3;
    color: #854d0e;
    border: var(--border-width-1) solid #fde047;
  }

  /* =================================================================
   * COLOR VARIANTS - Soy-Free (Teal)
   * ================================================================= */
  .dietary-indicator--soy-free {
    background-color: #ccfbf1;
    color: #115e59;
    border: var(--border-width-1) solid #5eead4;
  }

  /* =================================================================
   * COLOR VARIANTS - Halal (Purple)
   * ================================================================= */
  .dietary-indicator--halal {
    background-color: #f3e8ff;
    color: #6b21a8;
    border: var(--border-width-1) solid #d8b4fe;
  }

  /* =================================================================
   * COLOR VARIANTS - Kosher (Indigo)
   * ================================================================= */
  .dietary-indicator--kosher {
    background-color: #e0e7ff;
    color: #3730a3;
    border: var(--border-width-1) solid #a5b4fc;
  }

  /* =================================================================
   * COLOR VARIANTS - Organic (Lime)
   * ================================================================= */
  .dietary-indicator--organic {
    background-color: #ecfccb;
    color: #3f6212;
    border: var(--border-width-1) solid #bef264;
  }

  /* =================================================================
   * COLOR VARIANTS - Locally Sourced (Cyan)
   * ================================================================= */
  .dietary-indicator--locally-sourced {
    background-color: #cffafe;
    color: #155e75;
    border: var(--border-width-1) solid #67e8f9;
  }

  /* =================================================================
   * COLOR VARIANTS - Mild (Gray)
   * ================================================================= */
  .dietary-indicator--mild {
    background-color: #f3f4f6;
    color: #374151;
    border: var(--border-width-1) solid #d1d5db;
  }

  /* =================================================================
   * ACCESSIBILITY - REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .dietary-indicator {
      transition: none;
    }

    .dietary-indicator:hover {
      transform: none;
    }
  }

  /* =================================================================
   * HIGH CONTRAST MODE
   * ================================================================= */
  @media (forced-colors: active) {
    .dietary-indicator {
      border: 2px solid currentColor;
      forced-color-adjust: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */
  @media print {
    .dietary-indicator {
      font-size: 8pt;
      min-width: 18px;
      height: 14px;
      padding: 0 2px;
      background-color: #f0f0f0 !important;
      color: #333 !important;
      border: 1px solid #999 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .dietary-indicator__icon {
      display: none;
    }
  }
</style>

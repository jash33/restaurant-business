    }

    .restaurant-form__submit:hover {
      transform: none;
    }

    .restaurant-form__spinner {
      animation: none;
    }
  }
</style>

<script>
  /**
   * Restaurant Contact Form Client-Side Logic
   * Handles form toggle, validation, and submission
   */
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.restaurant-contact-section');
    if (!section) return;

    // Form toggle functionality
    const toggleButtons = section.querySelectorAll('[data-form-toggle]');
    const formPanels = section.querySelectorAll('[data-form-panel]');

    toggleButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetPanel = btn.getAttribute('data-form-toggle');

        // Update toggle buttons
        toggleButtons.forEach((b) => {
          const isActive = b.getAttribute('data-form-toggle') === targetPanel;
          b.classList.toggle('form-toggle__btn--active', isActive);
          b.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        // Update panels
        formPanels.forEach((panel) => {
          const isActive = panel.getAttribute('data-form-panel') === targetPanel;
          panel.classList.toggle('form-panel--active', isActive);
          panel.hidden = !isActive;
        });
      });
    });

    // Initialize form start times for spam prevention
    const generalStartTime = document.getElementById('general-form-start-time') as HTMLInputElement;
    const cateringStartTime = document.getElementById('catering-form-start-time') as HTMLInputElement;
    const now = Date.now().toString();
    if (generalStartTime) generalStartTime.value = now;
    if (cateringStartTime) cateringStartTime.value = now;

    // Validation patterns
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const phoneRegex = /^[\d\s\-\(\)\+]{10,20}$/;

    // Validation functions
    const validators = {
      name: (value: string) => {
        if (!value.trim()) return 'Name is required';
        if (value.trim().length < 2) return 'Name must be at least 2 characters';
        return null;
      },
      email: (value: string) => {
        if (!value.trim()) return 'Email is required';
        if (!emailRegex.test(value)) return 'Please enter a valid email address';
        return null;
      },
      phone: (value: string, required = false) => {
        if (!value.trim() && required) return 'Phone number is required';
        if (value.trim() && !phoneRegex.test(value)) return 'Please enter a valid phone number';
        return null;
      },
      inquiryType: (value: string) => {
        if (!value) return 'Please select an inquiry type';
        return null;
      },
      eventType: (value: string) => {
        if (!value) return 'Please select an event type';
        return null;
      },
      eventDate: (value: string) => {
        if (!value) return 'Event date is required';
        const selectedDate = new Date(value);
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        if (selectedDate < today) return 'Event date must be in the future';
        return null;
      },
      guestCount: (value: string) => {
        if (!value) return 'Number of guests is required';
        const count = parseInt(value, 10);
        if (isNaN(count) || count < 10) return 'Minimum 10 guests required';
        if (count > 1000) return 'Maximum 1000 guests allowed';
        return null;
      },
      message: (value: string, minLength: number) => {
        if (!value.trim()) return 'Message is required';
        if (value.trim().length < minLength) return `Message must be at least ${minLength} characters`;
        return null;
      },
    };

    // Setup form handlers
    const forms = section.querySelectorAll('form[data-form-type]');
    forms.forEach((form) => {
      const formType = form.getAttribute('data-form-type');
      const isGeneralForm = formType === 'general';
      const minMessageLength = isGeneralForm ? 10 : 10;

      // Real-time validation on input
      form.querySelectorAll('input, select, textarea').forEach((field) => {
        const input = field as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

        input.addEventListener('input', () => {
          clearFieldError(input);
          if (input.tagName === 'TEXTAREA') {
            updateCharCount(input as HTMLTextAreaElement);
          }
        });

        input.addEventListener('blur', () => {
          validateField(input, isGeneralForm, minMessageLength);
        });
      });

      // Form submission
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Check honeypot
        const honeypot = form.querySelector('input[name="_gotcha"]') as HTMLInputElement;
        if (honeypot && honeypot.value) {
          console.warn('Spam detected');
          return;
        }

        // Check submission time
        const startTimeInput = form.querySelector('input[name="_formStartTime"]') as HTMLInputElement;
        if (startTimeInput) {
          const startTime = parseInt(startTimeInput.value, 10);
          if (Date.now() - startTime < 3000) {
            showFormError(form, 'Please wait a moment before submitting.');
            return;
          }
        }

        // Validate all fields
        let isValid = true;
        form.querySelectorAll('input:not([type="hidden"]):not([type="checkbox"]), select, textarea').forEach((field) => {
          const input = field as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
          if (!validateField(input, isGeneralForm, minMessageLength)) {
            isValid = false;
          }
        });

        if (!isValid) {
          const firstError = form.querySelector('[aria-invalid="true"]') as HTMLElement;
          if (firstError) firstError.focus();
          return;
        }

        // Submit form
        const submitBtn = form.querySelector('[data-submit-btn]') as HTMLButtonElement;
        submitBtn.setAttribute('data-loading', 'true');
        submitBtn.disabled = true;

        try {
          const formData = new FormData(form as HTMLFormElement);
          const response = await fetch((form as HTMLFormElement).action, {
            method: 'POST',
            body: formData,
            headers: {
              Accept: 'application/json',
            },
          });

          if (response.ok) {
            showFormSuccess(form);
          } else {
            throw new Error('Form submission failed');
          }
        } catch (error) {
          showFormError(form, 'Something went wrong. Please try again or contact us directly.');
        } finally {
          submitBtn.setAttribute('data-loading', 'false');
          submitBtn.disabled = false;
        }
      });
    });

    function validateField(
      input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
      isGeneralForm: boolean,
      minMessageLength: number
    ): boolean {
      const name = input.name;
      const value = input.value;
      let error: string | null = null;

      switch (name) {
        case 'name':
          error = validators.name(value);
          break;
        case 'email':
          error = validators.email(value);
          break;
        case 'phone':
          error = validators.phone(value, !isGeneralForm);
          break;
        case 'inquiryType':
          error = validators.inquiryType(value);
          break;
        case 'eventType':
          error = validators.eventType(value);
          break;
        case 'eventDate':
          error = validators.eventDate(value);
          break;
        case 'guestCount':
          error = validators.guestCount(value);
          break;
        case 'message':
          error = validators.message(value, minMessageLength);
          break;
      }

      if (error) {
        showFieldError(input, error);
        return false;
      }

      clearFieldError(input);
      return true;
    }

    function showFieldError(input: HTMLElement, message: string) {
      input.setAttribute('aria-invalid', 'true');
      const errorId = input.getAttribute('aria-describedby')?.split(' ').find((id) => id.includes('error'));
      if (errorId) {
        const errorEl = document.getElementById(errorId);
        if (errorEl) errorEl.textContent = message;
      }
    }

    function clearFieldError(input: HTMLElement) {
      input.setAttribute('aria-invalid', 'false');
      const errorId = input.getAttribute('aria-describedby')?.split(' ').find((id) => id.includes('error'));
      if (errorId) {
        const errorEl = document.getElementById(errorId);
        if (errorEl) errorEl.textContent = '';
      }
    }

    function updateCharCount(textarea: HTMLTextAreaElement) {
      const countId = textarea.getAttribute('aria-describedby')?.split(' ').find((id) => id.includes('count'));
      if (countId) {
        const countEl = document.getElementById(countId);
        if (countEl) {
          const currentEl = countEl.querySelector('.char-current');
          if (currentEl) currentEl.textContent = textarea.value.length.toString();
        }
      }
    }

    function showFormError(form: Element, message: string) {
      const errorEl = form.querySelector('[id$="-form-error"]') as HTMLElement;
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }
    }

    function showFormSuccess(form: Element) {
      const successEl = form.querySelector('[id$="-form-success"]') as HTMLElement;
      const formFields = form.querySelectorAll('.restaurant-form__grid, .restaurant-form__section, .restaurant-form__field--full, .restaurant-form__submit');

      formFields.forEach((el) => {
        (el as HTMLElement).style.display = 'none';
      });

      if (successEl) {
        successEl.hidden = false;
      }
    }
  });
</script>

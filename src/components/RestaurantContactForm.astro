  :global(html[data-theme="dark"]) .restaurant-contact-section {
    background-color: var(--color-background);
  }

  :global(html[data-theme="dark"]) .restaurant-form {
    background-color: var(--color-background-elevated);
  }

  :global(html[data-theme="dark"]) .form-toggle {

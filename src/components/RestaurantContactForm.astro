---
/**
 * Restaurant Contact Form Component
 * A comprehensive contact form with toggle between general inquiries and catering requests.
 *
 * Features:
 * - Toggle between general inquiry and catering form
 * - Real-time client-side validation
 * - Honeypot spam prevention
 * - Time-based submission validation
 * - WCAG 2.1 AA compliant accessibility
 * - Loading and success/error states
 * - Responsive design
 * - Formspree integration for form handling
 *
 * @example
 * ```astro
 * <RestaurantContactForm formspreeId="your-formspree-id" />
 * ```
 */

import {
  INQUIRY_TYPE_OPTIONS,
  CALLBACK_TIME_OPTIONS,
  DEFAULT_RESTAURANT_CONTACT_VALIDATION_CONFIG,
} from '../types/restaurant-contact';
import {
  EVENT_TYPE_OPTIONS,
  CATERING_BUDGET_OPTIONS,
  MENU_PREFERENCE_OPTIONS,
  DIETARY_RESTRICTION_OPTIONS,
  DEFAULT_CATERING_VALIDATION_CONFIG,
} from '../types/catering-form';

interface Props {
  /** Formspree form ID for handling submissions */
  formspreeId?: string;
  /** Default form type to show */
  defaultFormType?: 'general' | 'catering';
  /** Custom heading */
  heading?: string;
  /** Custom description */
  description?: string;
}

const {
  formspreeId = 'xyzgvqkl',
  defaultFormType = 'general',
  heading = 'Get in Touch',
  description = "Have a question or want to plan an event? We'd love to hear from you.",
} = Astro.props;

const generalConfig = DEFAULT_RESTAURANT_CONTACT_VALIDATION_CONFIG;
const cateringConfig = DEFAULT_CATERING_VALIDATION_CONFIG;

// Calculate minimum date (today)
const today = new Date().toISOString().split('T')[0];
---

<section class="restaurant-contact-section" aria-labelledby="restaurant-contact-heading">
  <div class="restaurant-contact-container">
    <div class="restaurant-contact-header">
      <h2 id="restaurant-contact-heading" class="restaurant-contact-title">{heading}</h2>
      <p class="restaurant-contact-description">{description}</p>
    </div>

    <!-- Form Type Toggle -->
    <div class="form-toggle" role="tablist" aria-label="Choose inquiry type">
      <button
        type="button"
        role="tab"
        id="tab-general"
        aria-controls="panel-general"
        aria-selected={defaultFormType === 'general' ? 'true' : 'false'}
        class={`form-toggle__btn ${defaultFormType === 'general' ? 'form-toggle__btn--active' : ''}`}
        data-form-toggle="general"
      >
        <svg class="form-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
        General Inquiry
      </button>
      <button
        type="button"
        role="tab"
        id="tab-catering"
        aria-controls="panel-catering"
        aria-selected={defaultFormType === 'catering' ? 'true' : 'false'}
        class={`form-toggle__btn ${defaultFormType === 'catering' ? 'form-toggle__btn--active' : ''}`}
        data-form-toggle="catering"
      >
        <svg class="form-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
          <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
          <line x1="6" y1="1" x2="6" y2="4" />
          <line x1="10" y1="1" x2="10" y2="4" />
          <line x1="14" y1="1" x2="14" y2="4" />
        </svg>
        Catering Request
      </button>
    </div>

    <!-- General Inquiry Form Panel -->
    <div
      id="panel-general"
      role="tabpanel"
      aria-labelledby="tab-general"
      class={`form-panel ${defaultFormType === 'general' ? 'form-panel--active' : ''}`}
      data-form-panel="general"
    >
      <form
        id="general-inquiry-form"
        class="restaurant-form"
        action={`https://formspree.io/f/${formspreeId}`}
        method="POST"
        novalidate
        aria-describedby="general-form-description"
        data-form-type="general"
      >
        <!-- Hidden fields -->
        <input type="hidden" id="general-form-start-time" name="_formStartTime" value="" />
        <input type="hidden" name="_subject" value="New General Inquiry" />

        <!-- Honeypot field -->
        <div class="restaurant-form__honeypot" aria-hidden="true" tabindex="-1">
          <label for="general-website-url">Website URL</label>
          <input type="text" id="general-website-url" name="_gotcha" autocomplete="off" tabindex="-1" />
        </div>

        <p id="general-form-description" class="sr-only">
          Required fields are marked with an asterisk (*).
        </p>

        <div class="restaurant-form__grid">
          <!-- Name Field -->
          <div class="restaurant-form__field">
            <label for="general-name" class="restaurant-form__label">
              Name <span class="restaurant-form__required" aria-label="required">*</span>
            </label>
            <input
              type="text"
              id="general-name"
              name="name"
              class="restaurant-form__input"
              required
              autocomplete="name"
              maxlength={generalConfig.maxNameLength}
              aria-describedby="general-name-error"
              aria-invalid="false"
              placeholder="Your full name"
            />
            <span id="general-name-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
          </div>

          <!-- Email Field -->
          <div class="restaurant-form__field">
            <label for="general-email" class="restaurant-form__label">
              Email <span class="restaurant-form__required" aria-label="required">*</span>
            </label>
            <input
              type="email"
              id="general-email"
              name="email"
              class="restaurant-form__input"
              required
              autocomplete="email"
              maxlength={generalConfig.maxEmailLength}
              aria-describedby="general-email-error"
              aria-invalid="false"
              placeholder="your@email.com"
            />
            <span id="general-email-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
          </div>

          <!-- Phone Field -->
          <div class="restaurant-form__field">
            <label for="general-phone" class="restaurant-form__label">
              Phone <span class="restaurant-form__optional">(optional)</span>
            </label>
            <input
              type="tel"
              id="general-phone"
              name="phone"
              class="restaurant-form__input"
              autocomplete="tel"
              maxlength={generalConfig.maxPhoneLength}
              aria-describedby="general-phone-hint general-phone-error"
              aria-invalid="false"
              placeholder="(123) 456-7890"
            />
            <span id="general-phone-hint" class="restaurant-form__hint">For callbacks during office hours</span>
            <span id="general-phone-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
          </div>

          <!-- Inquiry Type Dropdown -->
          <div class="restaurant-form__field">
            <label for="general-inquiry-type" class="restaurant-form__label">
              Inquiry Type <span class="restaurant-form__required" aria-label="required">*</span>
            </label>
            <select
              id="general-inquiry-type"
              name="inquiryType"
              class="restaurant-form__select"
              required
              aria-describedby="general-inquiry-type-error"
              aria-invalid="false"
            >
              {INQUIRY_TYPE_OPTIONS.map((option) => (
                <option value={option.value} disabled={option.value === ''} selected={option.value === ''}>
                  {option.label}
                </option>
              ))}
            </select>
            <span id="general-inquiry-type-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
          </div>

          <!-- Preferred Callback Time -->
          <div class="restaurant-form__field">
            <label for="general-callback-time" class="restaurant-form__label">
              Preferred Callback Time <span class="restaurant-form__optional">(optional)</span>
            </label>
            <select
              id="general-callback-time"
              name="preferredCallbackTime"
              class="restaurant-form__select"
              aria-describedby="general-callback-time-hint general-callback-time-error"
              aria-invalid="false"
            >
              {CALLBACK_TIME_OPTIONS.map((option) => (
                <option value={option.value} selected={option.value === ''}>
                  {option.label}
                </option>
              ))}
            </select>
            <span id="general-callback-time-hint" class="restaurant-form__hint">Mon-Fri, 10 AM - 6 PM</span>
            <span id="general-callback-time-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
          </div>
        </div>

        <!-- Message Textarea -->
        <div class="restaurant-form__field restaurant-form__field--full">
          <label for="general-message" class="restaurant-form__label">
            Message <span class="restaurant-form__required" aria-label="required">*</span>
          </label>
          <textarea
            id="general-message"
            name="message"
            class="restaurant-form__textarea"
            required
            rows="5"
            minlength={generalConfig.minMessageLength}
            maxlength={generalConfig.maxMessageLength}
            aria-describedby="general-message-hint general-message-error general-message-count"
            aria-invalid="false"
            placeholder="How can we help you?"
          ></textarea>
          <div class="restaurant-form__textarea-footer">
            <span id="general-message-hint" class="restaurant-form__hint">
              Minimum {generalConfig.minMessageLength} characters
            </span>
            <span id="general-message-count" class="restaurant-form__char-count" aria-live="polite">
              <span class="char-current">0</span>/<span class="char-max">{generalConfig.maxMessageLength}</span>
            </span>
          </div>
          <span id="general-message-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Form Error -->
        <div id="general-form-error" class="restaurant-form__form-error" role="alert" aria-live="assertive" hidden></div>

        <!-- Form Success -->
        <div id="general-form-success" class="restaurant-form__form-success" role="status" aria-live="polite" hidden>
          <svg class="restaurant-form__success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
          <p class="restaurant-form__success-title">Thank you for your message!</p>
          <p class="restaurant-form__success-text">We'll get back to you within 24 hours during business days.</p>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="restaurant-form__submit"
          data-submit-btn
        >
          <span class="restaurant-form__submit-text">Send Message</span>
          <span class="restaurant-form__submit-loading" aria-hidden="true">
            <svg class="restaurant-form__spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="20" />
            </svg>
            Sending...
          </span>
        </button>
      </form>
    </div>

    <!-- Catering Request Form Panel -->
    <div
      id="panel-catering"
      role="tabpanel"
      aria-labelledby="tab-catering"
      class={`form-panel ${defaultFormType === 'catering' ? 'form-panel--active' : ''}`}
      data-form-panel="catering"
      hidden={defaultFormType !== 'catering'}
    >
      <form
        id="catering-inquiry-form"
        class="restaurant-form"
        action={`https://formspree.io/f/${formspreeId}`}
        method="POST"
        novalidate
        aria-describedby="catering-form-description"
        data-form-type="catering"
      >
        <!-- Hidden fields -->
        <input type="hidden" id="catering-form-start-time" name="_formStartTime" value="" />
        <input type="hidden" name="_subject" value="New Catering Request" />

        <!-- Honeypot field -->
        <div class="restaurant-form__honeypot" aria-hidden="true" tabindex="-1">
          <label for="catering-website-url">Website URL</label>
          <input type="text" id="catering-website-url" name="_gotcha" autocomplete="off" tabindex="-1" />
        </div>

        <p id="catering-form-description" class="sr-only">
          Required fields are marked with an asterisk (*).
        </p>

        <!-- Contact Information Section -->
        <div class="restaurant-form__section">
          <h3 class="restaurant-form__section-title">Contact Information</h3>
          <div class="restaurant-form__grid">
            <!-- Name Field -->
            <div class="restaurant-form__field">
              <label for="catering-name" class="restaurant-form__label">
                Name <span class="restaurant-form__required" aria-label="required">*</span>
              </label>
              <input
                type="text"
                id="catering-name"
                name="name"
                class="restaurant-form__input"
                required
                autocomplete="name"
                maxlength={cateringConfig.maxNameLength}
                aria-describedby="catering-name-error"
                aria-invalid="false"
                placeholder="Your full name"
              />
              <span id="catering-name-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
            </div>

            <!-- Email Field -->
            <div class="restaurant-form__field">
              <label for="catering-email" class="restaurant-form__label">
                Email <span class="restaurant-form__required" aria-label="required">*</span>
              </label>
              <input
                type="email"
                id="catering-email"
                name="email"
                class="restaurant-form__input"
                required
                autocomplete="email"
                maxlength={cateringConfig.maxEmailLength}
                aria-describedby="catering-email-error"
                aria-invalid="false"
                placeholder="your@email.com"
              />
              <span id="catering-email-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
            </div>

            <!-- Phone Field -->
            <div class="restaurant-form__field">
              <label for="catering-phone" class="restaurant-form__label">
                Phone <span class="restaurant-form__required" aria-label="required">*</span>
              </label>
              <input
                type="tel"
                id="catering-phone"
                name="phone"
                class="restaurant-form__input"
                required
                autocomplete="tel"
                maxlength={cateringConfig.maxPhoneLength}
                aria-describedby="catering-phone-hint catering-phone-error"
                aria-invalid="false"
                placeholder="(123) 456-7890"
              />
              <span id="catering-phone-hint" class="restaurant-form__hint">We'll call to discuss your event details</span>
              <span id="catering-phone-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
            </div>
          </div>
        </div>

        <!-- Event Details Section -->
        <div class="restaurant-form__section">
          <h3 class="restaurant-form__section-title">Event Details</h3>
          <div class="restaurant-form__grid">
            <!-- Event Type Dropdown -->
            <div class="restaurant-form__field">
              <label for="catering-event-type" class="restaurant-form__label">
                Event Type <span class="restaurant-form__required" aria-label="required">*</span>
              </label>
              <select
                id="catering-event-type"
                name="eventType"
                class="restaurant-form__select"
                required
                aria-describedby="catering-event-type-error"
                aria-invalid="false"
              >
                {EVENT_TYPE_OPTIONS.map((option) => (
                  <option value={option.value} disabled={option.value === ''} selected={option.value === ''}>
                    {option.label}
                  </option>
                ))}
              </select>
              <span id="catering-event-type-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
            </div>

            <!-- Event Date -->
            <div class="restaurant-form__field">
              <label for="catering-event-date" class="restaurant-form__label">
                Event Date <span class="restaurant-form__required" aria-label="required">*</span>
              </label>
              <input
                type="date"
                id="catering-event-date"
                name="eventDate"
                class="restaurant-form__input"
                required
                min={today}
                aria-describedby="catering-event-date-hint catering-event-date-error"
                aria-invalid="false"
              />
              <span id="catering-event-date-hint" class="restaurant-form__hint">We recommend booking at least 2 weeks in advance</span>
              <span id="catering-event-date-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
            </div>

            <!-- Guest Count -->
            <div class="restaurant-form__field">
              <label for="catering-guest-count" class="restaurant-form__label">
                Expected Guests <span class="restaurant-form__required" aria-label="required">*</span>
              </label>
              <input
                type="number"
                id="catering-guest-count"
                name="guestCount"
                class="restaurant-form__input"
                required
                min={cateringConfig.minGuestCount}
                max={cateringConfig.maxGuestCount}
                aria-describedby="catering-guest-count-hint catering-guest-count-error"
                aria-invalid="false"
                placeholder="Number of guests"
              />
              <span id="catering-guest-count-hint" class="restaurant-form__hint">{cateringConfig.minGuestCount}-{cateringConfig.maxGuestCount} guests</span>
              <span id="catering-guest-count-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
            </div>

            <!-- Budget Range -->
            <div class="restaurant-form__field">
              <label for="catering-budget" class="restaurant-form__label">
                Budget Range <span class="restaurant-form__optional">(optional)</span>
              </label>
              <select
                id="catering-budget"
                name="budgetRange"
                class="restaurant-form__select"
                aria-describedby="catering-budget-error"
                aria-invalid="false"
              >
                {CATERING_BUDGET_OPTIONS.map((option) => (
                  <option value={option.value} selected={option.value === ''}>
                    {option.label}
                  </option>
                ))}
              </select>
              <span id="catering-budget-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
            </div>
          </div>
        </div>

        <!-- Menu Preferences Section -->
        <div class="restaurant-form__section">
          <h3 class="restaurant-form__section-title">Menu Preferences</h3>
          <fieldset class="restaurant-form__fieldset">
            <legend class="restaurant-form__legend">Service Style <span class="restaurant-form__optional">(select all that interest you)</span></legend>
            <div class="restaurant-form__checkbox-grid">
              {MENU_PREFERENCE_OPTIONS.map((option) => (
                <label class="restaurant-form__checkbox-label">
                  <input
                    type="checkbox"
                    name="menuPreferences"
                    value={option.value}
                    class="restaurant-form__checkbox"
                  />
                  <span class="restaurant-form__checkbox-custom" aria-hidden="true"></span>
                  <span class="restaurant-form__checkbox-content">
                    <span class="restaurant-form__checkbox-text">{option.label}</span>
                    {option.description && (
                      <span class="restaurant-form__checkbox-desc">{option.description}</span>
                    )}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="restaurant-form__fieldset">
            <legend class="restaurant-form__legend">Dietary Requirements <span class="restaurant-form__optional">(select all that apply)</span></legend>
            <div class="restaurant-form__tag-grid">
              {DIETARY_RESTRICTION_OPTIONS.map((option) => (
                <label class="restaurant-form__tag-label">
                  <input
                    type="checkbox"
                    name="dietaryRestrictions"
                    value={option.value}
                    class="restaurant-form__tag-input"
                  />
                  <span class="restaurant-form__tag">{option.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        <!-- Additional Details -->
        <div class="restaurant-form__field restaurant-form__field--full">
          <label for="catering-message" class="restaurant-form__label">
            Additional Details <span class="restaurant-form__required" aria-label="required">*</span>
          </label>
          <textarea
            id="catering-message"
            name="message"
            class="restaurant-form__textarea"
            required
            rows="5"
            minlength={cateringConfig.minMessageLength}
            maxlength={cateringConfig.maxMessageLength}
            aria-describedby="catering-message-hint catering-message-error catering-message-count"
            aria-invalid="false"
            placeholder="Tell us more about your event - venue, time preferences, special requests, etc."
          ></textarea>
          <div class="restaurant-form__textarea-footer">
            <span id="catering-message-hint" class="restaurant-form__hint">
              Minimum {cateringConfig.minMessageLength} characters
            </span>
            <span id="catering-message-count" class="restaurant-form__char-count" aria-live="polite">
              <span class="char-current">0</span>/<span class="char-max">{cateringConfig.maxMessageLength}</span>
            </span>
          </div>
          <span id="catering-message-error" class="restaurant-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Form Error -->
        <div id="catering-form-error" class="restaurant-form__form-error" role="alert" aria-live="assertive" hidden></div>

        <!-- Form Success -->
        <div id="catering-form-success" class="restaurant-form__form-success" role="status" aria-live="polite" hidden>
          <svg class="restaurant-form__success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
          <p class="restaurant-form__success-title">Thank you for your catering request!</p>
          <p class="restaurant-form__success-text">Our events team will contact you within 48 hours to discuss your event.</p>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="restaurant-form__submit"
          data-submit-btn
        >
          <span class="restaurant-form__submit-text">Submit Catering Request</span>
          <span class="restaurant-form__submit-loading" aria-hidden="true">
            <svg class="restaurant-form__spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="20" />
            </svg>
            Sending...
          </span>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  /* =================================================================
   * SECTION CONTAINER
   * ================================================================= */
  .restaurant-contact-section {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background);
  }

  .restaurant-contact-container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  .restaurant-contact-header {
    text-align: center;
    margin-bottom: var(--spacing-8);
  }

  .restaurant-contact-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-3);
  }

  .restaurant-contact-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 36rem;
    margin: 0 auto;
  }

  /* =================================================================
   * FORM TOGGLE
   * ================================================================= */
  .form-toggle {
    display: flex;
    justify-content: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-8);
    padding: var(--spacing-1);
    background-color: var(--color-background-subtle);
    border-radius: var(--radius-xl);
    max-width: 28rem;
    margin-left: auto;
    margin-right: auto;
  }

  .form-toggle__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    flex: 1;
    padding: var(--spacing-3) var(--spacing-4);
    background-color: transparent;
    border: none;
    border-radius: var(--radius-lg);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--duration-200) var(--ease-in-out);
  }

  .form-toggle__btn:hover {
    color: var(--color-text-primary);
    background-color: var(--color-background-muted);
  }

  .form-toggle__btn:focus-visible {

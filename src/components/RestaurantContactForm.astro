  /* =================================================================
   * RESPONSIVE ADJUSTMENTS
   * ================================================================= */
  @media (max-width: 639px) {
    .restaurant-contact-section {
      padding: var(--spacing-12) var(--spacing-4);
    }

    .restaurant-contact-title {
      font-size: var(--font-size-2xl);
    }

    .restaurant-form {
      padding: var(--spacing-5);

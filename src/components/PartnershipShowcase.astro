---
/**
 * Partnership Showcase Component
 *
 * Displays ingredient partnerships with local farms, ranches, and artisan producers.
 * Features partner information, locations, featured products, and optional quotes.
 *
 * Features:
 * - Responsive card grid layout
 * - Partner type badges
 * - Featured products list
 * - Optional partner quotes
 * - WCAG 2.1 AA accessible
 * - Reveal animations for scroll engagement
 *
 * @example Basic usage:
 * ```astro
 * <PartnershipShowcase partnerships={partnerships} />
 * ```
 */

import type { PartnershipShowcaseProps, IngredientPartnership } from '../types/about';

interface Props extends PartnershipShowcaseProps {}

const {
  partnerships,
  heading = 'Our Partners',
  subheading = 'The local farms, ranches, and artisans who help us bring our vision to life.',
  class: className = '',
} = Astro.props;

const sectionClasses = ['partnership-showcase', className].filter(Boolean).join(' ');

// Partner type display names
const partnerTypeLabels: Record<IngredientPartnership['type'], string> = {
  farm: 'Local Farm',
  ranch: 'Ranch',
  fishery: 'Fishery',
  bakery: 'Bakery',
  dairy: 'Creamery',
  winery: 'Winery',
  distillery: 'Distillery',
  artisan: 'Artisan',
  other: 'Partner',
};

// Partner type icons
const partnerTypeIcons: Record<IngredientPartnership['type'], string> = {
  farm: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>`,
  ranch: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>`,
  fishery: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.893 13.393l-1.135-1.135a2.252 2.252 0 01-.421-.585l-1.08-2.16a.414.414 0 00-.663-.107.827.827 0 01-.812.21l-1.273-.363a.89.89 0 00-.738 1.595l.587.39c.59.395.674 1.23.172 1.732l-.2.2c-.212.212-.33.498-.33.796v.41c0 .409-.11.809-.32 1.158l-1.315 2.191a2.11 2.11 0 01-1.81 1.025 1.055 1.055 0 01-1.055-1.055v-1.172c0-.92-.56-1.747-1.414-2.089l-.655-.261a2.25 2.25 0 01-1.383-2.46l.007-.042a2.25 2.25 0 01.29-.787l.09-.15a2.25 2.25 0 012.37-1.048l1.178.236a1.125 1.125 0 001.302-.795l.208-.73a1.125 1.125 0 00-.578-1.315l-.665-.332-.091.091a2.25 2.25 0 01-1.591.659h-.18c-.249 0-.487.1-.662.274a.931.931 0 01-1.458-1.137l1.411-2.353a2.25 2.25 0 00.286-.76m11.928 9.869A9 9 0 008.965 3.525m11.928 9.868A9 9 0 118.965 3.525" /></svg>`,
  bakery: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.87c1.355 0 2.697.055 4.024.165C17.155 8.51 18 9.473 18 10.608v2.513m-3-4.87v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0L3 16.5m15-3.38a48.474 48.474 0 00-6-.37c-2.032 0-4.034.125-6 .37m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.17c0 .62-.504 1.124-1.125 1.124H4.125A1.125 1.125 0 013 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 016 13.12M12.265 3.11a.375.375 0 11-.53 0L12 2.845l.265.265zm-3 0a.375.375 0 11-.53 0L9 2.845l.265.265zm6 0a.375.375 0 11-.53 0L15 2.845l.265.265z" /></svg>`,
  dairy: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" /></svg>`,
  winery: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg>`,
  distillery: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" /></svg>`,
  artisan: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" /></svg>`,
  other: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 8.65h3.75a.75.75 0 00.75-.75V13.5a.75.75 0 00-.75-.75H6.75a.75.75 0 00-.75.75v3.75c0 .415.336.75.75.75z" /></svg>`,
};
---

<section class={sectionClasses} aria-labelledby="partnership-showcase-heading">
  <div class="partnership-showcase__container">
    <header class="partnership-showcase__header reveal reveal--up">
      <span class="partnership-showcase__eyebrow">Our Network</span>
      <h2 id="partnership-showcase-heading" class="partnership-showcase__heading">{heading}</h2>
      {subheading && <p class="partnership-showcase__subheading">{subheading}</p>}
    </header>

    <div class="partnership-showcase__grid">
      {partnerships.map((partner, index) => (
        <article
          class="partner-card reveal reveal--up"
          style={`--card-index: ${index}`}
        >
          <div class="partner-card__header">
            <div class="partner-card__icon-wrapper">
              <span class="partner-card__icon" set:html={partnerTypeIcons[partner.type]} />
            </div>
            <div class="partner-card__meta">
              <span class="partner-card__type">{partnerTypeLabels[partner.type]}</span>
              <h3 class="partner-card__name">{partner.name}</h3>
            </div>
          </div>

          <div class="partner-card__location">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>{partner.location}</span>
          </div>

          <p class="partner-card__description">{partner.description}</p>

          {partner.featuredProducts && partner.featuredProducts.length > 0 && (
            <div class="partner-card__products">
              <span class="partner-card__products-label">Featured:</span>
              <div class="partner-card__products-list">
                {partner.featuredProducts.map((product) => (
                  <span class="partner-card__product-tag">{product}</span>
                ))}
              </div>
            </div>
          )}

          {partner.quote && (
            <blockquote class="partner-card__quote">
              <svg class="partner-card__quote-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
              </svg>
              <p>{partner.quote}</p>
            </blockquote>
          )}

          {partner.yearsPartnership && (
            <div class="partner-card__tenure">
              <span class="partner-card__tenure-value">{partner.yearsPartnership}</span>
              <span class="partner-card__tenure-label">{partner.yearsPartnership === 1 ? 'year' : 'years'} of partnership</span>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* =================================================================
   * PARTNERSHIP SHOWCASE SECTION - BASE STYLES
   * ================================================================= */
  .partnership-showcase {
    padding: var(--spacing-20) var(--spacing-4);
    background-color: var(--color-background);
  }

  .partnership-showcase__container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  /* =================================================================
   * HEADER STYLES
   * ================================================================= */
  .partnership-showcase__header {
    text-align: center;
    margin-bottom: var(--spacing-16);
  }

  .partnership-showcase__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--spacing-3);
  }

  .partnership-showcase__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4) 0;
    line-height: var(--line-height-tight);
  }

  .partnership-showcase__subheading {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * GRID LAYOUT
   * ================================================================= */
  .partnership-showcase__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  /* =================================================================
   * PARTNER CARD STYLES
   * ================================================================= */
  .partner-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-background-elevated);
    border-radius: var(--radius-2xl);
    padding: var(--spacing-6);
    box-shadow: var(--shadow-md);
    transition: transform var(--duration-300) var(--ease-out),
                box-shadow var(--duration-300) var(--ease-out);
    animation: fadeInCard 0.5s ease-out calc(var(--card-index) * 0.1s) backwards;
  }

  .partner-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  /* Header */
  .partner-card__header {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-4);
  }

  .partner-card__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--color-primary-100) 0%, var(--color-primary-50) 100%);
    border-radius: var(--radius-xl);
    flex-shrink: 0;
  }

  .partner-card__icon {
    display: flex;
    width: 24px;
    height: 24px;
    color: var(--color-primary);
  }

  .partner-card__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .partner-card__meta {
    flex: 1;
    min-width: 0;
  }

  .partner-card__type {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: var(--spacing-1);
  }

  .partner-card__name {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-tight);
  }

  /* Location */
  .partner-card__location {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    margin-bottom: var(--spacing-4);
  }

  .partner-card__location svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Description */
  .partner-card__description {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--spacing-4) 0;
    flex: 1;
  }

  /* Products */
  .partner-card__products {
    margin-bottom: var(--spacing-4);
  }

  .partner-card__products-label {
    display: block;
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: var(--spacing-2);
  }

  .partner-card__products-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .partner-card__product-tag {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
    background-color: var(--color-primary-50);
    padding: var(--spacing-1) var(--spacing-2);
    border-radius: var(--radius-md);
  }

  /* Quote */
  .partner-card__quote {
    position: relative;
    margin: var(--spacing-4) 0;
    padding: var(--spacing-4);
    padding-left: var(--spacing-6);
    background-color: var(--color-background-subtle);
    border-left: 3px solid var(--color-primary-200);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .partner-card__quote-icon {
    position: absolute;
    top: var(--spacing-2);
    left: var(--spacing-2);
    width: 1rem;
    height: 1rem;
    color: var(--color-primary);
    opacity: 0.3;
  }

  .partner-card__quote p {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-style: italic;
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  /* Tenure */
  .partner-card__tenure {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-2);
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .partner-card__tenure-value {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    line-height: 1;
  }

  .partner-card__tenure-label {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  /* =================================================================
   * ANIMATIONS
   * ================================================================= */
  @keyframes fadeInCard {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */
  @media (min-width: 640px) {
    .partnership-showcase__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .partnership-showcase {
      padding: var(--spacing-24) var(--spacing-6);
    }

    .partnership-showcase__heading {
      font-size: var(--font-size-4xl);
    }

    .partner-card {
      padding: var(--spacing-8);
    }
  }

  @media (min-width: 1024px) {
    .partnership-showcase__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-8);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .partner-card {
      animation: none;
    }

    .partner-card:hover {
      transform: none;
    }
  }

  /* =================================================================
   * DARK MODE SUPPORT
   * ================================================================= */
  [data-theme="dark"] .partnership-showcase {
    background-color: var(--color-background);
  }

  [data-theme="dark"] .partner-card {
    background-color: var(--color-background-elevated);
  }

  [data-theme="dark"] .partner-card__icon-wrapper {
    background: linear-gradient(135deg, var(--color-primary-900) 0%, var(--color-primary-800) 100%);
  }

  [data-theme="dark"] .partner-card__quote {
    background-color: var(--color-background-muted);
  }

  [data-theme="dark"] .partner-card__tenure {
    border-color: var(--color-border-dark);
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */
  @media print {
    .partnership-showcase {
      padding: var(--spacing-8) 0;
    }

    .partner-card {
      break-inside: avoid;
      box-shadow: none;
      border: 1px solid var(--color-border);
    }
  }
</style>

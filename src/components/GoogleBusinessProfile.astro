---
/**
 * Google Business Profile Component
 * Displays Google Business Profile information including reviews, photos,
 * Q&A, and a CTA to leave reviews. Includes review schema markup for SEO.
 *
 * Features:
 * - Star rating display with aggregate rating
 * - Featured customer reviews with author info
 * - Photo gallery from Google Business
 * - Q&A section for common questions
 * - Review CTA with gentle, encouraging messaging
 * - Full JSON-LD review schema markup
 * - WCAG 2.1 AA compliant
 * - Mobile-first responsive design
 *
 * @example Basic usage
 * ```astro
 * <GoogleBusinessProfile />
 * ```
 *
 * @example With custom options
 * ```astro
 * <GoogleBusinessProfile
 *   heading="What Our Guests Say"
 *   maxReviews={3}
 *   showPhotos={true}
 *   showReviewCTA={true}
 * />
 * ```
 */

import type { GoogleBusinessProfileProps } from '../types/google-business';
import {
  googleBusinessConfig,
  generateReviewSchemaItems,
} from '../config/google-business.config';
import ReviewCTA from './ReviewCTA.astro';

interface Props extends GoogleBusinessProfileProps {}

const {
  id = 'google-reviews',
  heading = 'What Our Guests Are Saying',
  subheading = `See why ${googleBusinessConfig.totalReviews}+ guests have rated us ${googleBusinessConfig.rating} stars on Google`,
  class: className = '',
  showPhotos = false,
  showQA = false,
  showReviewCTA = true,
  maxReviews = 4,
  maxPhotos = 4,
  variant = 'default',
} = Astro.props;

// Get data from config
const {
  rating,
  totalReviews,
  featuredReviews,
  photos,
  featuredQA,
  profileUrl,
  reviewUrl,
  businessName,
} = googleBusinessConfig;

// Limit reviews and photos to display
const displayReviews = featuredReviews.slice(0, maxReviews);
const displayPhotos = photos?.slice(0, maxPhotos) || [];
const displayQA = featuredQA || [];

// Calculate full and partial stars
const fullStars = Math.floor(rating);
const hasHalfStar = rating % 1 >= 0.5;
const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);

// Generate review schema for JSON-LD
const reviewSchemaItems = generateReviewSchemaItems();

// Build CSS classes
const sectionClasses = [
  'google-business',
  `google-business--${variant}`,
  className,
].filter(Boolean).join(' ');

// Star SVG icons
const starFull = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>`;
const starHalf = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill-opacity="0.3"/><path d="M12 17.27V2l-2.81 6.63L2 9.24l5.46 4.73L5.82 21z"/></svg>`;
const starEmpty = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill-opacity="0.3"/></svg>`;

// Google logo SVG
const googleLogo = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>`;
---

<section
  class={sectionClasses}
  id={id}
  aria-labelledby={`${id}-heading`}
  data-section="google-business"
>
  <div class="google-business__container">
    <!-- Section Header -->
    <header class="google-business__header section-heading--decorated">
      <h2 id={`${id}-heading`} class="google-business__heading">
        {heading}
      </h2>
      <p class="google-business__subheading">
        {subheading}
      </p>
    </header>

    <!-- Rating Summary -->
    <div class="google-business__summary">
      <div class="google-business__rating-card">
        <div class="google-business__google-badge">
          <span class="google-business__google-logo" set:html={googleLogo} />
          <span class="google-business__google-text">Google Reviews</span>
        </div>

        <div class="google-business__rating-display">
          <span class="google-business__rating-value">{rating.toFixed(1)}</span>
          <div class="google-business__stars" role="img" aria-label={`${rating} out of 5 stars`}>
            {Array(fullStars).fill(null).map(() => (
              <span class="google-business__star google-business__star--full" set:html={starFull} />
            ))}
            {hasHalfStar && (
              <span class="google-business__star google-business__star--half" set:html={starHalf} />
            )}
            {Array(emptyStars).fill(null).map(() => (
              <span class="google-business__star google-business__star--empty" set:html={starEmpty} />
            ))}
          </div>
        </div>

        <p class="google-business__review-count">
          Based on <strong>{totalReviews.toLocaleString()}</strong> reviews
        </p>

        <a
          href={profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="google-business__profile-link"
          aria-label={`View ${businessName} on Google Maps (opens in new tab)`}
        >
          View on Google
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 19H5V5h7V3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Featured Reviews Grid -->
    <div class="google-business__reviews" role="list" aria-label="Customer reviews">
      {displayReviews.map((review, index) => (
        <article
          class="google-business__review reveal reveal--up"
          style={`--reveal-delay: ${index * 100}ms`}
          role="listitem"
        >
          <header class="google-business__review-header">
            <div class="google-business__reviewer">
              <div class="google-business__reviewer-avatar" aria-hidden="true">
                {review.authorName.charAt(0).toUpperCase()}
              </div>
              <div class="google-business__reviewer-info">
                <span class="google-business__reviewer-name">{review.authorName}</span>
                <span class="google-business__review-date">{review.relativeTimeDescription}</span>
              </div>
            </div>
            <div class="google-business__review-rating" role="img" aria-label={`${review.rating} out of 5 stars`}>
              {Array(review.rating).fill(null).map(() => (
                <span class="google-business__star google-business__star--small" set:html={starFull} />
              ))}
            </div>
          </header>
          <blockquote class="google-business__review-text">
            <p>"{review.text}"</p>
          </blockquote>
        </article>
      ))}
    </div>

    <!-- Photos Section (Optional) -->
    {showPhotos && displayPhotos.length > 0 && (
      <div class="google-business__photos">
        <h3 class="google-business__photos-heading">Photos from Our Guests</h3>
        <div class="google-business__photos-grid" role="list">
          {displayPhotos.map((photo) => (
            <div class="google-business__photo-item" role="listitem">
              <img
                src={photo.url}
                alt={photo.alt}
                loading="lazy"
                class="google-business__photo"
              />
              {photo.attribution && (
                <span class="google-business__photo-attribution">
                  Photo by {photo.attribution}
                </span>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Q&A Section (Optional) -->
    {showQA && displayQA.length > 0 && (
      <div class="google-business__qa">
        <h3 class="google-business__qa-heading">Common Questions</h3>
        <div class="google-business__qa-list">
          {displayQA.map((qa) => (
            <div class="google-business__qa-item">
              <h4 class="google-business__question">
                <span class="google-business__qa-icon" aria-hidden="true">Q</span>
                {qa.question}
              </h4>
              <p class="google-business__answer">
                <span class="google-business__qa-icon google-business__qa-icon--answer" aria-hidden="true">A</span>
                {qa.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Review CTA -->
    {showReviewCTA && (
      <ReviewCTA
        heading="Enjoyed Your Visit?"
        description="We'd love to hear about your experience! Your review helps other food lovers discover us and helps us continue improving."
        buttonText="Leave a Review on Google"
        reviewUrl={reviewUrl}
        variant="card"
      />
    )}
  </div>
</section>

<!-- JSON-LD Review Schema for SEO -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: businessName,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: rating,
    bestRating: 5,
    worstRating: 1,
    ratingCount: totalReviews,
    reviewCount: totalReviews,
  },
  review: reviewSchemaItems,
})} />

<style>
  /* =================================================================
   * GOOGLE BUSINESS PROFILE COMPONENT STYLES
   * =================================================================
   * Mobile-first responsive design with BEM naming convention
   */

  .google-business {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background);
  }

  .google-business__container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  /* =================================================================
   * HEADER STYLES
   * =================================================================
   */

  .google-business__header {
    text-align: center;
    margin-bottom: var(--spacing-10);
  }

  .google-business__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-3) 0;
  }

  .google-business__subheading {
    font-family: var(--font-body);
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 50ch;
    margin-inline: auto;
  }

  /* =================================================================
   * RATING SUMMARY CARD
   * =================================================================
   */

  .google-business__summary {
    display: flex;
    justify-content: center;
    margin-bottom: var(--spacing-10);
  }

  .google-business__rating-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-6);
    background: var(--color-background-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-md);
    text-align: center;
    max-width: 320px;
    width: 100%;
  }

  .google-business__google-badge {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-4);
    padding: var(--spacing-2) var(--spacing-4);
    background: var(--color-background);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }

  .google-business__google-logo {
    display: flex;
    width: 20px;
    height: 20px;
  }

  .google-business__google-logo :global(svg) {
    width: 100%;
    height: 100%;
  }

  .google-business__google-text {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }

  .google-business__rating-display {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-3);
  }

  .google-business__rating-value {
    font-family: var(--font-heading);
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1;
  }

  .google-business__stars {
    display: flex;
    gap: var(--spacing-1);
  }

  .google-business__star {
    display: flex;
    width: 24px;
    height: 24px;
    color: #FBBC05; /* Google yellow */
  }

  .google-business__star :global(svg) {
    width: 100%;
    height: 100%;
  }

  .google-business__star--small {
    width: 16px;
    height: 16px;
  }

  .google-business__review-count {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--spacing-4) 0;
  }

  .google-business__profile-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--duration-150) var(--ease-in-out);
  }

  .google-business__profile-link:hover {
    color: var(--color-primary-600);
    text-decoration: underline;
  }

  .google-business__profile-link svg {
    width: 16px;
    height: 16px;
  }

  /* =================================================================
   * REVIEWS GRID
   * =================================================================
   */

  .google-business__reviews {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-10);
  }

  .google-business__review {
    padding: var(--spacing-6);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--duration-300) var(--ease-out),
      box-shadow var(--duration-300) var(--ease-out);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .google-business__review:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .google-business__review-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--spacing-4);
    gap: var(--spacing-3);
  }

  .google-business__reviewer {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
  }

  .google-business__reviewer-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .google-business__reviewer-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-0-5);
  }

  .google-business__reviewer-name {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .google-business__review-date {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
  }

  .google-business__review-rating {
    display: flex;
    gap: 2px;
    flex-shrink: 0;
  }

  .google-business__review-text {
    margin: 0;
    border: none;
    padding: 0;
  }

  .google-business__review-text p {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    font-style: italic;
    margin: 0;
  }

  /* =================================================================
   * PHOTOS SECTION
   * =================================================================
   */

  .google-business__photos {
    margin-bottom: var(--spacing-10);
  }

  .google-business__photos-heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    text-align: center;
    margin: 0 0 var(--spacing-6) 0;
  }

  .google-business__photos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-4);
  }

  .google-business__photo-item {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .google-business__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-300) var(--ease-out);
  }

  .google-business__photo-item:hover .google-business__photo {
    transform: scale(1.05);
  }

  .google-business__photo-attribution {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--spacing-2);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    font-size: var(--font-size-xs);
    color: white;
    text-align: center;
  }

  /* =================================================================
   * Q&A SECTION
   * =================================================================
   */

  .google-business__qa {
    margin-bottom: var(--spacing-10);
  }

  .google-business__qa-heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    text-align: center;
    margin: 0 0 var(--spacing-6) 0;
  }

  .google-business__qa-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
    max-width: 800px;
    margin: 0 auto;
  }

  .google-business__qa-item {
    padding: var(--spacing-5);
    background: var(--color-background-subtle);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .google-business__question {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-3);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-3) 0;
  }

  .google-business__answer {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-3);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin: 0;
    padding-left: var(--spacing-8);
  }

  .google-business__qa-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    border-radius: var(--radius-base);
    flex-shrink: 0;
  }

  .google-business__qa-icon--answer {
    background: var(--color-accent);
  }

  /* =================================================================
   * RESPONSIVE STYLES - Tablet (640px+)
   * =================================================================
   */

  @media screen and (min-width: 640px) {
    .google-business {
      padding: var(--spacing-20) var(--spacing-6);
    }

    .google-business__heading {
      font-size: var(--font-size-4xl);
    }

    .google-business__reviews {
      grid-template-columns: repeat(2, 1fr);
    }

    .google-business__photos-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* =================================================================
   * RESPONSIVE STYLES - Desktop (1024px+)
   * =================================================================
   */

  @media screen and (min-width: 1024px) {
    .google-business {
      padding: var(--spacing-24) var(--spacing-8);
    }

    .google-business__header {
      margin-bottom: var(--spacing-12);
    }

    .google-business__heading {
      font-size: var(--font-size-5xl);
    }

    .google-business__subheading {
      font-size: var(--font-size-lg);
    }

    .google-business__summary {
      margin-bottom: var(--spacing-12);
    }

    .google-business__rating-card {
      padding: var(--spacing-8);
      max-width: 380px;
    }

    .google-business__star {
      width: 28px;
      height: 28px;
    }

    .google-business__reviews {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-8);
      margin-bottom: var(--spacing-12);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * =================================================================
   */

  @media (prefers-reduced-motion: reduce) {
    .google-business__review {
      transition: none;
    }

    .google-business__review:hover {
      transform: none;
    }

    .google-business__photo {
      transition: none;
    }

    .google-business__photo-item:hover .google-business__photo {
      transform: none;
    }
  }

  /* =================================================================
   * DARK MODE ADJUSTMENTS
   * =================================================================
   */

  :global(html[data-theme="dark"]) .google-business__rating-card {
    background: var(--color-background-elevated);
  }

  :global(html[data-theme="dark"]) .google-business__review {
    background: var(--color-background-elevated);
  }

  :global(html[data-theme="dark"]) .google-business__qa-item {
    background: var(--color-background-elevated);
  }

  /* =================================================================
   * PRINT STYLES
   * =================================================================
   */

  @media print {
    .google-business {
      padding: var(--spacing-8) 0;
      background: transparent;
    }

    .google-business__rating-card {
      box-shadow: none;
      border: 1px solid var(--color-border);
    }

    .google-business__review {
      box-shadow: none;
      page-break-inside: avoid;
    }

    .google-business__photos {
      display: none;
    }
  }
</style>

---
/**
 * Specials Showcase Component
 *
 * A responsive component for showcasing rotating specials with large photos,
 * limited-time badges, and day-specific offerings.
 *
 * Features:
 * - Carousel, grid, and featured layout modes
 * - Auto-rotation with pause on hover/focus
 * - Limited-time and day-specific badge system
 * - Discount price display with strikethrough
 * - Keyboard navigation (Arrow keys, Escape)
 * - Touch swipe gestures for mobile
 * - WCAG 2.1 AA compliant
 * - Responsive design for all screen sizes
 * - Print-friendly styling
 *
 * @example Basic carousel usage
 * ```astro
 * <SpecialsShowcase
 *   specials={SPECIALS}
 *   config={{ layout: 'carousel', autoRotateInterval: 5000 }}
 * />
 * ```
 *
 * @example Grid layout with today's specials
 * ```astro
 * <SpecialsShowcase
 *   specials={getTodaysSpecials()}
 *   config={{ layout: 'grid', showBadges: true }}
 * />
 * ```
 */

import type {
  Special,
  SpecialsShowcaseConfig,
  SpecialsShowcaseProps,
} from '../types/specials-showcase';
import { getBadgeStyle } from '../types/specials-showcase';
import { DEFAULT_SHOWCASE_CONFIG } from '../config/specials-showcase.config';
import FoodImage from './FoodImage.astro';

interface Props extends SpecialsShowcaseProps {}

const {
  specials,
  config: userConfig = {},
  class: className = '',
  testId = 'specials-showcase',
} = Astro.props;

// Merge user config with defaults
const config: SpecialsShowcaseConfig = {
  ...DEFAULT_SHOWCASE_CONFIG,
  ...userConfig,
};

// Filter and limit specials
let displaySpecials = specials.filter(s => s.active);
if (config.maxItems > 0) {
  displaySpecials = displaySpecials.slice(0, config.maxItems);
}

// Generate unique ID for this instance
const instanceId = `specials-${Math.random().toString(36).substr(2, 9)}`;

// Determine grid columns based on special count
const gridColumns = Math.min(displaySpecials.length, 3);
---

<section
  class:list={['specials-showcase', `layout-${config.layout}`, className]}
  data-testid={testId}
  data-instance-id={instanceId}
  data-auto-rotate={config.autoRotateInterval}
  data-layout={config.layout}
  aria-label="Special offers showcase"
>
  {/* Section Header */}
  {(config.heading || config.subheading) && (
    <header class="specials-showcase__header">
      {config.heading && (
        <h2 class="specials-showcase__heading">{config.heading}</h2>
      )}
      {config.subheading && (
        <p class="specials-showcase__subheading">{config.subheading}</p>
      )}
    </header>
  )}

  {/* Carousel Layout */}
  {config.layout === 'carousel' && (
    <div class="specials-carousel" role="region" aria-roledescription="carousel" aria-label="Special offers">
      {/* Previous Button */}
      {config.showArrows && displaySpecials.length > 1 && (
        <button
          type="button"
          class="carousel-nav carousel-nav--prev"
          aria-label="Previous special"
          data-testid="carousel-prev"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      )}

      {/* Carousel Track */}
      <div class="carousel-track" role="group" aria-live="polite">
        {displaySpecials.map((special, index) => (
          <article
            class:list={['special-card', 'carousel-slide', { 'is-active': index === 0 }]}
            data-index={index}
            data-testid={`special-card-${special.id}`}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${displaySpecials.length}: ${special.title}`}
            aria-hidden={index !== 0 ? 'true' : 'false'}
          >
            {/* Image */}
            <div class="special-card__image-container">
              <FoodImage
                src={special.image.src}
                alt={special.image.alt}
                width={special.image.width}
                height={special.image.height}
                preset="hero"
                placeholder={true}
                aspectRatio="16 / 9"
                borderRadius="12px"
              />
              {/* Badge */}
              {config.showBadges && special.badge && (
                <div
                  class:list={['special-badge', `special-badge--${special.badge.type}`]}
                  data-testid={`badge-${special.badge.type}`}
                >
                  {special.badge.icon && (
                    <span class="special-badge__icon" aria-hidden="true">{special.badge.icon}</span>
                  )}
                  <span class="special-badge__text">{special.badge.text}</span>
                </div>
              )}
            </div>

            {/* Content */}
            <div class="special-card__content">
              <h3 class="special-card__title">{special.title}</h3>
              <p class="special-card__description">{special.description}</p>

              {/* Time/Day availability */}
              {(special.timeAvailable || (special.daysAvailable && special.daysAvailable.length > 0)) && (
                <div class="special-card__availability">
                  {special.daysAvailable && special.daysAvailable.length > 0 && special.daysAvailable.length < 7 && (
                    <span class="special-card__days">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                      {special.daysAvailable.join(', ')}
                    </span>
                  )}
                  {special.timeAvailable && (
                    <span class="special-card__time">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      {special.timeAvailable}
                    </span>
                  )}
                </div>
              )}

              {/* Price */}
              {config.showPrices && special.price && (
                <div class="special-card__price">
                  {special.price.originalDisplay && (
                    <span class="special-card__price-original">
                      <span class="sr-only">Original price:</span>
                      {special.price.originalDisplay}
                    </span>
                  )}
                  <span class="special-card__price-current">
                    <span class="sr-only">Special price:</span>
                    {special.price.display}
                  </span>
                  {special.price.discountPercent && (
                    <span class="special-card__discount">
                      Save {special.price.discountPercent}%
                    </span>
                  )}
                </div>
              )}

              {/* CTA Link */}
              {special.link && (
                <a href={special.link} class="special-card__cta">
                  {special.linkText || 'Learn More'}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>

      {/* Next Button */}
      {config.showArrows && displaySpecials.length > 1 && (
        <button
          type="button"
          class="carousel-nav carousel-nav--next"
          aria-label="Next special"
          data-testid="carousel-next"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      )}

      {/* Dot Indicators */}
      {config.showIndicators && displaySpecials.length > 1 && (
        <div class="carousel-indicators" role="tablist" aria-label="Slide indicators">
          {displaySpecials.map((special, index) => (
            <button
              type="button"
              class:list={['carousel-dot', { 'is-active': index === 0 }]}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-label={`Go to slide ${index + 1}: ${special.title}`}
              data-index={index}
              data-testid={`carousel-dot-${index}`}
            />
          ))}
        </div>
      )}
    </div>
  )}

  {/* Grid Layout */}
  {config.layout === 'grid' && (
    <div
      class="specials-grid"
      style={`--grid-columns: ${gridColumns}`}
      role="list"
      aria-label="Special offers"
    >
      {displaySpecials.map((special, index) => (
        <article
          class="special-card special-card--grid"
          data-testid={`special-card-${special.id}`}
          role="listitem"
        >
          {/* Image */}
          <div class="special-card__image-container">
            <FoodImage
              src={special.image.src}
              alt={special.image.alt}
              width={special.image.width}
              height={special.image.height}
              preset="foodPhoto"
              placeholder={true}
              aspectRatio="4 / 3"
              borderRadius="12px 12px 0 0"
            />
            {/* Badge */}
            {config.showBadges && special.badge && (
              <div class:list={['special-badge', `special-badge--${special.badge.type}`]}>
                {special.badge.icon && (
                  <span class="special-badge__icon" aria-hidden="true">{special.badge.icon}</span>
                )}
                <span class="special-badge__text">{special.badge.text}</span>
              </div>
            )}
          </div>

          {/* Content */}
          <div class="special-card__content">
            <h3 class="special-card__title">{special.title}</h3>
            <p class="special-card__description">{special.description}</p>

            {/* Availability */}
            {(special.timeAvailable || (special.daysAvailable && special.daysAvailable.length > 0 && special.daysAvailable.length < 7)) && (
              <div class="special-card__availability">
                {special.daysAvailable && special.daysAvailable.length > 0 && special.daysAvailable.length < 7 && (
                  <span class="special-card__days">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    {special.daysAvailable.join(', ')}
                  </span>
                )}
                {special.timeAvailable && (
                  <span class="special-card__time">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    {special.timeAvailable}
                  </span>
                )}
              </div>
            )}

            {/* Price */}
            {config.showPrices && special.price && (
              <div class="special-card__price">
                {special.price.originalDisplay && (
                  <span class="special-card__price-original">{special.price.originalDisplay}</span>
                )}
                <span class="special-card__price-current">{special.price.display}</span>
                {special.price.discountPercent && (
                  <span class="special-card__discount">Save {special.price.discountPercent}%</span>
                )}
              </div>
            )}

            {/* CTA */}
            {special.link && (
              <a href={special.link} class="special-card__cta">
                {special.linkText || 'Learn More'}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  )}

  {/* Featured Layout - Single large card */}
  {config.layout === 'featured' && displaySpecials.length > 0 && (
    <article
      class="special-featured"
      data-testid={`special-featured-${displaySpecials[0].id}`}
    >
      <div class="special-featured__image">
        <FoodImage
          src={displaySpecials[0].image.src}
          alt={displaySpecials[0].image.alt}
          width={displaySpecials[0].image.width}
          height={displaySpecials[0].image.height}
          preset="hero"
          placeholder={true}
          aspectRatio="21 / 9"
          borderRadius="16px"
        />
        {config.showBadges && displaySpecials[0].badge && (
          <div class:list={['special-badge', 'special-badge--large', `special-badge--${displaySpecials[0].badge.type}`]}>
            {displaySpecials[0].badge.icon && (
              <span class="special-badge__icon" aria-hidden="true">{displaySpecials[0].badge.icon}</span>
            )}
            <span class="special-badge__text">{displaySpecials[0].badge.text}</span>
          </div>
        )}
      </div>
      <div class="special-featured__content">
        <h3 class="special-featured__title">{displaySpecials[0].title}</h3>
        <p class="special-featured__description">
          {displaySpecials[0].longDescription || displaySpecials[0].description}
        </p>

        {/* Availability */}
        {(displaySpecials[0].timeAvailable || (displaySpecials[0].daysAvailable && displaySpecials[0].daysAvailable.length > 0)) && (
          <div class="special-featured__availability">
            {displaySpecials[0].daysAvailable && displaySpecials[0].daysAvailable.length > 0 && displaySpecials[0].daysAvailable.length < 7 && (
              <span class="special-featured__days">
                {displaySpecials[0].daysAvailable.join(' | ')}
              </span>
            )}
            {displaySpecials[0].timeAvailable && (
              <span class="special-featured__time">{displaySpecials[0].timeAvailable}</span>
            )}
          </div>
        )}

        <div class="special-featured__footer">
          {config.showPrices && displaySpecials[0].price && (
            <div class="special-featured__price">
              {displaySpecials[0].price.originalDisplay && (
                <span class="special-featured__price-original">{displaySpecials[0].price.originalDisplay}</span>
              )}
              <span class="special-featured__price-current">{displaySpecials[0].price.display}</span>
            </div>
          )}
          {displaySpecials[0].link && (
            <a href={displaySpecials[0].link} class="special-featured__cta">
              {displaySpecials[0].linkText || 'Learn More'}
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          )}
        </div>
      </div>
    </article>
  )}

  {/* Empty State */}
  {displaySpecials.length === 0 && (
    <div class="specials-empty" data-testid="specials-empty">
      <p>No specials available at the moment. Check back soon!</p>
    </div>
  )}
</section>

<style>
  /* =================================================================
   * BASE STYLES
   * ================================================================= */
  .specials-showcase {
    width: 100%;
    padding: var(--spacing-8) 0;
  }

  /* =================================================================
   * HEADER STYLES
   * ================================================================= */
  .specials-showcase__header {
    text-align: center;
    margin-bottom: var(--spacing-8);
  }

  .specials-showcase__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-2);
    line-height: var(--line-height-tight);
  }

  .specials-showcase__subheading {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* =================================================================
   * CAROUSEL LAYOUT
   * ================================================================= */
  .specials-carousel {
    position: relative;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    transition: transform var(--duration-500) var(--ease-in-out);
  }

  .carousel-slide {
    flex: 0 0 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-300) var(--ease-in-out), visibility var(--duration-300);
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
  }

  .carousel-slide.is-active {
    opacity: 1;
    visibility: visible;
    position: relative;
  }

  /* Navigation Arrows */
  .carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-elevated);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-full);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: all var(--duration-200) var(--ease-in-out);
    box-shadow: var(--shadow-md);
  }

  .carousel-nav:hover {
    background: var(--color-primary);
    color: var(--color-text-inverse);
    border-color: var(--color-primary);
  }

  .carousel-nav:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .carousel-nav--prev {
    left: var(--spacing-4);
  }

  .carousel-nav--next {
    right: var(--spacing-4);
  }

  /* Dot Indicators */
  .carousel-indicators {
    display: flex;
    justify-content: center;
    gap: var(--spacing-2);
    margin-top: var(--spacing-6);
  }

  .carousel-dot {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    background: var(--color-border-dark);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all var(--duration-200) var(--ease-in-out);
  }

  .carousel-dot:hover {
    background: var(--color-primary-light);
  }

  .carousel-dot.is-active {
    background: var(--color-primary);
    width: 24px;
  }

  .carousel-dot:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* =================================================================
   * SPECIAL CARD STYLES
   * ================================================================= */
  .special-card {
    background: var(--color-background-elevated);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--duration-300) var(--ease-in-out), box-shadow var(--duration-300);
  }

  .special-card:hover {
    box-shadow: var(--shadow-lg);
  }

  /* Carousel card layout */
  .carousel-slide.special-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-6);
    padding: var(--spacing-6);
    align-items: center;
  }

  .special-card__image-container {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .special-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .special-card__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-tight);
  }

  .special-card__description {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--line-height-relaxed);
  }

  /* Availability */
  .special-card__availability {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  .special-card__days,
  .special-card__time {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
  }

  .special-card__days svg,
  .special-card__time svg {
    color: var(--color-primary);
  }

  /* Price */
  .special-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-2);
    margin-top: var(--spacing-2);
  }

  .special-card__price-original {
    font-size: var(--font-size-base);
    color: var(--color-text-disabled);
    text-decoration: line-through;
  }

  .special-card__price-current {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .special-card__discount {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-success-text);
    background: var(--color-success-light);
    padding: var(--spacing-0-5) var(--spacing-2);
    border-radius: var(--radius-full);
  }

  /* CTA Button */
  .special-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-3) var(--spacing-5);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-base);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--duration-200) var(--ease-in-out);
    margin-top: var(--spacing-2);
    width: fit-content;
  }

  .special-card__cta:hover {
    background: var(--color-primary-dark);
    transform: translateX(4px);
  }

  .special-card__cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* =================================================================
   * BADGE STYLES
   * ================================================================= */
  .special-badge {
    position: absolute;
    top: var(--spacing-3);
    left: var(--spacing-3);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    z-index: 5;
    box-shadow: var(--shadow-sm);
  }

  .special-badge--large {
    padding: var(--spacing-2) var(--spacing-4);
    font-size: var(--font-size-base);
  }

  .special-badge__icon {
    font-size: 1.1em;
  }

  /* Badge Types */
  .special-badge--limited-time {
    background: var(--color-error-light);
    color: var(--color-error-text);
    border: 1px solid var(--color-error-border);
  }

  .special-badge--daily {
    background: var(--color-primary-100);
    color: var(--color-primary-700);
    border: 1px solid var(--color-primary-200);
  }

  .special-badge--weekend {
    background: var(--color-accent-subtle);
    color: var(--color-accent-dark);
    border: 1px solid var(--color-accent);
  }

  .special-badge--seasonal {
    background: var(--color-warning-light);
    color: var(--color-warning-text);
    border: 1px solid var(--color-warning-border);
  }

  .special-badge--new {

  /* =================================================================
   * HIGH CONTRAST MODE
   * ================================================================= */
  @media (forced-colors: active) {
    .special-card,
    .special-badge,
    .carousel-nav,
    .carousel-dot {
      border: 2px solid currentColor;
    }

    .carousel-dot.is-active {

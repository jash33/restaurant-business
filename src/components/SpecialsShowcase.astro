    border: 1px solid var(--color-primary-200);
  }

  /* =================================================================
   * GRID LAYOUT
   * ================================================================= */
  .specials-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns, 3), 1fr);
    gap: var(--spacing-6);
  }

  .special-card--grid {

    transform: translateX(4px);
  }

  /* =================================================================
   * EMPTY STATE
   * ================================================================= */
  .specials-empty {
    text-align: center;
    padding: var(--spacing-12) var(--spacing-6);
    color: var(--color-text-secondary);
    background: var(--color-background-muted);
    border-radius: var(--radius-xl);
  }

  /* =================================================================
   * ACCESSIBILITY
   * ================================================================= */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */
  @media (max-width: 1024px) {
    .carousel-slide.special-card {
      grid-template-columns: 1fr;
      padding: var(--spacing-4);
    }

    .specials-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .carousel-nav {
      width: 40px;
      height: 40px;
    }

    .carousel-nav--prev {
      left: var(--spacing-2);
    }

    .carousel-nav--next {
      right: var(--spacing-2);
    }
  }

  @media (max-width: 640px) {
    .specials-showcase__heading {
      font-size: var(--font-size-2xl);
    }

    .specials-showcase__subheading {
      font-size: var(--font-size-base);
    }

    .specials-grid {
      grid-template-columns: 1fr;
    }

    .carousel-nav {
      display: none;
    }

    .special-card__title {
      font-size: var(--font-size-xl);
    }

    .special-card__price-current {
      font-size: var(--font-size-xl);
    }

    .special-featured__title {
      font-size: var(--font-size-2xl);
    }

    .special-featured__content {
      padding: var(--spacing-5);
    }

    .special-featured__price-current {
      font-size: var(--font-size-2xl);
    }

    .special-featured__cta {
      width: 100%;
      justify-content: center;
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .carousel-track,
    .carousel-slide,
    .special-card,
    .carousel-nav,
    .carousel-dot,
    .special-card__cta,
    .special-featured__cta {
      transition: none;
    }

    .special-card:hover,
    .special-card__cta:hover,
    .special-featured__cta:hover {
      transform: none;
    }
  }

  /* =================================================================
   * DARK MODE
   * ================================================================= */
  @media (prefers-color-scheme: dark) {
    .special-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .carousel-nav {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .carousel-dot {
      background: rgba(255, 255, 255, 0.3);
    }

    .carousel-dot.is-active {
      background: var(--color-primary-light);
    }

    .specials-empty {
      background: rgba(255, 255, 255, 0.05);
    }

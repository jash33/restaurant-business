<script>
  /**
   * Sample Menus Tab Navigation
   * Handles keyboard navigation and tab switching for the sample menus section
   */
  function initMenuTabs() {
    const tabList = document.querySelector('.sample-menus__tabs');
    const tabs = tabList?.querySelectorAll('.sample-menus__tab') as NodeListOf<HTMLButtonElement>;
    const panels = document.querySelectorAll('.sample-menus__panel');

    if (!tabList || !tabs.length || !panels.length) return;

    /**
     * Switch to a specific tab
     */
    function switchTab(newTab: HTMLButtonElement) {
      // Deactivate all tabs
      tabs.forEach(tab => {
        tab.classList.remove('sample-menus__tab--active');
        tab.setAttribute('aria-selected', 'false');
        tab.setAttribute('tabindex', '-1');
      });

      // Hide all panels
      panels.forEach(panel => {
        panel.classList.remove('sample-menus__panel--active');
        panel.setAttribute('hidden', '');
      });

      // Activate new tab
      newTab.classList.add('sample-menus__tab--active');
      newTab.setAttribute('aria-selected', 'true');
      newTab.setAttribute('tabindex', '0');
      newTab.focus();

      // Show corresponding panel
      const panelId = newTab.getAttribute('aria-controls');
      const panel = document.getElementById(panelId || '');
      if (panel) {
        panel.classList.add('sample-menus__panel--active');
        panel.removeAttribute('hidden');
      }
    }

    // Tab click handlers
    tabs.forEach(tab => {
      tab.addEventListener('click', () => switchTab(tab));
    });

    // Keyboard navigation
    tabList.addEventListener('keydown', (e) => {
      const currentTab = document.activeElement as HTMLButtonElement;
      const tabsArray = Array.from(tabs);
      const currentIndex = tabsArray.indexOf(currentTab);

      let newIndex: number | null = null;

      switch (e.key) {
        case 'ArrowLeft':
          newIndex = currentIndex - 1;
          if (newIndex < 0) newIndex = tabsArray.length - 1;
          break;
        case 'ArrowRight':
          newIndex = currentIndex + 1;
          if (newIndex >= tabsArray.length) newIndex = 0;
          break;
        case 'Home':
          newIndex = 0;
          break;
        case 'End':
          newIndex = tabsArray.length - 1;
          break;
      }

      if (newIndex !== null) {
        e.preventDefault();
        switchTab(tabsArray[newIndex]);
      }
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMenuTabs);
  } else {
    initMenuTabs();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initMenuTabs);
</script>

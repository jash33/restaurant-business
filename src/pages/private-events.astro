---
/**
 * Private Events Page - The Main Street Bistro
 * A dedicated page showcasing private event spaces, packages, sample menus,
 * and an inquiry form for weddings, corporate events, and parties.
 *
 * Features:
 * - Hero section with compelling messaging
 * - Venue spaces showcase with photos and capacity info
 * - Package pricing with feature comparison
 * - Sample menus for each package
 * - FAQ section
 * - Private event inquiry form
 * - Full SEO optimization with structured data
 * - WCAG 2.1 AA accessible
 */

import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PricingCard from '../components/PricingCard.astro';
import PrivateEventInquiryForm from '../components/PrivateEventInquiryForm.astro';

import {
  PRIVATE_EVENTS_CONFIG,
  VENUE_SPACES,
  EVENT_PACKAGES,
  SAMPLE_MENUS,
  PRIVATE_EVENT_FAQS,
} from '../config/private-events.config';

const { hero } = PRIVATE_EVENTS_CONFIG;

// Event types for showcasing versatility
const eventTypes = [
  {
    icon: 'rings',
    title: 'Weddings',
    description: 'From intimate ceremonies to grand receptions, create unforgettable moments.',
  },
  {
    icon: 'briefcase',
    title: 'Corporate Events',
    description: 'Professional settings for meetings, team celebrations, and client entertainment.',
  },
  {
    icon: 'balloon',
    title: 'Private Parties',
    description: 'Birthdays, anniversaries, graduations, and milestone celebrations.',
  },
];

// Stats to showcase venue capabilities
const venueStats = [
  { number: '4', label: 'Unique Spaces' },
  { number: '200+', label: 'Max Capacity' },
  { number: '500+', label: 'Events Hosted' },
  { number: '100%', label: 'Satisfaction' },
];
---

<Layout
  title="Private Events"
  description="Host your wedding, corporate event, or private party at The Main Street Bistro. Explore our versatile venue spaces, custom packages, and sample menus. Request a quote today."
  openGraph={{
    type: 'website',
  }}
  jsonLd={{
    type: 'WebPage',
    name: 'Private Events at The Main Street Bistro',
    description: 'Host your special occasion at our versatile venue. We offer custom packages for weddings, corporate events, and private parties with dedicated event coordination.',
  }}
>
  <main>
    <!-- Hero Section -->
    <section class="private-events-hero" aria-labelledby="private-events-hero-heading">
      <div class="private-events-hero__container">
        <span class="private-events-hero__eyebrow reveal reveal--up">{hero.eyebrow}</span>
        <h1 id="private-events-hero-heading" class="private-events-hero__title reveal reveal--up reveal--delay-1">
          {hero.headline}
        </h1>
        <p class="private-events-hero__subtitle reveal reveal--up reveal--delay-2">
          {hero.subheadline}
        </p>
        <div class="private-events-hero__cta reveal reveal--up reveal--delay-3">
          <Button
            text="Request a Quote"
            href="#inquiry-form"
            variant="primary"
            size="large"
          />
          <Button
            text="View Packages"
            href="#packages"
            variant="secondary"
            size="large"
          />
        </div>
      </div>
    </section>

    <!-- Event Types Section -->
    <section class="event-types" aria-labelledby="event-types-heading">
      <div class="event-types__container">
        <h2 id="event-types-heading" class="sr-only">Events We Host</h2>
        <div class="event-types__grid">
          {eventTypes.map((type, index) => (
            <div class={`event-types__card reveal reveal--up reveal--delay-${index + 1}`}>
              <div class="event-types__icon" aria-hidden="true">
                {type.icon === 'rings' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="8" cy="12" r="5" />
                    <circle cx="16" cy="12" r="5" />
                  </svg>
                )}
                {type.icon === 'briefcase' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                  </svg>
                )}
                {type.icon === 'balloon' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 3.17 2.08 5.85 5 6.71V21l2 2 2-2v-5.29c2.92-.86 5-3.54 5-6.71 0-3.87-3.13-7-7-7z" />
                  </svg>
                )}
              </div>
              <h3 class="event-types__title">{type.title}</h3>
              <p class="event-types__description">{type.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Venue Stats Section -->
    <section class="venue-stats" aria-labelledby="venue-stats-heading">
      <div class="venue-stats__container">
        <h2 id="venue-stats-heading" class="sr-only">Our Venue at a Glance</h2>
        <div class="venue-stats__grid">
          {venueStats.map((stat, index) => (
            <div class={`venue-stats__item reveal reveal--scale-up reveal--delay-${index + 1}`}>
              <span class="venue-stats__number">{stat.number}</span>
              <span class="venue-stats__label">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Venue Spaces Section -->
    <section class="venue-spaces" id="spaces" aria-labelledby="venue-spaces-heading">
      <div class="venue-spaces__container">
        <div class="venue-spaces__header">
          <span class="venue-spaces__eyebrow reveal reveal--up">Our Spaces</span>
          <h2 id="venue-spaces-heading" class="venue-spaces__title reveal reveal--up reveal--delay-1">
            Versatile Venues for Every Occasion
          </h2>
          <p class="venue-spaces__subtitle reveal reveal--up reveal--delay-2">
            From intimate gatherings to grand celebrations, we have the perfect space for your event.
          </p>
        </div>

        <div class="venue-spaces__grid">
          {VENUE_SPACES.map((space, index) => (
            <article class={`venue-space-card reveal reveal--up reveal--delay-${(index % 2) + 1}`}>
              <div class="venue-space-card__image">
                {space.imageSrc ? (
                  <img
                    src={space.imageSrc}
                    alt={space.imageAlt}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="venue-space-card__placeholder" role="img" aria-label={space.imageAlt}>
                    <svg viewBox="0 0 200 150" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect width="200" height="150" fill="currentColor" opacity="0.08"/>
                      <rect x="30" y="50" width="40" height="60" rx="2" fill="currentColor" opacity="0.12"/>
                      <rect x="80" y="40" width="50" height="70" rx="2" fill="currentColor" opacity="0.15"/>
                      <rect x="140" y="55" width="35" height="55" rx="2" fill="currentColor" opacity="0.1"/>
                      <circle cx="100" cy="30" r="15" fill="currentColor" opacity="0.1"/>
                    </svg>
                  </div>
                )}
                <div class="venue-space-card__badge">
                  <span>{space.capacity.min}-{space.capacity.max} Guests</span>
                </div>
              </div>
              <div class="venue-space-card__content">
                <h3 class="venue-space-card__name">{space.name}</h3>
                <p class="venue-space-card__description">{space.description}</p>

                <div class="venue-space-card__details">
                  <div class="venue-space-card__capacity">
                    <span class="venue-space-card__detail-label">Capacity</span>
                    <span class="venue-space-card__detail-value">
                      {space.capacity.seated && `${space.capacity.seated} seated`}
                      {space.capacity.seated && space.capacity.standing && ' / '}
                      {space.capacity.standing && `${space.capacity.standing} standing`}
                      {!space.capacity.seated && !space.capacity.standing && `${space.capacity.min}-${space.capacity.max} guests`}
                    </span>
                  </div>
                  <div class="venue-space-card__sqft">
                    <span class="venue-space-card__detail-label">Size</span>
                    <span class="venue-space-card__detail-value">{space.squareFeet.toLocaleString()} sq ft</span>
                  </div>
                </div>

                <div class="venue-space-card__amenities">
                  <span class="venue-space-card__amenities-label">Amenities:</span>
                  <ul class="venue-space-card__amenities-list">
                    {space.amenities.slice(0, 4).map((amenity) => (
                      <li>{amenity}</li>
                    ))}
                    {space.amenities.length > 4 && (
                      <li class="venue-space-card__amenities-more">+{space.amenities.length - 4} more</li>
                    )}
                  </ul>
                </div>

                <div class="venue-space-card__ideal-for">
                  <span class="venue-space-card__ideal-label">Ideal for:</span>
                  <p class="venue-space-card__ideal-list">{space.idealFor.join(' • ')}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Packages Section -->
    <section class="packages" id="packages" aria-labelledby="packages-heading">
      <div class="packages__container">
        <div class="packages__header">
          <span class="packages__eyebrow reveal reveal--up">Packages</span>
          <h2 id="packages-heading" class="packages__title reveal reveal--up reveal--delay-1">
            Event Packages to Fit Your Needs
          </h2>
          <p class="packages__subtitle reveal reveal--up reveal--delay-2">
            From casual gatherings to elegant affairs, choose the package that matches your vision.
          </p>
        </div>

        <div class="packages__grid">
          {EVENT_PACKAGES.map((pkg, index) => (
            <div class={`reveal reveal--up reveal--delay-${index + 1}`}>
              <PricingCard
                id={pkg.id}
                name={pkg.name}
                price={pkg.price}
                priceNote={pkg.priceNote}
                description={pkg.description}
                features={pkg.includes}
                excludedFeatures={pkg.excludes}
                cta={{
                  text: pkg.id === 'custom' ? 'Contact Us' : 'Request Quote',
                  href: '#inquiry-form',
                }}
                isPopular={pkg.isPopular}
                popularLabel={pkg.popularLabel}
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Sample Menus Section -->
    <section class="sample-menus" id="menus" aria-labelledby="sample-menus-heading">
      <div class="sample-menus__container">
        <div class="sample-menus__header">
          <span class="sample-menus__eyebrow reveal reveal--up">Sample Menus</span>
          <h2 id="sample-menus-heading" class="sample-menus__title reveal reveal--up reveal--delay-1">
            Culinary Excellence for Your Event
          </h2>
          <p class="sample-menus__subtitle reveal reveal--up reveal--delay-2">
            Preview our carefully crafted menus. All menus can be customized to your preferences.
          </p>
        </div>

        <div class="sample-menus__tabs" role="tablist" aria-label="Sample menus by package">
          {SAMPLE_MENUS.map((menu, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${menu.packageId}`}
              aria-controls={`panel-${menu.packageId}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              class={`sample-menus__tab ${index === 0 ? 'sample-menus__tab--active' : ''}`}
              tabindex={index === 0 ? 0 : -1}
            >
              {menu.name.replace(' Sample Menu', '')}
            </button>
          ))}
        </div>

        {SAMPLE_MENUS.map((menu, index) => (
          <div
            role="tabpanel"
            id={`panel-${menu.packageId}`}
            aria-labelledby={`tab-${menu.packageId}`}
            class={`sample-menus__panel ${index === 0 ? 'sample-menus__panel--active' : ''}`}
            hidden={index !== 0}
          >
            {menu.description && (
              <p class="sample-menus__panel-description">{menu.description}</p>
            )}
            <div class="sample-menus__categories">
              {menu.categories.map((category) => (
                <div class="sample-menu-category">
                  <h3 class="sample-menu-category__name">{category.name}</h3>
                  <ul class="sample-menu-category__items">
                    {category.items.map((item) => (
                      <li class="sample-menu-item">
                        <span class="sample-menu-item__name">{item.name}</span>
                        {item.description && (
                          <span class="sample-menu-item__description">{item.description}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="private-events-faq" id="faq" aria-labelledby="private-events-faq-heading">
      <div class="private-events-faq__container">
        <div class="private-events-faq__header">
          <span class="private-events-faq__eyebrow reveal reveal--up">FAQ</span>
          <h2 id="private-events-faq-heading" class="private-events-faq__title reveal reveal--up reveal--delay-1">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="private-events-faq__grid">
          {PRIVATE_EVENT_FAQS.map((faq, index) => (
            <div class={`private-events-faq__item reveal reveal--up reveal--delay-${(index % 2) + 1}`}>
              <h3 class="private-events-faq__question">{faq.question}</h3>
              <p class="private-events-faq__answer">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Inquiry Form Section -->
    <div id="inquiry-form">
      <PrivateEventInquiryForm
        venueSpaces={VENUE_SPACES}
        packages={EVENT_PACKAGES}
        heading="Start Planning Your Event"
        description="Tell us about your special occasion and we'll create a customized proposal for you. Our events team typically responds within 24-48 hours."
      />
    </div>

    <!-- CTA Section -->
    <section class="private-events-cta" aria-labelledby="private-events-cta-heading">
      <div class="private-events-cta__container">
        <h2 id="private-events-cta-heading" class="private-events-cta__title reveal reveal--up">
          Ready to Create Unforgettable Memories?
        </h2>
        <p class="private-events-cta__description reveal reveal--up reveal--delay-1">
          Contact our events team to schedule a venue tour or discuss your vision.
        </p>
        <div class="private-events-cta__contact reveal reveal--up reveal--delay-2">
          <p class="private-events-cta__phone">
            <span>Call us:</span>
            <a href="tel:+17135550123">(713) 555-0123</a>
          </p>
          <p class="private-events-cta__email">
            <span>Email:</span>
            <a href="mailto:events@houston-restaurant.com">events@houston-restaurant.com</a>
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================================================================
   * HERO SECTION
   * ================================================================= */
  .private-events-hero {
    padding: var(--spacing-20) var(--spacing-4) var(--spacing-16);
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 50%,
      var(--color-primary-50) 100%
    );
    text-align: center;
  }

  .private-events-hero__container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  .private-events-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--spacing-4);
  }

  .private-events-hero__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  .private-events-hero__subtitle {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 48rem;
    margin: 0 auto var(--spacing-8);
    line-height: var(--line-height-relaxed);
  }

  .private-events-hero__cta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 640px) {
    .private-events-hero__cta {
      flex-direction: row;
    }
  }

  /* =================================================================
   * EVENT TYPES SECTION
   * ================================================================= */
  .event-types {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background);
  }

  .event-types__container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  .event-types__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  @media (min-width: 768px) {
    .event-types__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .event-types__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-8);
    background-color: var(--color-background-subtle);
    border-radius: var(--radius-2xl);
    transition: box-shadow var(--duration-200) var(--ease-in-out), transform var(--duration-200) var(--ease-in-out);
  }

  .event-types__card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .event-types__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: var(--spacing-4);
    color: var(--color-primary);
    background-color: var(--color-primary-100);
    border-radius: var(--radius-full);
  }

  .event-types__icon svg {
    width: 2rem;
    height: 2rem;
  }

  .event-types__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-2);
  }

  .event-types__description {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * VENUE STATS SECTION
   * ================================================================= */
  .venue-stats {
    padding: var(--spacing-12) var(--spacing-4);
    background-color: var(--color-primary);
  }

  .venue-stats__container {
    max-width: var(--container-5xl);
    margin: 0 auto;
  }

  .venue-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-8);
    text-align: center;
  }

  @media (min-width: 768px) {
    .venue-stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .venue-stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .venue-stats__number {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
    line-height: var(--line-height-none);
  }

  .venue-stats__label {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary-100);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  /* =================================================================
   * VENUE SPACES SECTION
   * ================================================================= */
  .venue-spaces {
    padding: var(--spacing-20) var(--spacing-4);
    background-color: var(--color-background);
  }

  .venue-spaces__container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  .venue-spaces__header {
    text-align: center;
    margin-bottom: var(--spacing-12);
  }

  .venue-spaces__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--spacing-2);
  }

  .venue-spaces__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4);
  }

  .venue-spaces__subtitle {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 40rem;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  .venue-spaces__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
  }

  @media (min-width: 768px) {
    .venue-spaces__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Venue Space Card */
  .venue-space-card {
    background-color: var(--color-background-elevated);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--duration-200) var(--ease-in-out), transform var(--duration-200) var(--ease-in-out);
  }

  .venue-space-card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  .venue-space-card__image {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .venue-space-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .venue-space-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary-50), var(--color-background-subtle));
    color: var(--color-primary);
  }

  .venue-space-card__placeholder svg {
    width: 60%;
    height: auto;
  }

  .venue-space-card__badge {
    position: absolute;
    top: var(--spacing-3);
    right: var(--spacing-3);
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    padding: var(--spacing-1-5) var(--spacing-3);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .venue-space-card__content {
    padding: var(--spacing-6);
  }

  .venue-space-card__name {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-2);
  }

  .venue-space-card__description {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--spacing-4);
  }

  .venue-space-card__details {
    display: flex;
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-4);
    padding-bottom: var(--spacing-4);
    border-bottom: 1px solid var(--color-border);
  }

  .venue-space-card__detail-label {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: var(--spacing-1);
  }

  .venue-space-card__detail-value {

---

<Layout
  title="Gallery"
  description="Explore our restaurant gallery featuring signature dishes, stunning interiors, and unforgettable events. See why Houston diners choose us for fine dining, catering, and celebrations."
  openGraph={{
    type: 'website',
  }}
  jsonLd={{
    type: 'CollectionPage',
    name: 'Restaurant Gallery & Showcases',
    description: 'Gallery of signature dishes, dining spaces, catering events, and seasonal menus at our Houston restaurant.',
    url: 'https://houstonwebservices.com/portfolio',
  }}
>
  <main>
    <!-- Portfolio Hero Section -->
    <section class="portfolio-hero" aria-labelledby="portfolio-hero-heading">
      <div class="portfolio-hero__container">
        <div class="portfolio-hero__content">
          <div class="portfolio-hero__badge">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
            <span>Award-Winning • Houston Dining</span>
          </div>
          <h1 id="portfolio-hero-heading" class="portfolio-hero__title">
            A Feast for<br/>
            <span class="portfolio-hero__title-highlight">The Eyes & Palate</span>
          </h1>
          <p class="portfolio-hero__description">
            Explore our gallery of signature dishes, stunning dining spaces, and unforgettable events.
            Every detail — from plating to ambiance — is crafted to deliver an extraordinary dining experience.
          </p>
          <div class="portfolio-hero__cta-group">
            <Button
              text="Make a Reservation"
              href="/contact"
              variant="primary"
              size="large"
            />
            <Button
              text="View Our Menu"
              href="/menu"
              variant="secondary"
              size="large"
            />
          </div>
          <div class="portfolio-hero__stats">
            <div class="portfolio-hero__stat">
              <span class="portfolio-hero__stat-value">200+</span>
              <span class="portfolio-hero__stat-label">Dishes Crafted</span>
            </div>
            <div class="portfolio-hero__stat-divider"></div>
            <div class="portfolio-hero__stat">
              <span class="portfolio-hero__stat-value">500+</span>
              <span class="portfolio-hero__stat-label">Events Hosted</span>
            </div>
            <div class="portfolio-hero__stat-divider"></div>
            <div class="portfolio-hero__stat">
              <span class="portfolio-hero__stat-value">4.9★</span>
              <span class="portfolio-hero__stat-label">Guest Rating</span>
            </div>
          </div>
        </div>
        <div class="portfolio-hero__visual" aria-hidden="true">
          <div class="portfolio-hero__cards-preview">
            <div class="portfolio-hero__preview-card portfolio-hero__preview-card--1">
              <div class="portfolio-hero__preview-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                  <path d="M8.1 13.34l2.83-2.83L3.91 3.5c-1.56 1.56-1.56 4.09 0 5.66l4.19 4.18zm6.78-1.81c1.53.71 3.68.21 5.27-1.38 1.91-1.91 2.28-4.65.81-6.12-1.46-1.46-4.20-1.10-6.12.81-1.59 1.59-2.09 3.74-1.38 5.27L3.7 19.87l1.41 1.41L12 14.41l6.88 6.88 1.41-1.41L13.41 13l1.47-1.47z"/>
                </svg>
              </div>
              <span class="portfolio-hero__preview-label">Signature Dishes</span>
              <span class="portfolio-hero__preview-price">200+ Crafted</span>
            </div>
            <div class="portfolio-hero__preview-card portfolio-hero__preview-card--2">
              <div class="portfolio-hero__preview-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                  <path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/>
                </svg>
              </div>
              <span class="portfolio-hero__preview-label">Events Hosted</span>
              <span class="portfolio-hero__preview-price">500+ Served</span>
            </div>
            <div class="portfolio-hero__preview-card portfolio-hero__preview-card--3">
              <div class="portfolio-hero__preview-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                  <path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3zm0 2.84L18 12h-1v8h-2v-6H9v6H7v-8H6l6-6.16z"/>
                </svg>
              </div>
              <span class="portfolio-hero__preview-label">Dining Spaces</span>
              <span class="portfolio-hero__preview-price">5 Unique</span>
            </div>
          </div>
        </div>
      </div>
      <div class="portfolio-hero__decoration" aria-hidden="true"></div>
    </section>

    <!-- Portfolio Grid Section -->
    <PortfolioSection
      heading="Our Showcases"
      subheading="From chef-crafted dishes to elegant interiors and unforgettable events, explore the experiences that define our restaurant."
      projects={projects}
      columns={3}
      enableFiltering={true}
      showFeaturedFirst={true}
    />

    <!-- Contact CTA Section -->
    <ContactCTA
      headline="Ready to Experience It In Person?"
      supportingText="Whether you're planning an intimate dinner, a grand celebration, or simply craving an unforgettable meal, we're ready to welcome you. Reserve your table or plan your next event with us today."
      primaryCTA={{
        text: "Make a Reservation",
        href: "/contact",
      }}
      secondaryCTA={{
        text: "Plan an Event",
        href: "/catering",
      }}
    />
  </main>
</Layout>

<style>
  /* =================================================================
   * PORTFOLIO HERO SECTION - Matching Services Page Style
   * ================================================================= */

  .portfolio-hero {
    position: relative;
    padding: var(--spacing-16) var(--spacing-4) var(--spacing-20);
    background: linear-gradient(
      135deg,
      var(--color-background) 0%,
      var(--color-primary-50) 50%,
      var(--color-background) 100%
    );
    background-size: 200% 200%;
    animation: gradientShift 15s ease infinite;
    overflow: hidden;
  }

  .portfolio-hero__container {
    max-width: var(--container-7xl);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-10);
    align-items: center;
  }

  .portfolio-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-5);
  }

  .portfolio-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-4);
    background-color: var(--color-success-50);
    border: 1px solid var(--color-success-200);
    border-radius: var(--radius-full);
    color: var(--color-success-700);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .portfolio-hero__badge svg {
    color: var(--color-success-600);
  }

  .portfolio-hero__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .portfolio-hero__title-highlight {
    color: var(--color-primary);
    display: block;
  }

  .portfolio-hero__description {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 50ch;
    margin: 0;
  }

  .portfolio-hero__cta-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    width: 100%;
    max-width: 20rem;
  }

  .portfolio-hero__stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-4) var(--spacing-6);
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    margin-top: var(--spacing-2);
  }

  .portfolio-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-1);
  }

  .portfolio-hero__stat-value {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .portfolio-hero__stat-label {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .portfolio-hero__stat-divider {
    width: 1px;
    height: var(--spacing-8);
    background-color: var(--color-border);
  }

  /* Visual/Cards Preview */
  .portfolio-hero__visual {
    display: none;
  }

  .portfolio-hero__cards-preview {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    padding: var(--spacing-6);
    background: var(--color-background-elevated);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-xl);
    transform: perspective(1000px) rotateY(-5deg) rotateX(2deg);
  }

  .portfolio-hero__preview-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-4);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: transform var(--duration-200) var(--ease-out),
                box-shadow var(--duration-200) var(--ease-out);
  }

  .portfolio-hero__preview-card:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }

  .portfolio-hero__preview-card--1 .portfolio-hero__preview-icon {
    background-color: var(--color-primary-100);
    color: var(--color-primary-600);
  }

  .portfolio-hero__preview-card--2 .portfolio-hero__preview-icon {
    background-color: var(--color-success-100);
    color: var(--color-success-600);
  }

  .portfolio-hero__preview-card--3 .portfolio-hero__preview-icon {
    background-color: var(--color-warning-100);
    color: var(--color-warning-600);
  }

  .portfolio-hero__preview-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-12);
    height: var(--spacing-12);
    border-radius: var(--radius-lg);
    flex-shrink: 0;
  }

  .portfolio-hero__preview-label {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    flex: 1;
  }

  .portfolio-hero__preview-price {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
    background-color: var(--color-primary-50);
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-full);
  }

  /* Decorative element */
  .portfolio-hero__decoration {
    position: absolute;

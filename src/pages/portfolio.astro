---
/**
 * Gallery Page - Restaurant Showcases
 * Showcases our dishes, events, and interiors with filtering capabilities.
 */

import Layout from '../layouts/Layout.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Button from '../components/Button.astro';
import type { Project } from '../types/portfolio';

/**
 * Restaurant showcase items
 * These highlight our dishes, events, interiors, and dining experiences
 */
const projects: Project[] = [
  {
    id: 'wagyu-tomahawk-steak',
    title: 'Wagyu Tomahawk Steak',
    description: 'Our showstopping 32oz bone-in wagyu tomahawk, dry-aged for 45 days and finished with herb-compound butter. Served tableside with roasted bone marrow, charred broccolini, and truffle pommes puree.',
    thumbnail: {
      src: '/portfolio/wagyu-tomahawk.svg',
      alt: 'Perfectly seared wagyu tomahawk steak with golden crust, herb butter, and elegant plating on a dark slate board',
      width: 600,
      height: 400,
    },
    technologies: [

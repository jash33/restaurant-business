---
/**
 * Catering Page
 * A dedicated page for catering inquiries with a fully validated catering form.
 *
 * Features:
 * - Comprehensive catering inquiry form with validation
 * - Event type, date picker, guest count fields
 * - Menu preferences and dietary restrictions
 * - Spam prevention (honeypot + time-based)
 * - Full accessibility support
 * - SEO optimized with structured data
 * - Formspree integration
 */

import Layout from '../layouts/Layout.astro';
import CateringContactForm from '../components/CateringContactForm.astro';
---

<Layout
  title="Catering Services"
  description="Plan your next event with our exceptional catering services. From weddings to corporate events, we create custom menus tailored to your needs."
  openGraph={{
    type: 'website',
  }}
  jsonLd={{
    type: 'WebPage',
    name: 'Catering Services',
    description: 'Professional catering services for weddings, corporate events, private parties, and special occasions.',
  }}
>
  <main>
    <!-- Hero Section -->
    <section class="catering-hero" aria-labelledby="catering-hero-heading">
      <div class="catering-hero__container">
        <h1 id="catering-hero-heading" class="catering-hero__title">
          Exceptional Catering for Every Occasion
        </h1>
        <p class="catering-hero__subtitle">
          From intimate gatherings to grand celebrations, we bring culinary excellence to your event.
          Tell us about your vision and let us create an unforgettable dining experience.
        </p>
      </div>
    </section>

    <!-- Features Section -->
    <section class="catering-features" aria-labelledby="catering-features-heading">
      <div class="catering-features__container">
        <h2 id="catering-features-heading" class="sr-only">Why Choose Our Catering</h2>

        <div class="catering-features__grid">
          <!-- Feature 1 -->
          <div class="catering-features__card">
            <div class="catering-features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z" />
                <path d="M2 17l10 5 10-5" />
                <path d="M2 12l10 5 10-5" />
              </svg>
            </div>
            <h3 class="catering-features__title">Custom Menus</h3>
            <p class="catering-features__text">
              Every menu is crafted to match your event theme, preferences, and dietary requirements.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="catering-features__card">
            <div class="catering-features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            </div>
            <h3 class="catering-features__title">Professional Service</h3>
            <p class="catering-features__text">
              Our experienced staff ensures seamless service from setup to cleanup.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="catering-features__card">
            <div class="catering-features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            </div>
            <h3 class="catering-features__title">Flexible Options</h3>
            <p class="catering-features__text">
              Choose from buffet, plated service, food stations, or cocktail-style catering.
            </p>
          </div>

          <!-- Feature 4 -->
          <div class="catering-features__card">
            <div class="catering-features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
              </svg>
            </div>
            <h3 class="catering-features__title">Quality Ingredients</h3>
            <p class="catering-features__text">
              We use fresh, locally-sourced ingredients to create memorable dishes.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Catering Form Section -->
    <CateringContactForm />

    <!-- FAQ Section -->
    <section class="catering-faq" aria-labelledby="catering-faq-heading">
      <div class="catering-faq__container">
        <h2 id="catering-faq-heading" class="catering-faq__title">Frequently Asked Questions</h2>

        <div class="catering-faq__grid">
          <div class="catering-faq__item">
            <h3 class="catering-faq__question">How far in advance should I book?</h3>
            <p class="catering-faq__answer">
              We recommend booking at least 2-4 weeks in advance for most events.
              For weddings and large events, 2-3 months advance notice is ideal.
            </p>
          </div>

          <div class="catering-faq__item">
            <h3 class="catering-faq__question">What is the minimum guest count?</h3>
            <p class="catering-faq__answer">
              Our catering services require a minimum of 10 guests. For smaller gatherings,
              please contact us to discuss options.
            </p>
          </div>

          <div class="catering-faq__item">
            <h3 class="catering-faq__question">Do you accommodate dietary restrictions?</h3>
            <p class="catering-faq__answer">
              Absolutely! We can accommodate vegetarian, vegan, gluten-free, dairy-free,
              nut-free, halal, kosher, and other dietary requirements.
            </p>
          </div>

          <div class="catering-faq__item">
            <h3 class="catering-faq__question">What's included in catering packages?</h3>
            <p class="catering-faq__answer">
              Our packages typically include food preparation, service staff, setup,
              and cleanup. Additional services like tableware and linens are available.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================================================================
   * HERO SECTION
   * ================================================================= */
  .catering-hero {
    padding: var(--spacing-20) var(--spacing-4) var(--spacing-12);
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    text-align: center;
  }

  .catering-hero__container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  .catering-hero__title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-4);
    letter-spacing: var(--letter-spacing-tight);
  }

  .catering-hero__subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 40rem;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * FEATURES SECTION
   * ================================================================= */
  .catering-features {
    padding: var(--spacing-12) var(--spacing-4);
    background-color: var(--color-background);
  }

  .catering-features__container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  .catering-features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  @media (min-width: 640px) {
    .catering-features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .catering-features__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .catering-features__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-6);
    background-color: var(--color-background-subtle);
    border-radius: var(--radius-xl);
    transition: box-shadow var(--duration-200) var(--ease-in-out);
  }

  .catering-features__card:hover {
    box-shadow: var(--shadow-md);
  }

  .catering-features__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--spacing-4);
    color: var(--color-primary);
  }

  .catering-features__icon svg {
    width: 100%;
    height: 100%;
  }

  .catering-features__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-2);
  }

  .catering-features__text {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* =================================================================
   * FAQ SECTION
   * ================================================================= */
  .catering-faq {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background);
  }

  .catering-faq__container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  .catering-faq__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: var(--spacing-10);
  }

  .catering-faq__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  @media (min-width: 768px) {
    .catering-faq__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .catering-faq__item {
    padding: var(--spacing-6);
    background-color: var(--color-background-subtle);
    border-radius: var(--radius-xl);
  }

  .catering-faq__question {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-2);
  }

  .catering-faq__answer {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * SCREEN READER ONLY
   * ================================================================= */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* =================================================================
   * RESPONSIVE ADJUSTMENTS
   * ================================================================= */
  @media (max-width: 767px) {
    .catering-hero {
      padding: var(--spacing-12) var(--spacing-4) var(--spacing-8);
    }

    .catering-hero__title {
      font-size: var(--font-size-3xl);
    }

    .catering-hero__subtitle {
      font-size: var(--font-size-base);
    }

    .catering-features {
      padding: var(--spacing-8) var(--spacing-4);
    }

    .catering-faq {
      padding: var(--spacing-12) var(--spacing-4);
    }

    .catering-faq__title {
      font-size: var(--font-size-2xl);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .catering-features__card {
      transition: none;
    }
  }
</style>

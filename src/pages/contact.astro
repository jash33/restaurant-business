---
/**
 * Contact Page
 * A comprehensive contact page for the restaurant with multiple ways to get in touch.
 *
 * Features:
 * - General inquiries form with catering toggle
 * - Phone/email contact information
 * - Office hours for callbacks
 * - Interactive location map
 * - Reservation platform links (OpenTable, Resy)
 * - Operating hours display
 * - Full accessibility support
 * - SEO optimized with structured data
 */

import Layout from '../layouts/Layout.astro';
import RestaurantContactForm from '../components/RestaurantContactForm.astro';
import ContactInfo from '../components/ContactInfo.astro';
import LocationMap from '../components/LocationMap.astro';
import ReservationLinks from '../components/ReservationLinks.astro';
import HoursDisplay from '../components/HoursDisplay.astro';
import LocationSection from '../components/LocationSection.astro';
import ReviewCTA from '../components/ReviewCTA.astro';
---

<Layout
  title="Contact Us"
  description="Get in touch with us for reservations, catering inquiries, or general questions. Book a table on OpenTable or Resy, or reach out directly by phone or email."
  openGraph={{
    type: 'website',
  }}
  jsonLd={{
    type: 'ContactPage',
    name: 'Contact Houston Restaurant',
    description: 'Contact page for making reservations, catering inquiries, and general questions about our restaurant in Downtown Houston.',
  }}
>
  <main>
    <!-- Hero Section -->
    <section class="contact-hero" aria-labelledby="contact-hero-heading">
      <div class="contact-hero__container">
        <h1 id="contact-hero-heading" class="contact-hero__title">
          Get in Touch
        </h1>
        <p class="contact-hero__subtitle">
          Whether you're planning a special event, making a reservation, or have a question,
          we'd love to hear from you. Reach out through any of the options below.
        </p>
      </div>
    </section>

    <!-- Reservation Links Section -->
    <ReservationLinks
      heading="Make a Reservation"
      subheading="Book your table through your preferred platform"
      openTableUrl="https://www.opentable.com/r/houston-restaurant"
      resyUrl="https://resy.com/cities/hou/houston-restaurant"
      phone="(713) 555-0123"
    />

    <!-- Contact Form Section with Toggle -->
    <RestaurantContactForm
      heading="Send Us a Message"
      description="Have a question or planning an event? Fill out the form below and we'll get back to you within 24 hours."
      defaultFormType="general"
    />

    <!-- Contact Information Section -->
    <ContactInfo
      heading="Contact Information"
      subheading="Reach out to us directly or request a callback during office hours."
      phone="(713) 555-0123"
      email="info@houston-restaurant.com"
      showOfficeHours={true}
    />

    <!-- Location Map Section -->
    <LocationMap
      heading="Find Us"
      subheading="We're located in the heart of Downtown Houston with easy access and free parking."
      mapHeight={450}
      showDirections={true}
      showAddressOverlay={true}
    />

    <!-- Hours Display Section -->
    <HoursDisplay
      heading="Hours of Operation"
      subheading="Visit us during our regular hours or check below for special holiday schedules."
    />

    <!-- Detailed Location Section -->
    <LocationSection
      heading="Getting Here"
      subheading="We're conveniently located in Downtown Houston with plenty of parking options."
    />

    <!-- Review CTA Section -->
    <section class="review-section" aria-labelledby="review-section-heading">
      <div class="review-section__container">
        <h2 id="review-section-heading" class="sr-only">Leave a Review</h2>
        <ReviewCTA
          heading="Had a Great Experience?"
          description="We'd love to hear your feedback! Share your experience on Google and help others discover us."
          buttonText="Leave a Review on Google"
          variant="default"
        />
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================================================================
   * HERO SECTION
   * ================================================================= */
  .contact-hero {
    padding: var(--spacing-20) var(--spacing-4) var(--spacing-12);
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    text-align: center;
  }

  .contact-hero__container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  .contact-hero__title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-4);
    letter-spacing: var(--letter-spacing-tight);
  }

  .contact-hero__subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 42rem;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * RESPONSIVE ADJUSTMENTS
   * ================================================================= */
  @media (max-width: 767px) {
    .contact-hero {
      padding: var(--spacing-12) var(--spacing-4) var(--spacing-8);
    }

    .contact-hero__title {
      font-size: var(--font-size-3xl);
    }

    .contact-hero__subtitle {
      font-size: var(--font-size-base);
    }
  }

  /* =================================================================
   * DARK MODE
   * ================================================================= */
  :global(html[data-theme="dark"]) .contact-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-950) 0%,
      var(--color-background) 100%
    );
  }

  /* =================================================================
   * REVIEW SECTION
   * ================================================================= */
  .review-section {
    padding: var(--spacing-12) var(--spacing-4);
    background: var(--color-background-muted);
  }

  .review-section__container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }
</style>

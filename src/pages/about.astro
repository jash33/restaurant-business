---
/**
 * About Page - The Main Street Bistro
 * A narrative-driven page showcasing the restaurant's story,
 * sourcing philosophy, partnerships, and history.
 *
 * Features:
 * - Hero section with restaurant branding
 * - Founders story with personal narrative
 * - Sourcing philosophy with principles
 * - Ingredient partnership showcase
 * - Restaurant history timeline
 * - Full SEO optimization with structured data
 * - WCAG 2.1 AA accessible
 */

import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import SourcingPhilosophy from '../components/SourcingPhilosophy.astro';
import PartnershipShowcase from '../components/PartnershipShowcase.astro';
import RestaurantTimeline from '../components/RestaurantTimeline.astro';
import YelpReviews from '../components/YelpReviews.astro';

import {
  ABOUT_PAGE_CONFIG,
  FOUNDERS_STORY,
  SOURCING_PRINCIPLES,
  INGREDIENT_PARTNERSHIPS,
  RESTAURANT_TIMELINE,
} from '../config/about.config';

const { hero, foundersStory } = ABOUT_PAGE_CONFIG;

// Restaurant stats for the achievement section
const achievements = [
  { number: '9+', label: 'Years Serving Houston' },
  { number: '15+', label: 'Local Farm Partners' },
  { number: '85%', label: 'Locally Sourced' },
  { number: '50K+', label: 'Guests Served' },
];
---

<Layout
  title="About Us"
  description="Discover the story behind The Main Street Bistro. Learn about our farm-to-table philosophy and explore our journey from a small dream to Houston's beloved neighborhood bistro."
  openGraph={{
    type: 'profile',
  }}
  jsonLd={{
    type: 'AboutPage',
    name: 'About The Main Street Bistro',
    description: 'Learn about the founders, sourcing philosophy, and history of The Main Street Bistro - Houston\'s farm-to-table destination since 2015.',
  }}
>
  <main>
    <!-- Hero Section -->
    <section class="about-hero" aria-labelledby="about-hero-heading">
      <div class="about-hero__container">
        <span class="about-hero__eyebrow reveal reveal--up">{hero.eyebrow}</span>
        <h1 id="about-hero-heading" class="about-hero__title reveal reveal--up reveal--delay-1">
          {hero.headline}
        </h1>
        <p class="about-hero__subtitle reveal reveal--up reveal--delay-2">
          {hero.subheadline}
        </p>
      </div>
    </section>

    <!-- Founders Story Section -->
    <section class="founders-story" aria-labelledby="founders-story-heading">
      <div class="founders-story__container">
        <div class="founders-story__content">
          <div class="founders-story__photo-column reveal reveal--left">
            <div class="founders-story__photo-wrapper">
              {foundersStory.photoSrc ? (
                <img
                  src={foundersStory.photoSrc}
                  alt={foundersStory.photoAlt}
                  class="founders-story__photo"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="founders-story__photo-placeholder" role="img" aria-label={foundersStory.photoAlt}>
                  <svg class="founders-story__placeholder-svg" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect width="200" height="200" fill="currentColor" opacity="0.08"/>
                    <!-- Two figures representing founders -->
                    <circle cx="75" cy="65" r="25" fill="currentColor" opacity="0.15"/>
                    <ellipse cx="75" cy="130" rx="35" ry="30" fill="currentColor" opacity="0.12"/>
                    <circle cx="125" cy="65" r="25" fill="currentColor" opacity="0.15"/>
                    <ellipse cx="125" cy="130" rx="35" ry="30" fill="currentColor" opacity="0.12"/>
                  </svg>
                  <span class="founders-story__placeholder-label">Photo Coming Soon</span>
                </div>
              )}
              <div class="founders-story__badge" aria-hidden="true">
                <span class="founders-story__badge-text">{foundersStory.establishedYear}</span>
              </div>
            </div>
          </div>

          <div class="founders-story__text-column reveal reveal--up reveal--delay-1">
            <span class="founders-story__eyebrow">Our Beginning</span>
            <h2 id="founders-story-heading" class="founders-story__heading">
              {foundersStory.heading}
            </h2>

            {foundersStory.pullQuote && (
              <blockquote class="founders-story__pullquote">
                <svg class="founders-story__quote-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
                </svg>
                <p>{foundersStory.pullQuote}</p>
                {foundersStory.pullQuoteAttribution && (
                  <cite class="founders-story__quote-attribution">— {foundersStory.pullQuoteAttribution}</cite>
                )}
              </blockquote>
            )}

            <div class="founders-story__paragraphs">
              {foundersStory.story.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>

            <div class="founders-story__cta">
              <Button
                text="Make a Reservation"
                href="/contact"
                variant="primary"
                size="large"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Achievements Stats Section -->
    <section class="about-stats" aria-labelledby="about-stats-heading">
      <div class="about-stats__container">
        <h2 id="about-stats-heading" class="sr-only">Our Impact in Numbers</h2>
        <div class="about-stats__grid">
          {achievements.map((stat, index) => (
            <div class={`about-stats__item reveal reveal--scale-up reveal--delay-${index + 1}`}>
              <span class="about-stats__number">{stat.number}</span>
              <span class="about-stats__label">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Yelp Reviews Section -->
    <YelpReviews
      heading="What Yelpers Are Saying"
      maxReviews={4}
      showHighlights={true}
      maxHighlights={4}
      showReviewCTA={true}
      showYelpLink={true}
    />

    <!-- Sourcing Philosophy Section -->
    <SourcingPhilosophy
      principles={SOURCING_PRINCIPLES}
      heading="Our Sourcing Philosophy"
      subheading="We believe exceptional dishes start with exceptional ingredients."
      intro="At The Main Street Bistro, sourcing isn't just logistics — it's a core part of our culinary identity. We've built lasting relationships with local farmers, ranchers, and artisans who share our commitment to quality, sustainability, and ethical practices."
    />

    <!-- Partnership Showcase Section -->
    <PartnershipShowcase
      partnerships={INGREDIENT_PARTNERSHIPS}
      heading="Our Partners"
      subheading="The local farms, ranches, and artisans who help us bring our vision to life."
    />

    <!-- Restaurant Timeline Section -->
    <RestaurantTimeline
      milestones={RESTAURANT_TIMELINE}
      heading="Our Journey"
      subheading="From our humble beginnings to today, every milestone tells a story of passion, perseverance, and community."
    />

    <!-- Call to Action Section -->
    <section class="about-cta" aria-labelledby="about-cta-heading">
      <div class="about-cta__container">
        <h2 id="about-cta-heading" class="about-cta__title reveal reveal--up">
          Experience Our Story Firsthand
        </h2>
        <p class="about-cta__description reveal reveal--up reveal--delay-1">
          Join us for a meal and become part of our continuing story.
          We can't wait to share our passion with you.
        </p>
        <div class="about-cta__buttons reveal reveal--up reveal--delay-2">
          <Button
            text="Make a Reservation"
            href="/contact"
            variant="primary"
            size="large"
          />
          <Button
            text="View Our Menu"
            href="/menu"
            variant="secondary"
            size="large"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================================================================
   * HERO SECTION
   * ================================================================= */
  .about-hero {
    padding: var(--spacing-20) var(--spacing-4) var(--spacing-16);
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    text-align: center;
  }

  .about-hero__container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  .about-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--spacing-4);
  }

  .about-hero__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  .about-hero__subtitle {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 48rem;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * FOUNDERS STORY SECTION
   * ================================================================= */
  .founders-story {
    padding: var(--spacing-20) var(--spacing-4);
    background-color: var(--color-background);
  }

  .founders-story__container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  .founders-story__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-12);
    align-items: start;
  }

  .founders-story__photo-column {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .founders-story__photo-wrapper {
    position: relative;
    width: 100%;
    max-width: 400px;
  }

  .founders-story__photo {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xl);
  }

  .founders-story__photo-placeholder {
    width: 100%;
    aspect-ratio: 4/5;
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background-subtle) 50%,
      var(--color-primary-50) 100%
    );
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .founders-story__placeholder-svg {
    width: 60%;
    height: auto;
    color: var(--color-primary);
  }

  .founders-story__placeholder-label {
    position: absolute;
    bottom: var(--spacing-4);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-tertiary);
  }

  .founders-story__badge {
    position: absolute;
    bottom: -0.75rem;
    right: 10%;
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    transform: rotate(-3deg);
  }

  .founders-story__badge-text {
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
    letter-spacing: var(--letter-spacing-wide);
  }

  .founders-story__text-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .founders-story__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
  }

  .founders-story__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-tight);
  }

  .founders-story__pullquote {
    position: relative;
    margin: var(--spacing-4) 0;
    padding: var(--spacing-6) var(--spacing-8);
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      transparent 100%
    );
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }

  .founders-story__quote-icon {
    position: absolute;
    top: var(--spacing-3);
    left: var(--spacing-3);
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-primary);
    opacity: 0.3;
  }

  .founders-story__pullquote p {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    font-style: italic;
    color: var(--color-text-primary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .founders-story__quote-attribution {
    display: block;
    margin-top: var(--spacing-3);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-style: normal;
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
  }

  .founders-story__paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .founders-story__paragraphs p {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .founders-story__cta {
    margin-top: var(--spacing-4);
  }

  /* =================================================================
   * ACHIEVEMENTS STATS SECTION
   * ================================================================= */
  .about-stats {
    padding: var(--spacing-12) var(--spacing-4);
    background-color: var(--color-primary);
  }

  .about-stats__container {
    max-width: var(--container-5xl);
    margin: 0 auto;
  }

  .about-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-8);
    text-align: center;
  }

  .about-stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .about-stats__number {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
    line-height: var(--line-height-none);
  }

  .about-stats__label {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary-100);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  /* =================================================================
   * CALL TO ACTION SECTION
   * ================================================================= */
  .about-cta {
    padding: var(--spacing-20) var(--spacing-4);
    background-color: var(--color-primary);
    text-align: center;
  }

  .about-cta__container {
    max-width: var(--container-3xl);
    margin: 0 auto;
  }

  .about-cta__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
  }

  .about-cta__description {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-primary-100);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--spacing-8);
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
  }

  .about-cta__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    justify-content: center;
    align-items: center;
  }

  /* Override secondary button colors for dark background */
  .about-cta :global(.btn--secondary) {
    color: var(--color-text-inverse);
    border-color: var(--color-text-inverse);
  }

  .about-cta :global(.btn--secondary:hover:not(.btn--disabled)) {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: var(--color-text-inverse);
    color: var(--color-text-inverse);
  }

  /* =================================================================
   * SCREEN READER ONLY
   * ================================================================= */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */
  @media (min-width: 640px) {
    .about-cta__buttons {
      flex-direction: row;
    }
  }

  @media (min-width: 768px) {
    .about-stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .founders-story__heading {
      font-size: var(--font-size-4xl);
    }

    .founders-story__pullquote p {
      font-size: var(--font-size-xl);
    }
  }

  @media (min-width: 1024px) {
    .founders-story__content {
      grid-template-columns: 400px 1fr;
      gap: var(--spacing-16);
      align-items: center;
    }

    .founders-story__photo-column {
      position: sticky;
      top: var(--spacing-8);
    }
  }

  @media (min-width: 1280px) {
    .founders-story__content {
      grid-template-columns: 450px 1fr;
      gap: var(--spacing-20);
    }
  }

  /* =================================================================
   * MOBILE ADJUSTMENTS
   * ================================================================= */
  @media (max-width: 767px) {
    .about-hero {
      padding: var(--spacing-12) var(--spacing-4) var(--spacing-10);
    }

    .about-hero__title {
      font-size: var(--font-size-3xl);
    }

    .about-hero__subtitle {
      font-size: var(--font-size-base);
    }

    .founders-story {
      padding: var(--spacing-12) var(--spacing-4);
    }

    .founders-story__photo-wrapper {
      max-width: 320px;
    }

    .founders-story__heading {
      font-size: var(--font-size-2xl);
    }

    .founders-story__pullquote {
      padding: var(--spacing-4) var(--spacing-5);
      margin: var(--spacing-2) 0;
    }

    .founders-story__pullquote p {
      font-size: var(--font-size-base);
    }

    .founders-story__paragraphs p {
      font-size: var(--font-size-sm);
    }

    .about-stats {
      padding: var(--spacing-10) var(--spacing-4);
    }

    .about-stats__number {
      font-size: var(--font-size-3xl);
    }

    .about-cta {
      padding: var(--spacing-12) var(--spacing-4);
    }

    .about-cta__title {
      font-size: var(--font-size-2xl);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
    }
  }

  /* =================================================================
   * DARK MODE SUPPORT
   * ================================================================= */
  [data-theme="dark"] .about-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-900) 0%,
      var(--color-background) 100%
    );
  }

  [data-theme="dark"] .founders-story__photo-placeholder {
    background: linear-gradient(
      135deg,
      var(--color-primary-900) 0%,
      var(--color-background-muted) 50%,
      var(--color-primary-900) 100%
    );
  }

  [data-theme="dark"] .founders-story__pullquote {
    background: linear-gradient(
      135deg,
      var(--color-primary-900) 0%,
      transparent 100%
    );
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */
  @media print {
    .about-hero {
      background: none;
      padding: var(--spacing-8) 0;
    }

    .founders-story {
      padding: var(--spacing-8) 0;
    }

    .founders-story__photo-placeholder {
      box-shadow: none;
      border: 1px solid var(--color-border);
    }

    .founders-story__badge {
      display: none;
    }

    .about-stats {
      background: none;
      border: 2px solid var(--color-primary);
    }

    .about-stats__number,
    .about-stats__label {
      color: var(--color-text-primary);
    }

    .about-cta {
      background: none;
      border-top: 2px solid var(--color-primary);
    }

    .about-cta__title,
    .about-cta__description {
      color: var(--color-text-primary);
    }
  }
</style>

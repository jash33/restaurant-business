---
import Layout from '../layouts/Layout.astro';
import RestaurantHeroSection from '../components/RestaurantHeroSection.astro';
import MenuPreviewSection from '../components/MenuPreviewSection.astro';
import GoogleBusinessProfile from '../components/GoogleBusinessProfile.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { restaurantSchema } from '../config/restaurant.config';

/**
 * Homepage - HTX Creamery
 * Streamlined landing page for Houston's favorite ice cream shop.
 */
---

<Layout
	title="HTX Creamery | Handcrafted Ice Cream in Houston"
	description="Houston's favorite neighborhood ice cream shop serving handcrafted small-batch ice cream, artisan sundaes, and classic shakes. Made fresh daily in the Energy Corridor."
	noTitleTemplate
	transparentHeader={true}
	openGraph={{
		type: 'website',
	}}
	jsonLd={restaurantSchema}
>
	<main>
		<!-- Hero Section -->
		<RestaurantHeroSection
			restaurantName="HTX Creamery"
			tagline="Handcrafted Ice Cream, Scooped with Love in Houston"
			backgroundImage={{
				src: "/restaurant-business/images/hero-icecream-display.jpg",
				alt: "Colorful display of handcrafted ice cream flavors at HTX Creamery",
				position: "center 60%"
			}}
			primaryCTA={{
				text: "See Our Flavors",
				href: "/restaurant-business/menu",
			}}
			secondaryCTA={{
				text: "Find Us",
				href: "/restaurant-business/contact",
			}}
			hoursBadge={{
				show: true,
				statusText: "Open Now",
				hoursText: "12pm - 9pm",
				isOpen: true
			}}
			warmGradient={true}
			moodyLighting={false}
			overlayOpacity={0.4}
		/>

		<!-- Menu Preview Section -->
		<MenuPreviewSection
			id="menu-preview"
			heading="Today's Flavors"
			subheading="Small-batch, handcrafted ice cream made fresh daily with locally-sourced ingredients."
			layout="masonry"
			itemsToShow={6}
			viewAllText="See All Flavors"
			viewAllHref="/restaurant-business/menu"
		/>

		<!-- Google Business Profile / Reviews Section -->
		<GoogleBusinessProfile
			id="reviews"
			heading="What Our Customers Say"
			subheading="See why Houston families rate us 4.9 stars on Google"
			showReviewCTA={true}
			maxReviews={4}
		/>

		<!-- Contact CTA Section -->
		<ContactCTA
			headline="Life's Too Short for Bad Ice Cream"
			supportingText="Stop by for a scoop (or three) of happiness. We're open seven days a week in the Energy Corridor — bring the whole family!"
			primaryCTA={{
				text: "Get Directions",
				href: "/restaurant-business/contact",
			}}
			secondaryCTA={{
				text: "Call Us: (832) 555-CONE",
				href: "tel:+1-832-555-2663",
			}}
		/>
	</main>
</Layout>

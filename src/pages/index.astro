---
import Layout from '../layouts/Layout.astro';
import RestaurantHeroSection from '../components/RestaurantHeroSection.astro';
import OriginStorySection from '../components/OriginStorySection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import DifferentiatorsSection from '../components/DifferentiatorsSection.astro';
import MenuPreviewSection from '../components/MenuPreviewSection.astro';
import DeliveryPlatformLinks from '../components/DeliveryPlatformLinks.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import GoogleBusinessProfile from '../components/GoogleBusinessProfile.astro';
import AwardsSection from '../components/AwardsSection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ContactCTA from '../components/ContactCTA.astro';
import type { Service } from '../types/service';
import type { Differentiator } from '../types/differentiator';
import { DEFAULT_FAQ_ITEMS } from '../types/faq';
import { restaurantSchema } from '../config/restaurant.config';
import { awards, AWARDS_CONFIG } from '../config/awards.config';

/**
 * Homepage - The Main Street Bistro
 * Main landing page showcasing dining experiences, services, and our story.
 */

// SVG Icons for services (optimized inline SVGs)
const icons = {
	dineIn: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/></svg>`,
	catering: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M2 19h20v2H2v-2zm1-1h18c0-3.53-3.47-6-9-6s-9 2.47-9 6zm8.31-4.39c-.78.37-1.61.69-2.44.94-.09.03-.17.06-.26.09h8.78c-.09-.03-.17-.06-.26-.09-.83-.25-1.66-.57-2.44-.94-1.17-.55-2.21-1.27-3.07-2.11-.86.84-1.9 1.56-3.07 2.11zM12 2C9.24 2 7 4.24 7 7c0 2.76 2.24 5 5 5s5-2.24 5-5c0-2.76-2.24-5-5-5z"/></svg>`,
	brunch: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.11 0 2-.89 2-2V5c0-1.11-.89-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4v-2z"/></svg>`,
	craftCocktails: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M21 5V3H3v2l8 9v5H6v2h12v-2h-5v-5l8-9zM7.43 7L5.66 5h12.69l-1.78 2H7.43z"/></svg>`,
};

// SVG Icons for differentiators (optimized inline SVGs)
const differentiatorIcons = {
	farmToTable: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22c4.97 0 9-4.03 9-9-4.97 0-9 4.03-9 9zM5.6 10.25c0 1.38 1.12 2.5 2.5 2.5.53 0 1.01-.16 1.42-.44l-.02.19c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5l-.02-.19c.4.28.89.44 1.42.44 1.38 0 2.5-1.12 2.5-2.5 0-1-.59-1.85-1.43-2.25.84-.4 1.43-1.25 1.43-2.25 0-1.38-1.12-2.5-2.5-2.5-.53 0-1.01.16-1.42.44l.02-.19C14.5 2.12 13.38 1 12 1S9.5 2.12 9.5 3.5l.02.19c-.4-.28-.89-.44-1.42-.44-1.38 0-2.5 1.12-2.5 2.5 0 1 .59 1.85 1.43 2.25-.84.4-1.43 1.25-1.43 2.25zM12 5.5c1.38 0 2.5 1.12 2.5 2.5s-1.12 2.5-2.5 2.5S9.5 9.38 9.5 8s1.12-2.5 2.5-2.5zM3 13c0 4.97 4.03 9 9 9 0-4.97-4.03-9-9-9z"/></svg>`,
	awardWinning: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 7.13l.97 2.29.47 1.11 1.2.1 2.47.21-1.88 1.63-.91.79.27 1.18.56 2.41-2.12-1.28L12 14.6l-1.03.62-2.12 1.28.56-2.41.27-1.18-.91-.79-1.88-1.63 2.47-.21 1.2-.1.47-1.11L12 7.13M12 2l-2.85 6.69L2 9.49l5.27 4.58L5.82 21 12 17.27 18.18 21l-1.45-6.93L22 9.49l-7.15-.8L12 2z"/></svg>`,
	warmHospitality: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`,
	locallySourced: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`,
};

// Dining services for the homepage
const services: Service[] = [
	{
		id: 'dine-in',
		title: 'Dine-In Experience',
		description: 'Enjoy our award-winning contemporary American cuisine in an elegant yet relaxed atmosphere. From signature steaks to fresh seafood, every dish is crafted with locally-sourced ingredients.',
		icon: icons.dineIn,
		cta: {
			text: 'View Menu',
			href: '/menu',
		},
	},
	{
		id: 'catering',
		title: 'Catering Services',
		description: 'Bring the Main Street Bistro experience to your next event. Our catering team crafts custom menus for corporate gatherings, weddings, and celebrations of every size.',
		icon: icons.catering,
		cta: {
			text: 'Plan Your Event',
			href: '/catering',
		},
	},
	{
		id: 'brunch',
		title: 'Weekend Brunch',
		description: 'Join us every Saturday and Sunday for Houston\'s favorite brunch. Enjoy house-made pastries, signature egg dishes, and bottomless mimosas in a sun-filled setting.',
		icon: icons.brunch,
		cta: {
			text: 'Brunch Menu',
			href: '/menu#brunch',
		},
	},
	{
		id: 'craft-cocktails',
		title: 'Craft Cocktails & Wine',
		description: 'Our full bar features handcrafted cocktails, an extensive wine list with curated pairings, and a rotating selection of local craft beers on tap.',
		icon: icons.craftCocktails,
		cta: {
			text: 'Drinks Menu',
			href: '/menu#drinks',
		},
	},
];

// Differentiators - unique selling points that set us apart
const differentiators: Differentiator[] = [
	{
		id: 'farm-to-table',
		title: 'Farm-to-Table Fresh',
		description: 'We partner with local Texas farms and ranchers to bring you the freshest seasonal ingredients. Every dish celebrates the best our region has to offer.',
		icon: differentiatorIcons.farmToTable,
	},
	{
		id: 'award-winning',
		title: 'Award-Winning Cuisine',
		description: 'Recognized by Houston\'s top food critics and honored with multiple culinary awards, our kitchen delivers excellence on every plate.',
		icon: differentiatorIcons.awardWinning,
	},
	{
		id: 'warm-hospitality',
		title: 'Warm Hospitality',
		description: 'From the moment you walk in, you\'re family. Our team is dedicated to creating a welcoming experience that keeps guests coming back.',
		icon: differentiatorIcons.warmHospitality,
	},
	{
		id: 'locally-sourced',
		title: 'Rooted in Houston',
		description: 'Born and raised in the heart of Houston, we\'re proud to be part of this community. We support local purveyors and give back to our neighborhood.',
		icon: differentiatorIcons.locallySourced,
	},
];
---

<Layout
	title="The Main Street Bistro | Award-Winning Houston Restaurant"
	description="Award-winning American bistro in downtown Houston serving contemporary cuisine with locally-sourced ingredients. Signature steaks, fresh seafood, craft cocktails, private dining, and catering services."
	noTitleTemplate
	openGraph={{
		type: 'website',
	}}
	jsonLd={restaurantSchema}
>
	<main>
		<!-- Hero Section -->
		<RestaurantHeroSection
			restaurantName="The Main Street Bistro"
			tagline="Where Houston Comes to Dine"
			backgroundImage={{
				src: "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1920&q=80",
				alt: "Beautifully plated contemporary American cuisine at The Main Street Bistro",
				position: "center 40%"
			}}
			primaryCTA={{
				text: "Make a Reservation",
				href: "/reservations",
			}}
			secondaryCTA={{
				text: "Explore Our Menu",
				href: "/menu",
			}}
			hoursBadge={{
				show: true,
				statusText: "Open Now",
				hoursText: "11am - 10pm",
				isOpen: true
			}}
			warmGradient={true}
			moodyLighting={true}
			overlayOpacity={0.6}
		/>

		<!-- Origin Story Section -->
		<OriginStorySection
			id="our-story"
			heading="Our Story"
			storySnippet={"What began as a dream in a small family kitchen has blossomed into a beloved gathering place for our Houston community. Every dish we serve carries the love, tradition, and passion that's been passed down through generations.\n\nOur founder's journey started with a simple belief: that food has the power to bring people together, to create memories, and to tell stories. From our grandmother's treasured recipes to our modern culinary innovations, we honor the past while embracing the future."}
			pullQuote="Every plate we serve tells a story — of family, of tradition, of love poured into every ingredient."
			chefName="The Family"
			chefTitle="Founders & Proprietors"
			establishedYear="Est. 2016"
			ctaText="Read Our Full Story"
			ctaHref="/about"
		/>

		<!-- Services Section -->
		<ServicesSection
			id="services"
			heading="Dining & Experiences"
			subheading="From intimate dinners to grand celebrations, discover everything The Main Street Bistro has to offer."
			services={services}
			columns={4}
		/>

		<!-- Why Choose Us / Differentiators Section -->
		<DifferentiatorsSection
			id="why-choose-us"
			heading="Why Dine With Us"
			subheading="Here's what makes The Main Street Bistro a Houston dining destination."
			differentiators={differentiators}
		/>

		<!-- Menu Preview Section -->
		<MenuPreviewSection
			id="menu-preview"
			heading="Featured Menu Items"
			subheading="Discover our signature dishes crafted with passion and the finest ingredients."
			layout="masonry"
			itemsToShow={6}
			viewAllText="View Full Menu"
			viewAllHref="/menu"
		/>

		<!-- Instagram Feed Section -->
		<InstagramFeed
			id="instagram-feed"
			heading="Follow Us on Instagram"
			subheading="See our latest food photos and restaurant atmosphere"
			maxPosts={6}
			columns={3}
			showCaptions={true}
			showViewOnInstagram={true}
		/>

		<!-- Delivery Platform Links Section -->
		<DeliveryPlatformLinks />

		<!-- Google Business Profile / Reviews Section -->
		<GoogleBusinessProfile
			id="reviews"
			heading="What Our Guests Are Saying"
			subheading="See why Houston food lovers rate us 4.7 stars on Google"
			showReviewCTA={true}
			maxReviews={4}
		/>

		<!-- Awards & Recognition Section -->
		<AwardsSection
			id="awards"
			heading={AWARDS_CONFIG.defaultHeading}
			subheading={AWARDS_CONFIG.defaultSubheading}
			awards={awards}
			layout="grid"
			maxItems={6}
			showLogos={true}
			showYears={true}
			showQuotes={true}
			background="default"
		/>

		<!-- FAQ Section -->
		<FAQAccordion
			items={DEFAULT_FAQ_ITEMS}
			heading="Frequently Asked Questions"
			subheading="Find answers to common questions about reservations, our menu, private dining, and catering services."
			allowMultiple={false}
			initialExpanded={null}
		/>

		<!-- Contact CTA Section -->
		<ContactCTA
			headline="Ready for an Unforgettable Dining Experience?"
			supportingText="Whether it's a romantic dinner for two, a family celebration, or a corporate event, The Main Street Bistro is the perfect setting. Reserve your table today and discover why Houston food lovers have made us their favorite neighborhood bistro."
			primaryCTA={{
				text: "Make a Reservation",
				href: "/reservations",
			}}
			secondaryCTA={{
				text: "Call Us: (713) 555-0123",
				href: "tel:+1-713-555-0123",
			}}
		/>
	</main>
</Layout>

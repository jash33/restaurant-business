---
/**
 * Photo Gallery Page
 *
 * Showcases the restaurant through stunning photography featuring
 * interior, exterior, and food imagery. Implements responsive
 * masonry/grid layouts with lazy loading for optimal performance.
 *
 * Features two layout modes:
 * - Desktop: Masonry grid layout with category filtering
 * - Mobile: Horizontal scrolling gallery with snap points for efficient browsing
 */
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import { GALLERY_IMAGES, GALLERY_SEO, getImagesByCategory, GALLERY_CATEGORIES } from '../config/gallery.config';

// Get featured images for mobile horizontal gallery (one from each category)
const featuredImages = GALLERY_CATEGORIES.map(category => {
  const images = getImagesByCategory(category);
  return images[0];
}).filter(Boolean);
---

<Layout title={GALLERY_SEO.title} description={GALLERY_SEO.description}>
  <main class="gallery-page">
    <!-- Hero Section -->
    <section class="gallery-hero">
      <div class="container">
        <h1>Our Gallery</h1>
        <p class="hero-subtitle">
          Take a visual journey through our restaurant - from our elegant dining spaces
          to our beautifully crafted dishes.
        </p>
      </div>
    </section>

    <!-- Mobile Horizontal Gallery (shown on smaller screens) -->
    <section class="mobile-gallery-section">
      <div class="container">
        <h2 class="section-heading">Featured Photos</h2>
        <p class="section-subheading">Swipe to explore our restaurant highlights</p>
        <HorizontalGallery
          images={GALLERY_IMAGES}
          showIndicators={true}
          showArrows={true}
          lightbox={true}
          height="280px"
          aspectRatio="4/3"
          gap={0.75}
          showCaptions={true}
          testId="mobile-gallery"
        />
      </div>
    </section>

    <!-- Desktop Photo Gallery Section (hidden on mobile) -->
    <section class="gallery-section desktop-gallery">
      <div class="container">
        <PhotoGallery
          images={GALLERY_IMAGES}
          layout="masonry"
          columns={3}
          gap={1.5}
          showCategories={true}
          lightbox={true}
          testId="restaurant-gallery"
        />
      </div>
    </section>

    <!-- Gallery Info Section -->
    <section class="gallery-info">
      <div class="container">
        <div class="info-grid">
          <div class="info-card">
            <span class="info-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </span>
            <h3>Professional Photography</h3>
            <p>All images optimized for fast loading with AVIF/WebP formats</p>
          </div>
          <div class="info-card">
            <span class="info-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                <line x1="12" y1="18" x2="12.01" y2="18"></line>
              </svg>
            </span>
            <h3>Responsive Design</h3>
            <p>Perfect viewing experience on any device or screen size</p>
          </div>
          <div class="info-card">
            <span class="info-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </span>
            <h3>Lightning Fast</h3>
            <p>Lazy loading ensures only visible images are downloaded</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <h2>Ready to Experience It In Person?</h2>
        <p>Book a table and see our beautiful restaurant for yourself.</p>
        <a href="/reservations" class="cta-button">Make a Reservation</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .gallery-page {
    min-height: 100vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero Section */
  .gallery-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary, #722f37) 0%,
      var(--color-primary-dark, #4d1f25) 100%
    );
    color: var(--color-text-inverse, #fffbeb);
    padding: 5rem 0 4rem;
    text-align: center;
  }

  .gallery-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 1rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Mobile Gallery Section */
  .mobile-gallery-section {
    display: none;
    padding: 3rem 0;
    background: var(--color-background, #fffbeb);
  }

  .section-heading {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.5rem;
    color: var(--color-text-primary, #2d3748);
  }

  .section-subheading {
    font-size: 1rem;
    text-align: center;
    color: var(--color-text-secondary, #4a5568);
    margin-bottom: 1.5rem;
  }

  /* Show mobile gallery on smaller screens */
  @media (max-width: 768px) {
    .mobile-gallery-section {
      display: block;
    }

    .desktop-gallery {
      display: none;
    }
  }

  /* Gallery Section */
  .gallery-section {
    padding: 4rem 0;
    background: var(--color-background, #fffbeb);
  }

  /* Info Section */
  .gallery-info {
    padding: 4rem 0;
    background: var(--color-background-subtle, #fef7e0);
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .info-card {
    background: var(--color-background-elevated, #ffffff);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .info-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
  }

  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: var(--color-primary-50, #fdf2f3);
    border-radius: 50%;
    color: var(--color-primary, #722f37);
    margin-bottom: 1rem;
  }

  .info-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-primary, #2d3748);
  }

  .info-card p {
    color: var(--color-text-secondary, #4a5568);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  /* CTA Section */
  .cta-section {
    padding: 5rem 0;
    text-align: center;
    background: linear-gradient(
      135deg,
      var(--color-primary, #722f37) 0%,
      var(--color-primary-dark, #4d1f25) 100%
    );
    color: var(--color-text-inverse, #fffbeb);
  }

  .cta-section h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .cta-section p {
    font-size: 1.125rem;
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary, #722f37);
    background: var(--color-background-elevated, #ffffff);
    border-radius: 9999px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  }

  .cta-button:focus-visible {
    outline: 3px solid white;
    outline-offset: 2px;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .gallery-hero {
      padding: 4rem 0 3rem;
    }

    .gallery-section,
    .gallery-info {
      padding: 3rem 0;
    }

    .cta-section {
      padding: 4rem 0;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .info-card,
    .cta-button {
      transition: none;
    }

    .info-card:hover,
    .cta-button:hover {
      transform: none;
    }
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .mobile-gallery-section {
      background: var(--color-background-inverse, #2d3748);
    }

    .section-heading {
      color: var(--color-text-inverse, #fffbeb);
    }

    .section-subheading {
      color: rgba(255, 255, 255, 0.8);
    }

    .gallery-section {
      background: var(--color-background-inverse, #2d3748);
    }

    .gallery-info {
      background: rgba(0, 0, 0, 0.2);
    }

    .info-card {
      background: rgba(255, 255, 255, 0.05);
      color: var(--color-text-inverse, #fffbeb);
    }

    .info-card h3 {
      color: var(--color-text-inverse, #fffbeb);
    }

    .info-card p {
      color: rgba(255, 255, 255, 0.8);
    }

    .info-icon {
      background: rgba(255, 255, 255, 0.1);
      color: var(--color-primary-light, #f4a9b1);
    }
  }

  /* Support for explicit dark theme */
  html[data-theme="dark"] .mobile-gallery-section {
    background: var(--color-background-inverse, #2d3748);
  }

  html[data-theme="dark"] .section-heading {
    color: var(--color-text-inverse, #fffbeb);
  }

  html[data-theme="dark"] .section-subheading {
    color: rgba(255, 255, 255, 0.8);
  }
</style>

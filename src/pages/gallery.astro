---
/**
 * Photo Gallery Page
 *
 * Showcases the restaurant through stunning photography featuring
 * interior, exterior, and food imagery. Implements responsive
 * masonry/grid layouts with lazy loading for optimal performance.
 *
 * Features two layout modes:
 * - Desktop: Masonry grid layout with category filtering
 * - Mobile: Horizontal scrolling gallery with snap points for efficient browsing
 */
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import { GALLERY_IMAGES, GALLERY_SEO, getImagesByCategory, GALLERY_CATEGORIES } from '../config/gallery.config';

// Get featured images for mobile horizontal gallery (one from each category)
const featuredImages = GALLERY_CATEGORIES.map(category => {
  const images = getImagesByCategory(category);
  return images[0];
}).filter(Boolean);
---

<Layout title={GALLERY_SEO.title} description={GALLERY_SEO.description}>
  <main class="gallery-page">
    <!-- Hero Section -->
    <section class="gallery-hero">
      <div class="container">
        <h1>Our Gallery</h1>
        <p class="hero-subtitle">
          Take a visual journey through our restaurant - from our elegant dining spaces
          to our beautifully crafted dishes.
        </p>
      </div>
    </section>

    <!-- Mobile Horizontal Gallery (shown on smaller screens) -->
    <section class="mobile-gallery-section">
      <div class="container">
        <h2 class="section-heading">Featured Photos</h2>
        <p class="section-subheading">Swipe to explore our restaurant highlights</p>
        <HorizontalGallery
          images={GALLERY_IMAGES}
          showIndicators={true}
          showArrows={true}
          lightbox={true}
          height="280px"
          aspectRatio="4/3"
          gap={0.75}
          showCaptions={true}
          testId="mobile-gallery"
        />
      </div>
    </section>

    <!-- Desktop Photo Gallery Section (hidden on mobile) -->
    <section class="gallery-section desktop-gallery">
      <div class="container">
        <PhotoGallery
          images={GALLERY_IMAGES}
          layout="masonry"
          columns={3}
          gap={1.5}
          showCategories={true}
          lightbox={true}
          testId="restaurant-gallery"
        />
      </div>
    </section>

    <!-- Gallery Info Section -->
    <section class="gallery-info">
      <div class="container">
        <div class="info-grid">
          <div class="info-card">
            <span class="info-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                <path d="M19 3v4"></path>
                <path d="M21 5h-4"></path>
              </svg>
            </span>
            <h3>Elegant Ambiance</h3>
            <p>Warm lighting and thoughtful decor create the perfect dining atmosphere</p>
          </div>
          <div class="info-card">
            <span class="info-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"></path>
                <line x1="6" y1="17" x2="18" y2="17"></line>
              </svg>
            </span>
            <h3>Culinary Artistry</h3>
            <p>Every dish is crafted with care and presented beautifully</p>
          </div>
          <div class="info-card">
            <span class="info-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
            <h3>Private Events</h3>
            <p>Host your special occasions in our intimate dining spaces</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <h2>Ready to Experience It In Person?</h2>
        <p>Book a table and see our beautiful restaurant for yourself.</p>
        <a href="/restaurant-business/contact" class="cta-button">Make a Reservation</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .gallery-page {
    min-height: 100vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero Section */
  .gallery-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    color: var(--color-text-primary);
    padding: 5rem 0 4rem;
    text-align: center;
  }

  .gallery-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 1rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text-primary);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Mobile Gallery Section */
  .mobile-gallery-section {
    display: none;
    padding: 3rem 0;
    background: var(--color-background);
  }

  .section-heading {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
  }

  .section-subheading {
    font-size: 1rem;
    text-align: center;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  /* Show mobile gallery on smaller screens */
  @media (max-width: 768px) {
    .mobile-gallery-section {
      display: block;
    }

    .desktop-gallery {
      display: none;
    }
  }

  /* Gallery Section */
  .gallery-section {
    padding: 4rem 0;
    background: var(--color-background);
  }

  /* Info Section */
  .gallery-info {
    padding: 4rem 0;
    background: var(--color-background-subtle);
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .info-card {
    background: var(--color-background-elevated);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    box-shadow: var(--shadow-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .info-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: var(--color-primary-50);
    border-radius: 50%;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .info-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
  }

  .info-card p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  /* CTA Section */
  .cta-section {
    padding: 5rem 0;
    text-align: center;
    background: var(--gradient-primary);
    color: var(--color-text-inverse);
  }

  .cta-section h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 0.75rem;
    font-weight: 700;
    color: #ffffff;
  }

  .cta-section p {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2rem;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary-700);
    background: #ffffff;
    border-radius: 9999px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  }

  .cta-button:focus-visible {
    outline: 3px solid white;
    outline-offset: 2px;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .gallery-hero {
      padding: 4rem 0 3rem;
    }

    .gallery-section,
    .gallery-info {
      padding: 3rem 0;
    }

    .cta-section {
      padding: 4rem 0;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .info-card,
    .cta-button {
      transition: none;
    }

    .info-card:hover,
    .cta-button:hover {
      transform: none;
    }
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .gallery-hero {
      background: linear-gradient(
        135deg,
        var(--color-primary-900) 0%,
        var(--color-background) 100%
      );
      color: var(--color-text-primary);
    }

    .gallery-hero h1 {
      color: var(--color-text-primary);
    }

    .hero-subtitle {
      color: var(--color-text-secondary);
    }

    .mobile-gallery-section,
    .gallery-section {
      background: var(--color-background);
    }

    .section-heading {
      color: var(--color-text-primary);
    }

    .section-subheading {
      color: var(--color-text-secondary);
    }

    .gallery-info {
      background: var(--color-background-subtle);
    }

    .info-card {
      background: var(--color-background-elevated);
    }

    .info-card h3 {
      color: var(--color-text-primary);
    }

    .info-card p {
      color: var(--color-text-secondary);
    }

    .info-icon {
      background: rgba(255, 255, 255, 0.1);
      color: var(--color-primary-light);
    }
  }

  /* Support for explicit dark theme */
  html[data-theme="dark"] .gallery-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-900) 0%,
      var(--color-background) 100%
    );
    color: var(--color-text-primary);
  }

  html[data-theme="dark"] .gallery-hero h1 {
    color: var(--color-text-primary);
  }

  html[data-theme="dark"] .hero-subtitle {
    color: var(--color-text-secondary);
  }

  html[data-theme="dark"] .mobile-gallery-section,
  html[data-theme="dark"] .gallery-section {
    background: var(--color-background);
  }

  html[data-theme="dark"] .section-heading {
    color: var(--color-text-primary);
  }

  html[data-theme="dark"] .section-subheading {
    color: var(--color-text-secondary);
  }

  html[data-theme="dark"] .gallery-info {
    background: var(--color-background-subtle);
  }

  html[data-theme="dark"] .info-card {
    background: var(--color-background-elevated);
  }

  html[data-theme="dark"] .info-card h3 {
    color: var(--color-text-primary);
  }

  html[data-theme="dark"] .info-card p {
    color: var(--color-text-secondary);
  }

  html[data-theme="dark"] .info-icon {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-primary-light);
  }
</style>

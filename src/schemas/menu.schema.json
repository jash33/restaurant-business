{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://restaurant-business.com/schemas/menu.schema.json",
  "title": "Restaurant Menu Schema",
  "description": "JSON schema for validating restaurant menu data including categories, items, prices, descriptions, dietary tags, and photo references",
  "definitions": {
    "MenuType": {
      "type": "string",
      "enum": ["lunch", "dinner", "brunch", "dessert", "drinks", "kids"],
      "description": "Types of menus available"
    },
    "MenuCategory": {
      "type": "string",
      "enum": [
        "appetizers",
        "soups-salads",
        "main-courses",
        "seafood",
        "steaks-grills",
        "pasta",
        "sandwiches",
        "sides",
        "desserts",
        "beverages",
        "cocktails",
        "wine",
        "beer",
        "kids"
      ],
      "description": "Menu item categories"
    },
    "DietaryTag": {
      "type": "string",
      "enum": [
        "vegetarian",
        "vegan",
        "gluten-free",
        "dairy-free",
        "nut-free",
        "egg-free",
        "soy-free",
        "halal",
        "kosher",
        "organic",
        "locally-sourced",
        "spicy",
        "mild"
      ],
      "description": "Dietary tags for menu items"
    },
    "AllergenTag": {
      "type": "string",
      "enum": [
        "milk",
        "eggs",
        "fish",
        "shellfish",
        "tree-nuts",
        "peanuts",
        "wheat",
        "soy",
        "sesame",
        "mustard",
        "celery",
        "lupin",
        "molluscs",
        "sulphites"
      ],
      "description": "Allergen tags for menu items"
    },
    "SpiceLevel": {
      "type": "string",
      "enum": ["none", "mild", "medium", "hot", "extra-hot"],
      "description": "Spice level for dishes"
    },
    "PreparationStyle": {
      "type": "string",
      "enum": [
        "grilled",
        "fried",
        "baked",
        "steamed",
        "raw",
        "smoked",
        "roasted",
        "sauteed",
        "braised"
      ],
      "description": "Preparation styles"
    },
    "MenuItemImage": {
      "type": "object",
      "description": "Image configuration for menu items",
      "properties": {
        "src": {
          "type": "string",
          "description": "Main image source path",
          "minLength": 1
        },
        "srcWebP": {
          "type": "string",
          "description": "WebP format source for modern browsers"
        },
        "alt": {
          "type": "string",
          "description": "Alt text for accessibility",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "description": "Image width in pixels",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "description": "Image height in pixels",
          "minimum": 1
        },
        "placeholder": {
          "type": "string",
          "description": "Placeholder/blur-up image (base64 or low-res URL)"
        }
      },
      "required": ["src", "alt"],
      "additionalProperties": false
    },
    "MenuItemPrice": {
      "type": "object",
      "description": "Price information for a menu item",
      "properties": {
        "amount": {
          "type": "integer",
          "description": "Base price in the smallest currency unit (cents) for precision",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "description": "Currency code (ISO 4217)",
          "pattern": "^[A-Z]{3}$",
          "default": "USD"
        },
        "display": {
          "type": "string",
          "description": "Formatted display string (e.g., \"$18.99\")",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "description": "Price per unit description (e.g., \"per person\", \"per dozen\")"
        }
      },
      "required": ["amount", "currency", "display"],
      "additionalProperties": false
    },
    "MenuItemPriceVariant": {
      "type": "object",
      "description": "Price variant for items with multiple sizes/options",
      "properties": {
        "name": {
          "type": "string",
          "description": "Variant name (e.g., \"Small\", \"Large\", \"Half Portion\")",
          "minLength": 1
        },
        "price": {
          "$ref": "#/definitions/MenuItemPrice"
        },
        "description": {
          "type": "string",
          "description": "Description of what this variant includes"
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this is the default selection"
        }
      },
      "required": ["name", "price"],
      "additionalProperties": false
    },
    "MenuItemAddOn": {
      "type": "object",
      "description": "Add-on or modifier for a menu item",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the add-on",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "Add-on name",
          "minLength": 1
        },
        "price": {
          "$ref": "#/definitions/MenuItemPrice"
        },
        "description": {
          "type": "string",
          "description": "Description of the add-on"
        },
        "available": {
          "type": "boolean",
          "description": "Whether this add-on is available",
          "default": true
        }
      },
      "required": ["id", "name", "price"],
      "additionalProperties": false
    },
    "NutritionalInfo": {
      "type": "object",
      "description": "Nutritional information for a menu item",
      "properties": {
        "calories": {
          "type": "integer",
          "description": "Calories per serving",
          "minimum": 0
        },
        "protein": {
          "type": "number",
          "description": "Protein in grams",
          "minimum": 0
        },
        "carbohydrates": {
          "type": "number",
          "description": "Carbohydrates in grams",
          "minimum": 0
        },
        "fat": {
          "type": "number",
          "description": "Fat in grams",
          "minimum": 0
        },
        "saturatedFat": {
          "type": "number",
          "description": "Saturated fat in grams",
          "minimum": 0
        },
        "fiber": {
          "type": "number",
          "description": "Fiber in grams",
          "minimum": 0
        },
        "sugar": {
          "type": "number",
          "description": "Sugar in grams",
          "minimum": 0
        },
        "sodium": {
          "type": "number",
          "description": "Sodium in milligrams",
          "minimum": 0
        },
        "servingSize": {
          "type": "string",
          "description": "Serving size description"
        }
      },
      "additionalProperties": false
    },
    "MenuItem": {
      "type": "object",
      "description": "Represents a single menu item",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the item",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "description": "Item name",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Full description of the item",
          "minLength": 1,
          "maxLength": 500
        },
        "shortDescription": {
          "type": "string",
          "description": "Short description for compact displays",
          "maxLength": 150
        },
        "price": {
          "$ref": "#/definitions/MenuItemPrice"
        },
        "priceVariants": {
          "type": "array",
          "description": "Price variants for different sizes/portions",
          "items": {
            "$ref": "#/definitions/MenuItemPriceVariant"
          }
        },
        "addOns": {
          "type": "array",
          "description": "Available add-ons/modifiers",
          "items": {
            "$ref": "#/definitions/MenuItemAddOn"
          }
        },
        "category": {
          "$ref": "#/definitions/MenuCategory"
        },
        "menuTypes": {
          "type": "array",
          "description": "Menu types this item appears on",
          "items": {
            "$ref": "#/definitions/MenuType"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dietaryTags": {
          "type": "array",
          "description": "Dietary tags",
          "items": {
            "$ref": "#/definitions/DietaryTag"
          },
          "uniqueItems": true
        },
        "allergens": {
          "type": "array",
          "description": "Allergen information",
          "items": {
            "$ref": "#/definitions/AllergenTag"
          },
          "uniqueItems": true
        },
        "spiceLevel": {
          "$ref": "#/definitions/SpiceLevel"
        },
        "preparationStyle": {
          "$ref": "#/definitions/PreparationStyle"
        },
        "image": {
          "$ref": "#/definitions/MenuItemImage"
        },
        "gallery": {
          "type": "array",
          "description": "Additional gallery images",
          "items": {
            "$ref": "#/definitions/MenuItemImage"
          }
        },
        "featured": {
          "type": "boolean",
          "description": "Whether this is a featured/signature item",
          "default": false
        },
        "chefRecommended": {
          "type": "boolean",
          "description": "Whether this is a chef's recommendation",
          "default": false
        },
        "isNew": {
          "type": "boolean",
          "description": "Whether this is a new item",
          "default": false
        },
        "seasonal": {
          "type": "boolean",
          "description": "Whether this is a seasonal item",
          "default": false
        },
        "seasonAvailable": {
          "type": "string",
          "description": "Season availability (if seasonal)"
        },
        "available": {
          "type": "boolean",
          "description": "Whether the item is currently available",
          "default": true
        },
        "sortOrder": {
          "type": "integer",
          "description": "Sort order within category",
          "minimum": 0
        },
        "relatedItems": {
          "type": "array",
          "description": "Related item IDs for suggestions",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "nutritionalInfo": {
          "$ref": "#/definitions/NutritionalInfo"
        },
        "prepTime": {
          "type": "integer",
          "description": "Preparation time in minutes",
          "minimum": 0
        },
        "internalNotes": {
          "type": "string",
          "description": "Internal notes (not displayed to customers)"
        },
        "createdAt": {
          "type": "string",
          "description": "Date item was added",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Date item was last updated",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "description", "price", "category", "menuTypes"],
      "additionalProperties": false
    },
    "MenuSection": {
      "type": "object",
      "description": "Represents a menu category section",
      "properties": {
        "category": {
          "$ref": "#/definitions/MenuCategory"
        },
        "title": {
          "type": "string",
          "description": "Display title for the section",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Section description"
        },
        "image": {
          "$ref": "#/definitions/MenuItemImage"
        },
        "items": {
          "type": "array",
          "description": "Items in this section",
          "items": {
            "$ref": "#/definitions/MenuItem"
          }
        },
        "sortOrder": {
          "type": "integer",
          "description": "Sort order for display",
          "minimum": 0
        },
        "visible": {
          "type": "boolean",
          "description": "Whether section is visible",
          "default": true
        }
      },
      "required": ["category", "title", "items"],
      "additionalProperties": false
    },
    "Menu": {
      "type": "object",
      "description": "Represents a complete menu",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the menu",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "type": {
          "$ref": "#/definitions/MenuType"
        },
        "name": {
          "type": "string",
          "description": "Menu display name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Menu description"
        },
        "sections": {
          "type": "array",
          "description": "Sections/categories in this menu",
          "items": {
            "$ref": "#/definitions/MenuSection"
          }
        },
        "availableHours": {
          "type": "string",
          "description": "Availability hours (e.g., \"11:00 AM - 3:00 PM\")"
        },
        "availableDays": {
          "type": "array",
          "description": "Days available",
          "items": {
            "type": "string",
            "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
          },
          "uniqueItems": true
        },
        "active": {
          "type": "boolean",
          "description": "Whether this menu is currently active",
          "default": true
        },
        "effectiveDate": {
          "type": "string",
          "description": "Effective date for this menu version",
          "format": "date"
        },
        "expirationDate": {
          "type": "string",
          "description": "Expiration date (for seasonal menus)",
          "format": "date"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp",
          "format": "date-time"
        }
      },
      "required": ["id", "type", "name", "sections"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "menus": {
      "type": "array",
      "description": "Array of all menus",
      "items": {
        "$ref": "#/definitions/Menu"
      }
    },
    "items": {
      "type": "array",
      "description": "Flat array of all menu items (alternative structure)",
      "items": {
        "$ref": "#/definitions/MenuItem"
      }
    },
    "version": {
      "type": "string",
      "description": "Schema version for this menu data",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastUpdated": {
      "type": "string",
      "description": "Last update timestamp",
      "format": "date-time"
    }
  },
  "oneOf": [
    {
      "required": ["menus"]
    },
    {
      "required": ["items"]
    }
  ],
  "additionalProperties": false
}

# =================================================================
# HOUSTON WEB SERVICES - ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to .env and update with your actual values.
# Never commit the actual .env file to version control.
# =================================================================

# =================================================================
# GOOGLE ANALYTICS 4
# =================================================================
# Your GA4 Measurement ID (format: G-XXXXXXXXXX)
# Get this from Google Analytics: Admin > Data Streams > Web Stream
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# =================================================================
# SITE CONFIGURATION
# =================================================================
# Production site URL (used for canonical URLs and social sharing)
PUBLIC_SITE_URL=https://houston-web-services.com

# =================================================================
# CONTACT INFORMATION (Optional - for structured data)
# =================================================================
# PUBLIC_CONTACT_EMAIL=hello@houston-web-services.com
# PUBLIC_CONTACT_PHONE=+1-713-555-0123

# =================================================================
# SOCIAL MEDIA (Optional)
# =================================================================
# PUBLIC_TWITTER_HANDLE=@houstonweb
# PUBLIC_FACEBOOK_URL=https://facebook.com/houstonwebservices
# PUBLIC_LINKEDIN_URL=https://linkedin.com/company/houston-web-services

# =================================================================
# INSTAGRAM FEED INTEGRATION
# =================================================================
# Enable/disable Instagram feed feature (default: true)
# PUBLIC_INSTAGRAM_ENABLED=true

# Instagram handle (without @) - displayed in "Follow us" link
# PUBLIC_INSTAGRAM_HANDLE=yourrestaurant

# Full Instagram profile URL
# PUBLIC_INSTAGRAM_PROFILE_URL=https://www.instagram.com/yourrestaurant/

# -----------------------------------------------------------------
# Option 1: Behold Service (Recommended - easiest setup)
# -----------------------------------------------------------------
# Get your feed ID from https://behold.so after connecting your Instagram
# PUBLIC_INSTAGRAM_USE_BEHOLD=true
# PUBLIC_INSTAGRAM_BEHOLD_FEED_ID=your-behold-feed-id

# -----------------------------------------------------------------
# Option 2: Instagram Basic Display API (Advanced)
# -----------------------------------------------------------------
# Requires setting up a Facebook App and getting long-lived access token
# See: https://developers.facebook.com/docs/instagram-basic-display-api
# PUBLIC_INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
# PUBLIC_INSTAGRAM_ACCOUNT_ID=your-instagram-account-id

# =================================================================
# RESERVATION PLATFORMS
# =================================================================
# Configure your restaurant's reservation platform integration.
# Each platform can be enabled/disabled independently.

# -----------------------------------------------------------------
# Phone Reservations
# -----------------------------------------------------------------
# Phone number displayed for phone reservations
# PUBLIC_RESERVATIONS_PHONE=(713) 555-0123

# -----------------------------------------------------------------
# OpenTable Integration
# -----------------------------------------------------------------
# Your restaurant's OpenTable reservation page URL
# PUBLIC_OPENTABLE_URL=https://www.opentable.com/r/your-restaurant

# OpenTable Restaurant ID (for API availability checks)
# PUBLIC_OPENTABLE_RESTAURANT_ID=your-opentable-restaurant-id

# Enable real-time availability checking (requires API access)
# PUBLIC_OPENTABLE_API_ENABLED=false

# -----------------------------------------------------------------
# Resy Integration
# -----------------------------------------------------------------
# Your restaurant's Resy reservation page URL
# PUBLIC_RESY_URL=https://resy.com/cities/hou/your-restaurant

# Resy Venue ID (for API availability checks)
# PUBLIC_RESY_VENUE_ID=your-resy-venue-id

# Enable real-time availability checking (requires API access)
# PUBLIC_RESY_API_ENABLED=false

# -----------------------------------------------------------------
# Yelp Reservations Integration
# -----------------------------------------------------------------
# Your restaurant's Yelp Reservations page URL
# PUBLIC_YELP_RESERVATIONS_URL=https://www.yelp.com/reservations/your-restaurant

# Yelp Business ID (for API availability checks)
# PUBLIC_YELP_BUSINESS_ID=your-yelp-business-id

# Enable real-time availability checking (requires API access)
# PUBLIC_YELP_API_ENABLED=false

# =================================================================
# YELP REVIEWS INTEGRATION
# =================================================================
# Configuration for Yelp reviews display and badge components.
# Follows Yelp Brand Guidelines: https://www.yelp.com/brand
#
# Note: Review data is manually curated in src/config/yelp.config.ts
# Update the config file with your restaurant's actual Yelp data.

# -----------------------------------------------------------------
# Yelp Business Profile
# -----------------------------------------------------------------
# Your Yelp business page URL
# PUBLIC_YELP_PROFILE_URL=https://www.yelp.com/biz/your-restaurant-city

# URL for customers to write reviews
# PUBLIC_YELP_REVIEW_URL=https://www.yelp.com/writeareview/biz/your-restaurant-city

# Enable Yelp reviews section display (default: true)
# PUBLIC_YELP_REVIEWS_ENABLED=true

# -----------------------------------------------------------------
# Availability Status Display
# -----------------------------------------------------------------
# Show availability status badges on reservation cards
# Requires at least one platform API to be enabled
# PUBLIC_SHOW_AVAILABILITY_STATUS=false
